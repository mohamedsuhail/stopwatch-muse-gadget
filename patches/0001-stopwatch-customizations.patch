diff --git a/esp32/components/muse/muse_echo.c b/esp32/components/muse/muse_echo.c
new file mode 100644
index 0000000..2ff6f61
--- /dev/null
+++ b/esp32/components/muse/muse_echo.c
@@ -0,0 +1,95 @@
+#include "muse_echo.h"
+
+#define SILENT_DB -100.0f
+#define COUPLING_UP 0.2f           /* the share of the way to a louder chunk's echo... */
+#define COUPLING_UP_MAX_DB 2.0f    /* ...but at most this a chunk, so a voice building up barely moves it */
+#define COUPLING_DOWN 0.05f        /* and to a quieter one: it stays near the louder echoes */
+#define AUDIBLE_DB 6.0f            /* the mic this far over the room hears the speaker; under it, nothing is learnt */
+#define ROOM_RISE_DB 0.1f
+
+void muse_echo_init(muse_echo_t *e)
+{
+    *e = (muse_echo_t){
+        .coupling_db = MUSE_ECHO_START_COUPLING_DB,
+        .room_db = -60.0f,
+    };
+    muse_echo_reset(e);
+}
+
+void muse_echo_reset(muse_echo_t *e)
+{
+    for (size_t i = 0; i < MUSE_ECHO_LAG_CHUNKS; i++) {
+        e->spk_db[i] = SILENT_DB;
+    }
+    e->onset = 0;
+    e->heard = 0;
+}
+
+/* The loudest the speaker was over the lag: whichever of those chunks the mic is hearing now. */
+static float recent_spk_db(const muse_echo_t *e)
+{
+    float db = SILENT_DB;
+    for (size_t i = 0; i < MUSE_ECHO_LAG_CHUNKS; i++) {
+        db = e->spk_db[i] > db ? e->spk_db[i] : db;
+    }
+    return db;
+}
+
+float muse_echo_expected_db(const muse_echo_t *e)
+{
+    float spk = recent_spk_db(e);
+    float echo = spk > MUSE_ECHO_PLAYING_DB ? spk + e->coupling_db : SILENT_DB;
+    return echo > e->room_db ? echo : e->room_db;
+}
+
+/* The echo's level is learnt from chunks that aren't a voice, where the mic
+ * hears the speaker over the room. It follows the louder of them (the speaker's
+ * level is the loudest of the lag, so most chunks are quieter than that), and
+ * rises by little a chunk, so the start of a voice over it hardly raises it. */
+static void learn(muse_echo_t *e, float spk, float mic_db)
+{
+    if (spk <= MUSE_ECHO_PLAYING_DB) {
+        if (mic_db < e->room_db) {
+            e->room_db = mic_db;
+        } else if (mic_db < e->room_db + MUSE_ECHO_MARGIN_DB) {
+            e->room_db += ROOM_RISE_DB;
+        }
+        return;
+    }
+    if (mic_db < e->room_db + AUDIBLE_DB) {
+        return;   /* a gap between words, or the speaker too quiet to hear */
+    }
+    float gap = mic_db - spk - e->coupling_db;
+    if (gap > 0) {
+        e->coupling_db += gap * COUPLING_UP < COUPLING_UP_MAX_DB ? gap * COUPLING_UP : COUPLING_UP_MAX_DB;
+    } else {
+        e->coupling_db += gap * COUPLING_DOWN;
+    }
+    e->learnt++;
+}
+
+bool muse_echo_feed(muse_echo_t *e, float spk_db, float mic_db, bool mic_clipped)
+{
+    e->spk_db[e->next] = spk_db;
+    e->next = (e->next + 1) % MUSE_ECHO_LAG_CHUNKS;
+    float spk = recent_spk_db(e);
+    float expected = muse_echo_expected_db(e);
+    bool voice = mic_db >= expected + MUSE_ECHO_MARGIN_DB && mic_db >= MUSE_ECHO_MIN_VOICE_DB &&
+                 !(mic_clipped && spk > MUSE_ECHO_PLAYING_DB);
+    if (spk > MUSE_ECHO_PLAYING_DB && mic_db >= e->room_db + AUDIBLE_DB) {
+        e->heard++;
+    }
+    /* A reply's start is all echo as far as it knows: however loud, it's learnt
+     * from, so a speaker much louder in the mic than guessed is learnt rather
+     * than taken for a voice. */
+    if (!voice || e->heard <= MUSE_ECHO_WARMUP_CHUNKS) {
+        learn(e, spk, mic_db);
+        e->onset = 0;
+        return false;
+    }
+    if (++e->onset < MUSE_ECHO_ONSET_CHUNKS) {
+        return false;
+    }
+    e->onset = 0;
+    return true;
+}
diff --git a/esp32/components/muse/muse_echo.h b/esp32/components/muse/muse_echo.h
new file mode 100644
index 0000000..7b13377
--- /dev/null
+++ b/esp32/components/muse/muse_echo.h
@@ -0,0 +1,45 @@
+/*
+ * Telling your voice from the speaker's own sound in the mic, so you can talk
+ * over a reply (a barge-in). The board has no echo canceller: while the
+ * speaker plays, the mic hears it too. Fed one pair of levels per 20 ms chunk
+ * (muse_audio_dbfs of what went to the speaker, and of what the mic heard),
+ * it learns how loud the speaker comes back in the mic, and says when the mic
+ * is enough louder than that for long enough to be someone talking.
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#define MUSE_ECHO_LAG_CHUNKS 10        /* written to the speaker, heard by the mic up to 200 ms later: two I2S DMA queues */
+#define MUSE_ECHO_MARGIN_DB 10.0f      /* this far over the expected echo is a voice... */
+#define MUSE_ECHO_MIN_VOICE_DB -40.0f  /* ...and at least this loud */
+#define MUSE_ECHO_ONSET_CHUNKS 10      /* 200 ms of it in a row may be a barge-in (xAI decides) */
+#define MUSE_ECHO_WARMUP_CHUNKS 25     /* each reply's first 500 ms of audible echo: learnt, never a barge-in */
+#define MUSE_ECHO_START_COUPLING_DB 6.0f   /* before it has learnt: the mic hears the speaker loud */
+#define MUSE_ECHO_PLAYING_DB -50.0f    /* the speaker counts as playing at this level */
+
+typedef struct {
+    float spk_db[MUSE_ECHO_LAG_CHUNKS];   /* recent speaker levels, a ring */
+    size_t next;
+    float coupling_db;    /* mic level minus speaker level, for the speaker's own sound */
+    float room_db;        /* the mic when the speaker is quiet */
+    int onset;            /* chunks loud enough in a row */
+    size_t learnt;        /* chunks of playback it has learnt from */
+    size_t heard;         /* audible chunks since the speaker started (muse_echo_reset) */
+} muse_echo_t;
+
+void muse_echo_init(muse_echo_t *e);
+
+/* Forgets the recent speaker levels (playback stopped), keeping what it learnt. */
+void muse_echo_reset(muse_echo_t *e);
+
+/* How loud the mic should hear the speaker's own sound now, in dBFS. */
+float muse_echo_expected_db(const muse_echo_t *e);
+
+/* One chunk: the level written to the speaker, the level the mic heard, and whether the mic
+ * clipped (samples at full scale). While the speaker plays, a clipped chunk is the speaker
+ * overloading the mic, never a voice: it's learnt as echo (a loud voice that doesn't clip is
+ * still a voice). True when someone has been talking over the speaker for
+ * MUSE_ECHO_ONSET_CHUNKS in a row (it then starts counting afresh). */
+bool muse_echo_feed(muse_echo_t *e, float spk_db, float mic_db, bool mic_clipped);
