+                ESP_LOGI(TAG, "maybe a barge-in: mic %.0f dBFS, the speaker's echo %.0f", mic_db,
+                         muse_echo_expected_db(&echo));
+                trial = esp_timer_get_time() + LIVE_CONFIRM_US;
+                /* What you said from just before, not the echo before that. */
+                size_t from = s_pre_fill > MUSE_ECHO_ONSET_CHUNKS + 2 ? s_pre_fill - MUSE_ECHO_ONSET_CHUNKS - 2 : 0;
