-/* The codec driver switches the amp through this as the speaker opens and closes. */
+/* The codec driver switches the amp through this as the speaker opens and closes. The
+ * AW8737A counts rising edges on SHDN for its mode, but every mode has the same gain (set by
+ * R57/R58, 200 kΩ: ×1.48); one edge, a plain high, is mode 1, the highest output limit
+ * (1.2 W into 8 Ω). M5's firmware drives it the same way. */
 static int ioe_gpio_setup(int16_t gpio, audio_gpio_dir_t dir, audio_gpio_mode_t mode)
 {
     (void)gpio;
@@ -615,6 +618,8 @@ static lv_display_t *display_start(lv_indev_t **touch)
     esp_lv_adapter_config_t adapter_cfg = ESP_LV_ADAPTER_DEFAULT_CONFIG();
     adapter_cfg.task_core_id = MUSE_UI_CORE;
     adapter_cfg.task_priority = MUSE_UI_PRIORITY;
+    /* Safe in PSRAM: with code and rodata there too, flash writes never turn the cache off. */
+    adapter_cfg.stack_in_psram = true;
     if (esp_lv_adapter_init(&adapter_cfg) != ESP_OK) {
         return NULL;
     }
@@ -917,7 +922,11 @@ static esp_err_t audio_init(esp_codec_dev_handle_t *spk, esp_codec_dev_handle_t
