@@ -0,0 +1,40 @@
+/*
+ * When a hands-free turn ends: speech, then a quiet moment. Fed one level per
+ * 20 ms chunk (muse_audio_dbfs), it learns the room's floor and says when
+ * someone has spoken and then stopped, or that nobody has spoken at all.
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#define MUSE_VAD_CHUNK_MS 20
+#define MUSE_VAD_SPEECH_DB 12.0f    /* this far over the floor is speech... */
+#define MUSE_VAD_SILENCE_DB 6.0f    /* ...and under this far is quiet */
+#define MUSE_VAD_MIN_SPEECH_DB -48.0f   /* however quiet the room, speech is at least this loud */
+#define MUSE_VAD_ONSET_CHUNKS 3     /* 60 ms of speech in a row counts as speaking */
+#define MUSE_VAD_END_MS 900         /* quiet this long after speaking ends the turn */
+
+typedef enum {
+    MUSE_VAD_WAITING,   /* nothing said yet */
+    MUSE_VAD_SPEAKING,  /* speech heard; not quiet long enough yet */
+    MUSE_VAD_DONE,      /* spoke, then quiet for MUSE_VAD_END_MS */
+    MUSE_VAD_NOTHING,   /* nobody spoke within the quiet limit */
+} muse_vad_state_t;
+
+typedef struct {
+    float floor_db;          /* the room, learnt from the quietest chunks */
+    int onset, quiet;        /* chunks of speech, and of quiet after it, in a row */
+    size_t chunks;           /* fed so far */
+    size_t quiet_limit;      /* chunks to wait for speech before giving up */
+    muse_vad_state_t state;
+} muse_vad_t;
+
+/* quiet_ms: how long to wait for someone to start speaking. */
+void muse_vad_init(muse_vad_t *v, unsigned quiet_ms);
+
+/* Tells it about the room before listening (the pre-roll's chunks). */
+void muse_vad_hear_room(muse_vad_t *v, float db);
+
+/* One chunk's level; returns the state after it. */
+muse_vad_state_t muse_vad_feed(muse_vad_t *v, float db);
