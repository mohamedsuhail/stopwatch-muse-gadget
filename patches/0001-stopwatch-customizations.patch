+    muse_gemini_tts_state_t st = muse_gemini_tts_state();
+    for (;;) {
+        size_t room = xStreamBufferSpacesAvailable(s_out);
+        if (room < 2) {
+            break;
+        }
+        size_t want = (room < cap ? room : cap) - (have_odd ? 1 : 0);
