+#include "freertos/idf_additions.h"
+#include "freertos/queue.h"
+#include "freertos/task.h"
+#include "lwip/sockets.h"
+#include "mbedtls/base64.h"
+#include "muse_wifi.h"
+#include "nvs.h"
+
+static const char *TAG = "muse_gemini_tts";
+
+#define HOST "generativelanguage.googleapis.com"
+#define PATH "/v1beta/interactions?alt=sse"
+#define MODEL "gemini-3.8-flash-lite-tts"
+#define VOICE "Achernar"
+#define NVS_NS "muse_tts"
+#define NVS_KEY "gemini_key"
+#define COMMAND "gemini_key="
+#define KEY_MAX 128
+#define SSE_LINE_MAX (256 * 1024)        /* one SSE event; its base64 audio grows it */
+#define RX_BUF 4096
+#define HDR_LINE_MAX 1024
+#define SEND_WAIT_MS 50                  /* blocked on a full reply buffer, look for cancel this often */
+#define IO_TIMEOUT_US (20 * 1000000LL)   /* nothing from the server this long: give up */
+#define CONNECT_TIMEOUT_MS 10000
+#define IDLE_CLOSE_US (60 * 1000000LL)   /* an unused connection is closed after this */
+#define STALE_US (45 * 1000000LL)        /* idle longer than this: reconnect rather than trust it */
+#define QUEUE_LEN 24
+#define STACK (10 * 1024)
+#define WARM_WIFI_WAIT_MS 10000         /* waking from a nap, Wi-Fi takes a few seconds to rejoin */
+
+/* --- shared state (any task) -------------------------------------------------- */
+
+static char s_key[KEY_MAX];
+static bool s_key_loaded;
+static _Atomic int s_state = MUSE_GEMINI_TTS_IDLE;
+static _Atomic uint32_t s_gen;           /* the reply being spoken; bumped by begin and cancel */
+static _Atomic uint32_t s_audio_bytes;   /* PCM handed out for the current reply */
+static StreamBufferHandle_t s_out;       /* set by begin, read by the worker */
+static QueueHandle_t s_queue;
+static TaskHandle_t s_task;
+
+typedef enum { JOB_WARM, JOB_SAY, JOB_END } job_type_t;
+
+typedef struct {
+    job_type_t type;
+    uint32_t gen;
+    char *text;                          /* JOB_SAY, owned by the job */
+} job_t;
+
+/* --- worker-only state ---------------------------------------------------------- */
+
+static esp_tls_t *s_tls;
+static esp_tls_client_session_t *s_ticket;   /* resumes the TLS session on reconnect */
+static int64_t s_last_use_us;
+static uint32_t s_failed_gen;                /* a reply whose key or request was refused: skip the rest */
+static int s_sentence;                       /* sentences spoken in the current reply */
+static uint32_t s_rs_gen;                    /* the reply the resampler state belongs to */
+
+static struct {
+    uint8_t buf[RX_BUF];
+    size_t pos, len;
+} s_rx;
+
+static char *s_line;                         /* SSE_LINE_MAX */
+static size_t s_line_len;
+static bool s_line_overflow;
+
+/* The current request. */
+static struct {
+    uint32_t gen;
+    int64_t t0;
+    int64_t first_audio_us;
+    size_t pcm_bytes;
+    bool refused;                            /* HTTP 4xx, or an API error event */
+    /* Down to the speaker's rate: the API sends 24 kHz whatever sample_rate asks for. */
+    int rate;
+    uint32_t step;
+    uint32_t pos;
+    int16_t x0, h1, h2;
+    int primed;
+    uint8_t odd;
+    bool have_odd;
+} r;
+
+static inline int64_t now_us(void)
+{
+    return esp_timer_get_time();
+}
+
+static inline bool cancelled(void)
+{
+    return atomic_load(&s_gen) != r.gen;
+}
+
+/* --- key ------------------------------------------------------------------------ */
+
+static void load_key(void)
+{
+    if (s_key_loaded) {
+        return;
+    }
+    s_key_loaded = true;
+    s_key[0] = '\0';
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READONLY, &h) != ESP_OK) {
+        return;
+    }
+    size_t len = sizeof(s_key);
+    if (nvs_get_str(h, NVS_KEY, s_key, &len) != ESP_OK) {
+        s_key[0] = '\0';
+    }
+    nvs_close(h);
+}
+
+bool muse_gemini_tts_configured(void)
+{
+    load_key();
+    return s_key[0] != '\0';
+}
+
+static bool key_valid(const char *k)
+{
+    size_t n = strlen(k);
+    if (n < 20 || n >= KEY_MAX) {
+        return false;
+    }
+    for (size_t i = 0; i < n; i++) {
+        char c = k[i];
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+              c == '.')) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool muse_gemini_tts_console_command(const char *line)
+{
+    if (strncmp(line, COMMAND, strlen(COMMAND)) != 0) {
+        return false;
+    }
+    const char *key = line + strlen(COMMAND);
+    if (key[0] && !key_valid(key)) {
+        printf("@gemini_key error invalid\n");
+        fflush(stdout);
+        return true;
+    }
+    nvs_handle_t h;
+    esp_err_t err = nvs_open(NVS_NS, NVS_READWRITE, &h);
+    if (err == ESP_OK) {
+        err = key[0] ? nvs_set_str(h, NVS_KEY, key) : nvs_erase_key(h, NVS_KEY);
+        if (err == ESP_ERR_NVS_NOT_FOUND) {
+            err = ESP_OK;   /* clearing a key that wasn't there */
+        }
+        if (err == ESP_OK) {
+            err = nvs_commit(h);
+        }
+        nvs_close(h);
+    }
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "couldn't store the key: %s", esp_err_to_name(err));
+        printf("@gemini_key error storage\n");
+        fflush(stdout);
+        return true;
+    }
+    strlcpy(s_key, key, sizeof(s_key));
+    s_key_loaded = true;
+    /* Never log the key itself. */
+    ESP_LOGI(TAG, "%s", key[0] ? "Gemini key stored; replies will be spoken" : "Gemini key cleared; replies are captions only");
+    printf(key[0] ? "@gemini_key ok\n" : "@gemini_key cleared\n");
+    fflush(stdout);
+    return true;
+}
+
+/* --- connection ------------------------------------------------------------------ */
+
+static void conn_close(void)
+{
+    if (s_tls) {
+        esp_tls_conn_destroy(s_tls);
+        s_tls = NULL;
+    }
+    s_rx.pos = s_rx.len = 0;
+}
+
+/* Opens the TLS connection, resuming the last session when it can. */
+static bool conn_open(void)
+{
+    conn_close();
+    int64_t t0 = now_us();
+    s_tls = esp_tls_init();
+    if (!s_tls) {
+        return false;
+    }
+    esp_tls_cfg_t cfg = {
+        .crt_bundle_attach = esp_crt_bundle_attach,
+        .timeout_ms = CONNECT_TIMEOUT_MS,
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+        .client_session = s_ticket,
+#endif
+    };
+    if (esp_tls_conn_new_sync(HOST, strlen(HOST), 443, &cfg, s_tls) != 1) {
+        ESP_LOGW(TAG, "can't reach the Gemini API");
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+        if (s_ticket) {
+            /* The ticket may be what was refused: the next try starts afresh. */
+            esp_tls_free_client_session(s_ticket);
+            s_ticket = NULL;
+        }
+#endif
+        conn_close();
+        return false;
+    }
+    bool resumed = s_ticket != NULL;
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+    if (s_ticket) {
+        esp_tls_free_client_session(s_ticket);
+    }
+    s_ticket = esp_tls_get_client_session(s_tls);
+#endif
+    int fd;
+    if (esp_tls_get_conn_sockfd(s_tls, &fd) == ESP_OK) {
+        lwip_fcntl(fd, F_SETFL, lwip_fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+    }
+    s_last_use_us = now_us();
+    ESP_LOGI(TAG, "connected in %d ms%s", (int)((now_us() - t0) / 1000), resumed ? " (resumed session)" : "");
+    return true;
+}
+
+/* A connection that's open and not so old the server may have dropped it. */
+static bool conn_fresh(void)
+{
+    return s_tls && now_us() - s_last_use_us < STALE_US;
+}
+
+static bool conn_write(const char *data, size_t len)
+{
+    int64_t deadline = now_us() + IO_TIMEOUT_US;
+    while (len) {
+        ssize_t n = esp_tls_conn_write(s_tls, data, len);
+        if (n > 0) {
+            data += n;
+            len -= n;
+        } else if (n == ESP_TLS_ERR_SSL_WANT_READ || n == ESP_TLS_ERR_SSL_WANT_WRITE) {
+            if (now_us() > deadline || cancelled()) {
+                return false;
+            }
+            vTaskDelay(1);
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* Next byte of the response: 1 ok, 0 closed, -1 error or timeout, -2 cancelled. */
+static int rx_byte(uint8_t *c)
+{
+    if (s_rx.pos < s_rx.len) {
+        *c = s_rx.buf[s_rx.pos++];
+        return 1;
+    }
+    int64_t deadline = now_us() + IO_TIMEOUT_US;
+    for (;;) {
+        if (cancelled()) {
+            return -2;
+        }
+        ssize_t n = esp_tls_conn_read(s_tls, s_rx.buf, sizeof(s_rx.buf));
+        if (n > 0) {
+            s_rx.pos = 0;
+            s_rx.len = n;
+            *c = s_rx.buf[s_rx.pos++];
+            return 1;
+        }
+        if (n == 0) {
+            return 0;
+        }
+        if (n != ESP_TLS_ERR_SSL_WANT_READ && n != ESP_TLS_ERR_SSL_WANT_WRITE) {
+            return -1;
+        }
+        if (now_us() > deadline) {
+            ESP_LOGW(TAG, "the Gemini API went quiet");
+            return -1;
+        }
+        vTaskDelay(pdMS_TO_TICKS(5));
+    }
+}
+
+/* One CRLF line, without its ending. False if the connection failed or it was too long. */
+static bool rx_line(char *out, size_t cap)
+{
+    size_t n = 0;
+    for (;;) {
+        uint8_t c;
+        if (rx_byte(&c) != 1) {
+            return false;
+        }
+        if (c == '\n') {
+            break;
+        }
+        if (c != '\r') {
+            if (n + 1 >= cap) {
+                return false;
+            }
+            out[n++] = (char)c;
+        }
+    }
+    out[n] = '\0';
+    return true;
+}
+
+/* --- audio ------------------------------------------------------------------------- */
+
+static void put_pcm(const uint8_t *pcm, size_t n)
+{
+    if (!r.first_audio_us) {
+        r.first_audio_us = now_us();
+    }
+    while (n && !cancelled()) {
+        size_t sent = xStreamBufferSend(s_out, pcm, n, pdMS_TO_TICKS(SEND_WAIT_MS));
+        pcm += sent;
+        n -= sent;
+        r.pcm_bytes += sent;
+        atomic_fetch_add(&s_audio_bytes, sent);
+    }
+}
+
+/* One input sample: a [1 2 1]/4 low-pass, then linear interpolation down to 16 kHz. */
+static size_t resample_one(int16_t x, int16_t *out)
+{
+    int32_t y = ((int32_t)r.h2 + 2 * r.h1 + x) / 4;   /* centred on h1 */
+    r.h2 = r.h1;
+    r.h1 = x;
+    if (r.primed < 3) {
+        if (++r.primed == 3) {
+            r.x0 = (int16_t)y;
+            r.pos = 0;
+        }
+        return 0;
+    }
+    size_t n = 0;
+    while (r.pos < 65536) {
+        out[n++] = (int16_t)(r.x0 + (int32_t)(((int64_t)(y - r.x0) * r.pos) >> 16));
+        r.pos += r.step;
+    }
+    r.pos -= 65536;
+    r.x0 = (int16_t)y;
+    return n;
+}
+
+static void put_audio(const uint8_t *bytes, size_t len, int rate)
+{
+    if (rate <= 0) {
+        rate = 24000;
+    }
+    if (rate != r.rate) {
+        r.rate = rate;
+        r.step = (uint32_t)(((uint64_t)rate << 16) / MUSE_GEMINI_TTS_RATE);
+    }
+    int16_t out[64];
+    size_t n = 0;
+    for (size_t i = 0; i < len && !cancelled(); i++) {
+        if (!r.have_odd) {
+            r.odd = bytes[i];
+            r.have_odd = true;
+            continue;
+        }
+        int16_t x = (int16_t)(r.odd | bytes[i] << 8);   /* little-endian */
+        r.have_odd = false;
+        if (rate == MUSE_GEMINI_TTS_RATE) {
+            out[n++] = x;
+        } else {
+            n += resample_one(x, out + n);
+        }
+        if (n > 60) {
+            put_pcm((const uint8_t *)out, n * sizeof(int16_t));
+            n = 0;
+        }
+    }
+    if (n) {
+        put_pcm((const uint8_t *)out, n * sizeof(int16_t));
+    }
+}
+
+static void put_base64(const char *b64, int rate)
+{
+    size_t in = strlen(b64);
+    if (!in) {
+        return;
+    }
+    size_t cap = in / 4 * 3 + 3;
+    uint8_t *pcm = heap_caps_malloc(cap, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!pcm) {
+        ESP_LOGW(TAG, "no memory for %u bytes of audio", (unsigned)cap);
+        return;
+    }
+    size_t out = 0;
+    if (mbedtls_base64_decode(pcm, cap, &out, (const unsigned char *)b64, in) == 0) {
+        put_audio(pcm, out, rate);
+    } else {
+        ESP_LOGW(TAG, "bad base64 audio");
+    }
+    free(pcm);
+}
+
+/*
+ * Any object shaped {"type": "audio", "data": "<base64>"} anywhere in the
+ * event: a stream's step.delta, or a whole model_output.
+ */
+static void find_audio(const cJSON *node)
+{
+    if (!node || cancelled()) {
+        return;
+    }
+    if (cJSON_IsObject(node)) {
+        const cJSON *type = cJSON_GetObjectItemCaseSensitive(node, "type");
+        const cJSON *data = cJSON_GetObjectItemCaseSensitive(node, "data");
+        if (cJSON_IsString(type) && !strcmp(type->valuestring, "audio") && cJSON_IsString(data)) {
+            const cJSON *rate = cJSON_GetObjectItemCaseSensitive(node, "sample_rate");
+            put_base64(data->valuestring, cJSON_IsNumber(rate) ? rate->valueint : 0);
+            return;
+        }
+    }
+    for (const cJSON *c = node->child; c; c = c->next) {
+        find_audio(c);
+    }
+}
+
+static void on_event(char *json)
+{
+    if (!strcmp(json, "[DONE]")) {
+        return;
+    }
+    cJSON *ev = cJSON_Parse(json);
+    if (!ev) {
+        ESP_LOGW(TAG, "unparsable event (%u bytes)", (unsigned)strlen(json));
+        return;
+    }
+    const cJSON *err = cJSON_GetObjectItemCaseSensitive(ev, "error");
+    if (err) {
+        const cJSON *msg = cJSON_GetObjectItemCaseSensitive(err, "message");
+        ESP_LOGW(TAG, "API error: %s", cJSON_IsString(msg) ? msg->valuestring : "(no message)");
+        r.refused = true;
+    } else {
+        find_audio(ev);
+    }
+    cJSON_Delete(ev);
+}
+
+/* Splits the body into SSE lines and hands each "data:" payload on. */
+static void feed(const uint8_t *buf, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        char c = (char)buf[i];
+        if (c == '\r') {
+            continue;
+        }
+        if (c != '\n') {
+            if (s_line_len < SSE_LINE_MAX - 1) {
+                s_line[s_line_len++] = c;
+            } else {
+                s_line_overflow = true;
+            }
+            continue;
+        }
+        s_line[s_line_len] = '\0';
+        if (s_line_overflow) {
+            ESP_LOGW(TAG, "event over %u bytes dropped", (unsigned)SSE_LINE_MAX);
+        } else if (!strncmp(s_line, "data:", 5)) {
+            char *p = s_line + 5;
+            while (*p == ' ') {
+                p++;
+            }
+            on_event(p);
+        }
+        s_line_len = 0;
+        s_line_overflow = false;
+    }
+}
+
+/* --- request ------------------------------------------------------------------------ */
+
+static char *request_body(const char *text)
+{
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "model", MODEL);
+    cJSON *input = cJSON_AddArrayToObject(root, "input");
+    cJSON *turn = cJSON_CreateObject();
+    cJSON_AddStringToObject(turn, "type", "user_input");
+    cJSON *content = cJSON_AddArrayToObject(turn, "content");
+    cJSON *part = cJSON_CreateObject();
+    cJSON_AddStringToObject(part, "type", "text");
+    cJSON_AddStringToObject(part, "text", text);
+    cJSON_AddItemToArray(content, part);
+    cJSON_AddItemToArray(input, turn);
+    cJSON *fmt = cJSON_AddObjectToObject(root, "response_format");
+    cJSON_AddStringToObject(fmt, "type", "audio");
+    cJSON_AddStringToObject(fmt, "mime_type", "audio/l16");
+    cJSON *gen = cJSON_AddObjectToObject(root, "generation_config");
+    cJSON *speech = cJSON_AddArrayToObject(gen, "speech_config");
+    cJSON *voice = cJSON_CreateObject();
+    cJSON_AddStringToObject(voice, "voice", VOICE);
+    cJSON_AddItemToArray(speech, voice);
+    cJSON_AddBoolToObject(root, "stream", true);
+    char *body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    return body;
+}
+
+typedef enum { REQ_OK, REQ_RETRY, REQ_FAILED } req_result_t;
+
+/*
+ * One sentence over the open connection: HTTP/1.1 with keep-alive, the body
+ * chunked (or sized) and read as SSE. REQ_RETRY means nothing came back, so a
+ * fresh connection can try again (a kept connection the server had dropped).
+ */
+static req_result_t request(const char *body)
+{
+    char head[512];
+    size_t blen = strlen(body);
+    int hl = snprintf(head, sizeof(head),
+                      "POST " PATH " HTTP/1.1\r\n"
+                      "Host: " HOST "\r\n"
+                      "Content-Type: application/json\r\n"
+                      "Accept: text/event-stream\r\n"
+                      "x-goog-api-key: %s\r\n"
+                      "Content-Length: %u\r\n"
+                      "Connection: keep-alive\r\n\r\n",
+                      s_key, (unsigned)blen);
+    if (hl <= 0 || hl >= (int)sizeof(head)) {
+        return REQ_FAILED;
+    }
+    s_rx.pos = s_rx.len = 0;
+    bool sent = conn_write(head, hl) && conn_write(body, blen);
+    memset(head, 0, sizeof(head));   /* it held the key */
+    if (!sent) {
+        return cancelled() ? REQ_FAILED : REQ_RETRY;
+    }
+
+    char line[HDR_LINE_MAX];
+    if (!rx_line(line, sizeof(line))) {
+        return cancelled() ? REQ_FAILED : REQ_RETRY;
+    }
+    int status = 0;
+    if (sscanf(line, "HTTP/%*s %d", &status) != 1) {
+        ESP_LOGW(TAG, "bad status line");
+        return REQ_FAILED;
+    }
+    bool chunked = false, close_after = false;
+    long length = -1;
+    for (;;) {
+        if (!rx_line(line, sizeof(line))) {
+            return REQ_FAILED;
+        }
+        if (!line[0]) {
+            break;
+        }
+        if (!strncasecmp(line, "transfer-encoding:", 18) && strcasestr(line, "chunked")) {
+            chunked = true;
+        } else if (!strncasecmp(line, "content-length:", 15)) {
+            length = strtol(line + 15, NULL, 10);
+        } else if (!strncasecmp(line, "connection:", 11) && strcasestr(line, "close")) {
+            close_after = true;
+        }
+    }
+
+    s_line_len = 0;
+    s_line_overflow = false;
+    char err_text[400];
+    size_t err_len = 0;
+    bool ok = true;
+    uint8_t c;
+    if (chunked) {
+        for (;;) {
+            if (!rx_line(line, sizeof(line))) {
+                ok = false;
+                break;
+            }
+            long size = strtol(line, NULL, 16);
+            if (size <= 0) {
+                rx_line(line, sizeof(line));   /* the empty line after the last chunk */
+                break;
+            }
+            for (long i = 0; i < size; i++) {
+                if (rx_byte(&c) != 1) {
+                    ok = false;
+                    break;
+                }
+                if (status == 200) {
+                    feed(&c, 1);
+                } else if (err_len < sizeof(err_text) - 1) {
+                    err_text[err_len++] = (char)c;
+                }
+            }
+            if (!ok || !rx_line(line, sizeof(line))) {
+                ok = false;
+                break;
+            }
+        }
+    } else {
+        for (long i = 0; length < 0 || i < length; i++) {
+            int got = rx_byte(&c);
+            if (got == 0 && length < 0) {
+                break;
+            }
+            if (got != 1) {
+                ok = false;
+                break;
+            }
+            if (status == 200) {
+                feed(&c, 1);
+            } else if (err_len < sizeof(err_text) - 1) {
+                err_text[err_len++] = (char)c;
+            }
+        }
+        close_after |= length < 0;
+    }
+    if (s_line_len && ok) {
+        feed((const uint8_t *)"\n", 1);   /* a last event without its newline */
+    }
+    if (!ok || close_after) {
+        conn_close();
+    } else {
+        s_last_use_us = now_us();
+    }
+    if (status != 200) {
+        /* The error body says why (bad key, quota, model name); it never holds the key. */
+        err_text[err_len] = '\0';
+        ESP_LOGW(TAG, "HTTP %d: %.300s", status, err_text);
+        r.refused = status >= 400 && status < 500;
+        return REQ_FAILED;
+    }
+    return ok && !r.refused ? REQ_OK : REQ_FAILED;
+}
+
+/* Speaks one sentence into s_out. */
+static void say(uint32_t gen, const char *text)
+{
+    if (gen != s_rs_gen) {
+        /* A new reply: the resampler starts clean. */
+        memset(&r, 0, sizeof(r));
+        s_rs_gen = gen;
+        s_sentence = 0;
+    }
+    r.gen = gen;
+    r.t0 = now_us();
+    r.first_audio_us = 0;
+    r.pcm_bytes = 0;
+    r.refused = false;
+    s_sentence++;
+
+    char *body = request_body(text);
+    if (!body) {
+        return;
+    }
+    bool reused = conn_fresh();
+    req_result_t res = REQ_FAILED;
+    for (int attempt = 0; attempt < 2 && !cancelled(); attempt++) {
+        if (!conn_fresh() && !conn_open()) {
+            break;
+        }
+        res = request(body);
+        if (res != REQ_RETRY) {
+            break;
+        }
+        ESP_LOGI(TAG, "kept connection was closed; reconnecting");
+        conn_close();
+        reused = false;
+    }
+    free(body);
+    if (cancelled()) {
+        conn_close();   /* mid-response: the rest of it would still be coming */
+        return;
+    }
+    if (r.refused) {
+        s_failed_gen = gen;   /* the key or request was refused: the rest would be too */
+    }
+    ESP_LOGI(TAG, "sentence %d (%u chars, %s): first audio %d ms, %.2fs of speech in %.2fs%s", s_sentence,
+             (unsigned)strlen(text), reused ? "kept connection" : "new connection",
+             r.first_audio_us ? (int)((r.first_audio_us - r.t0) / 1000) : -1,
+             (double)r.pcm_bytes / 2 / MUSE_GEMINI_TTS_RATE, (now_us() - r.t0) / 1e6,
+             res == REQ_OK ? "" : " (failed)");
+}
+
+static void worker(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        job_t job;
+        TickType_t wait = s_tls ? pdMS_TO_TICKS(5000) : portMAX_DELAY;
+        if (xQueueReceive(s_queue, &job, wait) != pdTRUE) {
+            if (s_tls && now_us() - s_last_use_us > IDLE_CLOSE_US) {
+                conn_close();   /* nothing to say for a while: free it */
+            }
+            continue;
+        }
+        bool current = job.gen == atomic_load(&s_gen);
+        switch (job.type) {
+        case JOB_WARM:
+            if (!conn_fresh()) {
+                for (int waited = 0; !muse_wifi_connected() && waited < WARM_WIFI_WAIT_MS; waited += 100) {
+                    vTaskDelay(pdMS_TO_TICKS(100));
+                }
+                if (muse_wifi_connected() && !conn_fresh()) {
+                    r.gen = atomic_load(&s_gen);
+                    conn_open();
+                }
+            }
+            break;
+        case JOB_SAY:
+            if (current && job.gen != s_failed_gen) {
+                say(job.gen, job.text);
+            }
+            free(job.text);
+            break;
+        case JOB_END:
+            if (current) {
+                atomic_store(&s_state, atomic_load(&s_audio_bytes) ? MUSE_GEMINI_TTS_DONE : MUSE_GEMINI_TTS_FAILED);
+            }
+            break;
+        }
+    }
+}
+
+/* --- API ------------------------------------------------------------------------------ */
+
+static bool ensure_worker(void)
+{
+    if (s_task) {
+        return true;
+    }
+    s_queue = xQueueCreate(QUEUE_LEN, sizeof(job_t));
+    s_line = heap_caps_malloc(SSE_LINE_MAX, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!s_queue || !s_line ||
+        xTaskCreatePinnedToCoreWithCaps(worker, "gemini_tts", STACK, NULL, 4, &s_task, tskNO_AFFINITY,
+                                        MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        ESP_LOGE(TAG, "can't start the speech task");
+        s_task = NULL;
+        return false;
+    }
+    return true;
+}
+
+void muse_gemini_tts_warm(void)
+{
+    if (!muse_gemini_tts_configured() || !ensure_worker()) {
+        return;
+    }
+    job_t job = { .type = JOB_WARM, .gen = atomic_load(&s_gen) };
+    xQueueSend(s_queue, &job, 0);
+}
+
+bool muse_gemini_tts_begin(StreamBufferHandle_t out)
+{
+    if (!muse_gemini_tts_configured() || !ensure_worker()) {
+        return false;
+    }
+    s_out = out;
+    atomic_store(&s_audio_bytes, 0);
+    atomic_fetch_add(&s_gen, 1);
+    atomic_store(&s_state, MUSE_GEMINI_TTS_RUNNING);
+    return true;
+}
+
+bool muse_gemini_tts_say(const char *text, size_t len)
+{
+    char *copy = malloc(len + 1);
+    if (!copy) {
+        return false;
+    }
+    memcpy(copy, text, len);
+    copy[len] = '\0';
+    job_t job = { .type = JOB_SAY, .gen = atomic_load(&s_gen), .text = copy };
+    if (xQueueSend(s_queue, &job, pdMS_TO_TICKS(100)) != pdTRUE) {
+        free(copy);
+        return false;
+    }
+    return true;
+}
+
+void muse_gemini_tts_end(void)
+{
+    job_t job = { .type = JOB_END, .gen = atomic_load(&s_gen) };
+    if (xQueueSend(s_queue, &job, pdMS_TO_TICKS(100)) != pdTRUE) {
+        atomic_store(&s_state, atomic_load(&s_audio_bytes) ? MUSE_GEMINI_TTS_DONE : MUSE_GEMINI_TTS_FAILED);
+    }
+}
+
+muse_gemini_tts_state_t muse_gemini_tts_state(void)
+{
+    return (muse_gemini_tts_state_t)atomic_load(&s_state);
+}
+
+void muse_gemini_tts_cancel(void)
+{
+    atomic_fetch_add(&s_gen, 1);
+    atomic_store(&s_state, MUSE_GEMINI_TTS_IDLE);
+}
diff --git a/esp32/components/muse/muse_gemini_tts.h b/esp32/components/muse/muse_gemini_tts.h
new file mode 100644
index 0000000..4e10649
--- /dev/null
+++ b/esp32/components/muse/muse_gemini_tts.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "freertos/FreeRTOS.h"
+#include "freertos/stream_buffer.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Spoken replies through the Gemini API (gemini-3.8-flash-lite-tts, the
+ * Interactions API, streamed). The audio comes back as headerless 16-bit
+ * little-endian mono PCM at 24 kHz (the request's sample_rate is ignored), so
+ * it's resampled to the speaker's 16 kHz on the way to the reply buffer.
+ *
+ * A reply is spoken sentence by sentence as its text streams in: begin(), then
+ * say() for each sentence, then end(). One worker task speaks them in order
+ * over a single kept TLS connection, which warm() opens early (while Muse is
+ * still thinking) so the first sentence doesn't wait for the handshake.
+ *
+ * The API key is set over serial with the line ">gemini_key=AIza..." and kept
+ * in NVS; ">gemini_key=" with nothing after it clears it. Without a key,
+ * replies stay captions only.
+ */
+
+#define MUSE_GEMINI_TTS_RATE 16000
+
+typedef enum {
+    MUSE_GEMINI_TTS_IDLE,
+    MUSE_GEMINI_TTS_RUNNING,
+    MUSE_GEMINI_TTS_DONE,      /* end() reached, and some audio came */
+    MUSE_GEMINI_TTS_FAILED,    /* end() reached with no audio at all */
+} muse_gemini_tts_state_t;
+
+/* Console hook for ">gemini_key=...", the line without its '>'. False if it isn't that command. */
+bool muse_gemini_tts_console_command(const char *line);
+
+/* A key is stored. */
+bool muse_gemini_tts_configured(void);
+
+/* Opens the connection ahead of a reply, if there's a key and none is open. Returns at once. */
+void muse_gemini_tts_warm(void);
+
+/* Starts a reply whose PCM goes to `out` (empty it first). False if there's no key. */
+bool muse_gemini_tts_begin(StreamBufferHandle_t out);
+
+/* Queues one sentence of the reply (copied). False if it couldn't be queued. */
+bool muse_gemini_tts_say(const char *text, size_t len);
+
+/* No more sentences: the state becomes DONE or FAILED once the queued ones are spoken. */
+void muse_gemini_tts_end(void);
+
+muse_gemini_tts_state_t muse_gemini_tts_state(void);
+
+/* Drops the reply: queued sentences are skipped and the one being spoken stops. */
+void muse_gemini_tts_cancel(void);
+
+#ifdef __cplusplus
+}
+#endif
