+/* Speech through Gemini: the speaker is on, a key is set, and it's a voice turn. */
+static bool gemini_ok(void)
+{
+    return !s_turn.text && s_turn.texts && s_tts_pcm && muse_settings_speaker_on() && muse_gemini_tts_configured();
+}
+
+#define FIRST_SPEECH_MIN 16          /* the first piece: one sentence, but not a lone "Sure." or "1." */
+#define NEXT_SPEECH_MIN 80           /* later pieces: a few sentences at a time, fewer requests */
+#define SPEECH_MAX 300               /* no sentence end this long: split at a space */
+
+/* The word before s[i] is a number, as in a list's "1." or "3.5": not a sentence end. */
+static bool after_number(const char *s, size_t from, size_t i)
+{
+    size_t j = i;
+    while (j > from && s[j - 1] >= '0' && s[j - 1] <= '9') {
+        j--;
+    }
+    return j < i && (j == from || s[j - 1] == ' ' || s[j - 1] == '\n');
+}
+
+/*
+ * Where the next piece of text to speak ends (from `from`), or 0 to wait for
+ * more. A sentence ends at . ! ? followed by a space, or at a line break; a
+ * number's period ("1. ") doesn't count.
+ */
+static size_t speech_cut(const char *full, size_t from, size_t have, bool done)
+{
+    size_t min = from ? NEXT_SPEECH_MIN : FIRST_SPEECH_MIN;
+    size_t last_space = 0;
+    for (size_t i = from; i < have; i++) {
+        char c = full[i];
+        if (c == ' ') {
+            last_space = i;
+        }
+        bool end = c == '\n' || ((c == '.' || c == '!' || c == '?') && i + 1 < have &&
+                                  (full[i + 1] == ' ' || full[i + 1] == '\n') &&
+                                  !(c == '.' && after_number(full, from, i)));
+        if (end && i + 1 - from >= min) {
+            return i + 1;
+        }
+        if (i + 1 - from >= SPEECH_MAX && last_space > from) {
+            return last_space;
+        }
+    }
+    return done && have > from ? have : 0;
+}
+
+/*
+ * Text as it should be heard: Muse sometimes answers in markdown whatever the
+ * voice note asks, and "1." or "**" read aloud sounds wrong. Drops list
+ * numbers and bullets at the start of a line, markdown marks (* _ ` #) and
+ * emoji, and makes dashes into commas. Returns the cleaned length in out.
+ */
+static size_t speakable(const char *in, size_t len, char *out)
+{
+    size_t o = 0;
+    bool line_start = true;
+    for (size_t i = 0; i < len;) {
+        unsigned char c = (unsigned char)in[i];
+        if (line_start) {
+            size_t j = i;
+            while (j < len && in[j] == ' ') {
+                j++;
+            }
+            size_t k = j;
+            while (k < len && in[k] >= '0' && in[k] <= '9') {
+                k++;
+            }
+            if (k > j && k < len && (in[k] == '.' || in[k] == ')') && k + 1 < len && in[k + 1] == ' ') {
+                i = k + 2;   /* "1. " or "2) " */
+                line_start = false;
+                continue;
+            }
+            if (j + 1 < len && (in[j] == '-' || in[j] == '*' || in[j] == '#') && in[j + 1] == ' ') {
+                i = j + 2;   /* "- " "* " "# " */
+                line_start = false;
+                continue;
+            }
+            if (j + 3 < len && !memcmp(in + j, "\xE2\x80\xA2 ", 4)) {
+                i = j + 4;   /* "• " */
+                line_start = false;
+                continue;
+            }
+        }
+        line_start = c == '\n';
+        if (c == '*' || c == '_' || c == '`' || c == '#') {
+            i++;
+            continue;
+        }
+        if (c == 0xE2 && i + 2 < len && (unsigned char)in[i + 1] == 0x80 &&
+            ((unsigned char)in[i + 2] == 0x94 || (unsigned char)in[i + 2] == 0x93)) {
+            while (o && out[o - 1] == ' ') {
+                o--;   /* "word — word" and "word–word" become "word, word" */
+            }
+            out[o++] = ',';
+            out[o++] = ' ';
+            i += 3;
+            while (i < len && in[i] == ' ') {
+                i++;
+            }
+            continue;
+        }
+        if (c >= 0xF0) {
+            i += 4;   /* emoji and other 4-byte symbols */
+            continue;
+        }
+        if (c == 0xEF && i + 2 < len && (unsigned char)in[i + 1] == 0xB8 && (unsigned char)in[i + 2] == 0x8F) {
+            i += 3;   /* the emoji variation selector */
+            continue;
+        }
+        out[o++] = (char)c;
+        i++;
+    }
+    while (o && (out[o - 1] == ' ' || out[o - 1] == '\n')) {
+        o--;
+    }
+    return o;
+}
+
+/* Hands the reply's next complete sentences to Gemini, and ends it once all of it has gone. */
+static void feed_sentences(msg_t &m)
+{
+    if (m.tts_ended || !s_turn.texts) {
+        return;
+    }
+    const char *full = s_turn.texts + (&m - s_turn.msgs) * TEXT_MAX;
+    size_t have = strlen(full);
+    for (;;) {
+        size_t cut = speech_cut(full, m.spoken, have, m.done);
+        if (!cut) {
+            break;
+        }
+        size_t a = m.spoken;
+        while (a < cut && (full[a] == ' ' || full[a] == '\n')) {
+            a++;
+        }
+        char clean[TEXT_MAX];
+        size_t n = cut > a ? speakable(full + a, cut - a, clean) : 0;
+        if (n && !muse_gemini_tts_say(clean, n)) {
+            ESP_LOGW(TAG, "couldn't queue speech; the rest is shown");
+            m.spoken = (uint16_t)have;
+            break;
+        }
+        m.spoken = (uint16_t)cut;
+    }
+    if (m.done && m.spoken >= have) {
+        muse_gemini_tts_end();
+        m.tts_ended = true;
+    }
+}
