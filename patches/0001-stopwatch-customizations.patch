@@ -371,6 +390,17 @@ esp_err_t muse_audio_write(const int16_t *mono, size_t frames)
     return ESP_OK;
 }
 
+float muse_audio_take_limiting(void)
+{
+#if CONFIG_MUSE_SPEAKER_BOOST_DB
+    float db = 20.0f * log10f(s_env_max / LIMIT);
+    s_env_max = LIMIT;
+    return db;
+#else
+    return 0;
+#endif
+}
