@@ -68,3 +68,21 @@ CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
 # actually slept, and how long each power lock kept the chip awake.
 CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
 CONFIG_PM_PROFILING=y
+
+# Gemini TTS: Google serves GTS Root R4 cross-signed by GlobalSign; verify it against the bundled R4.
+CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
+# Gemini TTS: resume the TLS session when the kept connection has to reconnect.
+CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
+
+# The avatar clips live in their own partition (partitions_stopwatch.csv: partitions_muse.csv + "anims").
+CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_stopwatch.csv"
+
+# Internal RAM is the scarce resource. Unread TCP data waits in Wi-Fi RX buffers, which must be
+# internal; 16 caps that backlog at ~26 KB. The SDK pins the TCP window at 16384 for the tunnel.
+CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
+
+# The speaker is quiet: the AW8737A's 200 kΩ input resistors (R57/R58) give it ×1.48, so full-scale
+# PCM drives ~0.2 W of its 1.2 W. Full volume until one is saved in Settings, and speech raised
+# 12 dB into a limiter (muse_audio_write) so its average level, not just its peaks, nears full scale.
+CONFIG_MUSE_DEFAULT_VOLUME=100
+CONFIG_MUSE_SPEAKER_BOOST_DB=12
