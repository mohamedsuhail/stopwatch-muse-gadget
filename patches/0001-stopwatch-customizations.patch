+/*
+ * States and status lines are written in capitals ("LISTENING", "SPEAKER
+ * ON"); shown in sentence case instead ("Listening", "Speaker on"), with the
+ * names that keep their capitals (Muse, Wi-Fi...). Text with any lower-case
+ * letter, a reply from Muse, is returned as it is.
+ */
+static const char *sentence_case(const char *in, char *out, size_t cap)
+{
+    static const char *const KEEP[] = { "Muse", "Wi-Fi", "USB", "BLE", "PIN", "OK" };
+    size_t n = strlen(in);
+    if (n + 1 > cap) {
+        return in;
+    }
+    for (size_t i = 0; i < n; i++) {
+        if (in[i] >= 'a' && in[i] <= 'z') {
+            return in;
+        }
+    }
+    bool start = true;
+    for (size_t i = 0; i <= n; i++) {
+        char c = in[i];
+        if (c >= 'A' && c <= 'Z' && !start) {
+            c = (char)(c - 'A' + 'a');
+        }
+        if ((c >= 'a' && c <= 'z') && start) {
+            c = (char)(c - 'a' + 'A');
+        }
+        if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')) {
+            start = false;
+        } else if (c == '.' || c == '!' || c == '?' || c == '\n') {
+            start = true;
+        }
+        out[i] = c;
+    }
+    /* Words that keep their capitals, matched whole. */
+    for (size_t i = 0; i < n;) {
+        size_t j = i;
+        while (j < n && (((out[j] | 0x20) >= 'a' && (out[j] | 0x20) <= 'z') || out[j] == '-')) {
+            j++;
+        }
+        for (size_t k = 0; k < sizeof(KEEP) / sizeof(KEEP[0]) && j > i; k++) {
+            if (strlen(KEEP[k]) == j - i && !strncasecmp(out + i, KEEP[k], j - i)) {
+                memcpy(out + i, KEEP[k], j - i);
+            }
+        }
+        i = j > i ? j : i + 1;
+    }
+    return out;
+}
