+/* Moves Gemini's PCM on to the voice task while the reply buffer has room. */
+static void pump_gemini(void)
+{
+    static uint8_t odd[1];      /* a frame split across reads */
+    static bool have_odd;
+    msg_t &m = s_turn.msgs[s_turn.tts_msg];
+    uint8_t *buf = reinterpret_cast<uint8_t *>(s_pcm16);
+    const size_t cap = MINIMP3_MAX_SAMPLES_PER_FRAME * sizeof(int16_t);
+    muse_gemini_tts_state_t st = muse_gemini_tts_state();
+    for (;;) {
+        size_t room = xStreamBufferSpacesAvailable(s_out);
+        if (room < 2) {
+            break;
+        }
+        size_t want = (room < cap ? room : cap) - (have_odd ? 1 : 0);
+        size_t got = xStreamBufferReceive(s_tts_pcm, buf + (have_odd ? 1 : 0), want, 0);
+        if (!got) {
+            break;
+        }
+        if (have_odd) {
+            buf[0] = odd[0];
+            got++;
+            have_odd = false;
+        }
+        if (got & 1) {
+            odd[0] = buf[--got];
+            have_odd = true;
+        }
+        if (s_turn.gen == s_gen.load()) {
+            mark(M_AUDIO);
+            xStreamBufferSend(s_out, buf, got, 0);
+        }
+        s_turn.pcm_out += got / 2;
+    }
+    bool drained = !xStreamBufferBytesAvailable(s_tts_pcm);
+    if (st == MUSE_GEMINI_TTS_DONE && drained) {
+        have_odd = false;
+        m.pcm_frames = s_turn.pcm_out - m.pcm_start;
+        m.tts = TTS_FINISHED;
+        s_turn.tts_msg = -1;
+        s_turn.gemini = false;
+    } else if (st == MUSE_GEMINI_TTS_FAILED || st == MUSE_GEMINI_TTS_IDLE) {
+        /* No speech came: show the reply at reading pace instead. */
+        have_odd = false;
+        ESP_LOGW(TAG, "no speech from Gemini; showing the reply");
+        s_turn.gemini = false;
+        s_turn.silent = true;
+        m.pcm_start = s_turn.pcm_out;
+        m.pcm_frames = (uint32_t)(m.len * MIC_RATE / TEXT_CHARS_PER_S);
+    }
+}
+
 /* Decodes buffered MP3 while the reply buffer has room. */
 static void decode(void)
 {
     if (s_turn.tts_msg < 0) {
         return;
     }
+    if (s_turn.gemini) {
+        pump_gemini();
+        return;
+    }
     if (s_turn.silent) {
         pace_silently();
         return;
@@ -2058,6 +2134,7 @@ extern "C" void muse_hatch_start(void)
     }
     s_in = xStreamBufferCreateWithCaps(IN_BYTES, 1, MALLOC_CAP_SPIRAM);
     s_out = xStreamBufferCreateWithCaps(OUT_BYTES, 1, MALLOC_CAP_SPIRAM);
+    s_tts_pcm = xStreamBufferCreateWithCaps(MIC_RATE * 2 * 4, 1, MALLOC_CAP_SPIRAM);   /* 4 s; spoken replies are off without it */
     s_turn.chunk = static_cast<uint8_t *>(psram_alloc(DICT_CHUNK_BYTES + sizeof(MUSE_HATCH_NOTE_TAIL)));
     s_turn.mp3 = static_cast<uint8_t *>(psram_alloc(MP3_BUF));
