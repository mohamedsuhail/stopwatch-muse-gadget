+/* G.711 mu-law, one sample (as Sun's reference g711.c: 14 bits, biased, by segment). */
+static uint8_t ulaw(int16_t pcm)
+{
+    int v = pcm >> 2;
+    uint8_t mask = 0xff;
+    if (v < 0) {
+        v = -v;
+        mask = 0x7f;
+    }
+    v = (v > 8159 ? 8159 : v) + 0x21;
+    int seg = 0;
+    while (seg < 8 && v > (0x40 << seg) - 1) {   /* segment ends 0x3f, 0x7f, ... 0x1fff */
+        seg++;
+    }
+    if (seg == 8) {
+        return 0x7f ^ mask;   /* at the clip */
+    }
+    return (uint8_t)((seg << 4 | ((v >> (seg + 1)) & 0x0f)) ^ mask);
+}
+
+/* 16 kHz PCM to 8 kHz mu-law, a quarter of the bytes: the watch's Wi-Fi upload
+ * can be slower than 16 kHz PCM needs (43 KB/s once in base64), and speech
+ * recognition doesn't miss what's above 4 kHz. A (1 2 1)/4 filter, then every
+ * other sample. Returns the bytes written. */
+static size_t to_ulaw(const uint8_t *pcm, size_t bytes, uint8_t *out)
+{
+    size_t n = bytes / 2, o = 0;
+    for (size_t i = 0; i + 1 < n; i += 2) {
+        int16_t a = (int16_t)(pcm[2 * i] | pcm[2 * i + 1] << 8);
+        int16_t b = (int16_t)(pcm[2 * i + 2] | pcm[2 * i + 3] << 8);
+        out[o++] = ulaw((int16_t)((s_mic_prev + 2 * a + b) / 4));
+        s_mic_prev = b;
+    }
+    return o;
+}
+
+static bool gemini_send_mic(const uint8_t *pcm, size_t bytes);
+
+/* Up to 100 ms of mic per append, once the session is set up. */
+static void send_mic(void)
+{
+    /* Further behind than that (a slow network): drop the oldest rather than fall further behind. */
+    size_t have = xStreamBufferBytesAvailable(s_mic);
+    if (have > MIC_BEHIND && now_us() - s_ready_us > MIC_CATCH_UP_US) {
+        size_t drop = (have - MIC_BEHIND) & ~(size_t)1;
+        for (size_t got; drop && (got = xStreamBufferReceive(s_mic, s_mic_pcm, drop < MIC_SEND ? drop : MIC_SEND, 0));) {
+            drop -= got;
+            s_mic_dropped += got;
+        }
+    }
+    for (;;) {
+        size_t have = xStreamBufferBytesAvailable(s_mic);
+        if (!have || (have < MIC_SEND && now_us() - s_mic_sent_us < MIC_SEND_US)) {
+            return;
+        }
+        size_t n = xStreamBufferReceive(s_mic, s_mic_pcm, (have < MIC_SEND ? have : MIC_SEND) & ~(size_t)3, 0);
+        if (!n) {
+            return;
+        }
+        if (atomic_load(&s_prov) == LIVE_GEMINI) {
+            /* Gemini: 8 kHz PCM (it takes any rate), base64 in JSON, the only way it takes audio. */
+            if (!gemini_send_mic(s_mic_pcm, n)) {
+                return;
+            }
+        } else {
+            /* As a binary frame of raw mu-law (the session's input transport): no base64, no JSON. */
+            size_t coded = to_ulaw(s_mic_pcm, n, s_mic_ulaw);
+            if (!muse_ws_send_binary(s_ws, s_mic_ulaw, coded)) {
+                return;
+            }
+        }
+        s_mic_sent_us = now_us();
+        s_mic_bytes += n;
+        for (size_t i = 0; i + 1 < n; i += 2) {
+            int v = (int16_t)(s_mic_pcm[i] | s_mic_pcm[i + 1] << 8);
+            s_mic_sq += (double)v * v;
+            v = abs(v);
+            s_mic_peak = v > s_mic_peak ? v : s_mic_peak;
+            s_mic_clipped += v >= 32000;
+            s_mic_n++;
+        }
+        if (s_mic_sent_us - s_mic_log_us > 5000000) {
+            ESP_LOGI(TAG, "mic to the live voice: %.1fs so far (%.1fs dropped behind); last 5 s peak %.0f dBFS, rms %.0f dBFS, %u samples clipped",
+                     (double)s_mic_bytes / 2 / RATE, (double)s_mic_dropped / 2 / RATE,
+                     20.0 * log10((s_mic_peak + 1) / 32768.0),
+                     10.0 * log10(s_mic_sq / (s_mic_n ? s_mic_n : 1) / (32768.0 * 32768.0) + 1e-10),
+                     (unsigned)s_mic_clipped);
+            s_mic_log_us = s_mic_sent_us;
+            s_mic_peak = 0;
+            s_mic_sq = 0;
+            s_mic_n = s_mic_clipped = 0;
+        }
+    }
+}
+
+/* --- reply audio ---------------------------------------------------------------------- */
+
+/* Into the speaker buffer, as much as fits now; the rest waits in s_pend. */
+static void drain_pending(void)
+{
+    if (!s_pend) {
+        return;
+    }
+    if (s_drop) {
+        s_pend_off = s_pend_len;
+    }
+    size_t sent = xStreamBufferSend(s_speaker, s_pend + s_pend_off, s_pend_len - s_pend_off, 0);
+    s_pend_off += sent;
+    s_rx += sent;
+    if (s_pend_off >= s_pend_len) {
+        free(s_pend);
+        s_pend = NULL;
+        s_pend_len = s_pend_off = 0;
+    }
+}
+
+/* Reply audio for the speaker: `pcm` (PSRAM, n bytes) is taken over. */
+static void take_pcm(uint8_t *pcm, size_t n)
+{
+    if (s_drop || !r.active || r.cancelled) {
+        free(pcm);
+        return;
+    }
+    if (!r.audio) {
+        r.audio = true;
+        s_cap = (typeof(s_cap)){ .on = true, .muse = r.from_muse, .text = r.from_muse ? s_said : s_out,
+                                 .base = s_rx + (uint32_t)(s_pend ? s_pend_len - s_pend_off : 0), .shown = -1 };
+    }
+    n &= ~(size_t)1;
+    if (s_pend) {
+        /* Two messages in one read, with the speaker buffer full: keep both. */
+        size_t left = s_pend_len - s_pend_off;
+        uint8_t *both = heap_caps_malloc(left + n, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+        if (!both) {
+            ESP_LOGW(TAG, "no memory to queue %u bytes of audio", (unsigned)n);
+            free(pcm);
+            return;
+        }
+        memcpy(both, s_pend + s_pend_off, left);
+        memcpy(both + left, pcm, n);
+        free(s_pend);
+        free(pcm);
+        pcm = both;
+        n += left;
+    }
+    s_pend = pcm;
+    s_pend_len = n;
+    s_pend_off = 0;
+    drain_pending();
+}
+
+/* The reply's audio as binary frames (the session asks for them): raw PCM. */
+static void gemini_on_message(char *msg, size_t len);
+
+static void on_binary(uint8_t *data, size_t len, void *ctx)
+{
+    (void)ctx;
+    if (atomic_load(&s_prov) == LIVE_GEMINI) {
+        /* Gemini's events are JSON, sent as binary frames */
+        data[len < MSG_MAX ? len : MSG_MAX - 1] = '\0';
+        gemini_on_message((char *)data, len);
+        return;
+    }
+    if (s_drop || !r.active || r.cancelled || len < 2) {
+        return;
+    }
+    uint8_t *pcm = heap_caps_malloc(len, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!pcm) {
+        ESP_LOGW(TAG, "no memory for %u bytes of audio", (unsigned)len);
+        return;
+    }
+    memcpy(pcm, data, len);
+    take_pcm(pcm, len);
+}
+
+/* A response.output_audio.delta's base64, should it still come as JSON: taken
+ * straight from the message (no escapes in base64, so no JSON parse). */
+static void on_audio(char *msg)
+{
+    char *d = strstr(msg, "\"delta\":\"");
+    char *end = d ? strchr(d + 9, '"') : NULL;
+    if (!end || s_drop || !r.active || r.cancelled) {
+        return;
+    }
+    d += 9;
+    size_t in = end - d;
+    size_t cap = in / 4 * 3 + 3, n = 0;
+    uint8_t *pcm = heap_caps_malloc(cap, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!pcm) {
+        ESP_LOGW(TAG, "no memory for %u bytes of audio", (unsigned)cap);
+        return;
+    }
+    if (mbedtls_base64_decode(pcm, cap, &n, (const unsigned char *)d, in) != 0) {
+        ESP_LOGW(TAG, "bad base64 audio");
+        free(pcm);
+        return;
+    }
+    take_pcm(pcm, n);
+}
+
+/* --- barging in ------------------------------------------------------------------------- */
+
+/* Stops Grok mid-sentence: the speaker goes quiet and the rest of that response is dropped. */
+static void barge_in(const char *why)
+{
+    bool playing = atomic_load(&s_playing) || s_pend;
+    free(s_pend);
+    s_pend = NULL;
+    s_pend_len = s_pend_off = 0;
+    /* Under server VAD xAI stops the response itself when it hears you
+     * (response.cancel is for push-to-talk): what's left of it is only dropped. */
+    if (r.active && !r.cancelled) {
+        r.cancelled = true;
+        s_drop = true;
+    } else if (s_awaiting) {
+        s_cancel_next = true;
+        s_awaiting = false;
+        s_drop = true;
+    } else if (!playing) {
+        return;   /* nothing to stop */
+    }
+    s_say_next = s_say_unsaid = false;   /* you've moved on from Muse's answer, if it was still to come */
+    atomic_fetch_add(&s_flushes, 1);
+    ESP_LOGI(TAG, "barge-in (%s)", why);
+}
+
+/* --- Muse ---------------------------------------------------------------------------------- */
+
+/* Muse's typed-turn frames, from the chat task: queued for the live task. */
+static void console_sink(const char *type, const char *text, const char *fields)
+{
+    if (!atomic_load(&s_asking)) {
+        return;
+    }
+    muse_item_t it = { .msg = 0, .text = NULL };
+    if (!strcmp(type, "text")) {
+        it.type = M_TEXT;
+    } else if (!strcmp(type, "final")) {
+        it.type = M_FINAL;
+    } else if (!strcmp(type, "done")) {
+        it.type = M_DONE;
+    } else if (!strcmp(type, "error")) {
+        it.type = M_ERROR;
+    } else {
+        return;   /* sent, busy, message_done: nothing to do */
+    }
+    const char *m = strstr(fields, "\"msg\":");
+    it.msg = m ? atoi(m + 6) : 0;
+    if (text) {
+        size_t n = strlen(text);
+        it.text = heap_caps_malloc(n + 1, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+        if (!it.text) {
+            return;
+        }
+        memcpy(it.text, text, n + 1);
+    }
+    if (xQueueSend(s_muse_q, &it, 0) != pdTRUE) {
+        ESP_LOGW(TAG, "Muse's answer came faster than it could be kept");
+        free(it.text);
+    }
+}
+
+/* A question that's only small talk ("hi there, how are you doing today?"): Gemini
+ * sends these to the assistant however it's told not to, and Muse would take
+ * seconds. Small talk is a chat cue (a greeting, "how are you", thanks) and nothing
+ * else once filler words are gone, and it's about you, never the user: "how am I
+ * doing (today)" and "how am I doing on my weight loss" aren't. */
+static bool small_talk(const char *q)
+{
+    static const char *const CUES[] = { "hi", "hello", "hey", "how", "thanks", "thank", "morning", "evening",
+                                        "night", "up" };
+    static const char *const FILLER[] = {
+        "hi", "hello", "hey", "there", "so", "well", "oh", "and", "how", "are", "is", "was", "you", "your",
+        "yourself", "it", "its", "it's", "going", "doing", "today", "tonight", "now", "these", "days",
+        "what's", "whats", "what", "up", "good", "morning", "afternoon", "evening", "night", "thanks", "thank",
+        "much", "a", "lot", "muse", "mo", "mobot", "things", "the", "day", "been", "have", "has", "all", "ok",
+        "okay", "great", "nice", "doing?", "buddy", "friend",
+    };
+    char low[96];
+    size_t n = 0;
+    for (; q[n] && n < sizeof(low) - 1; n++) {
+        char c = (char)tolower((unsigned char)q[n]);
+        low[n] = isalnum((unsigned char)c) || c == '\'' ? c : ' ';   /* words only */
+    }
+    low[n] = '\0';
+    if (n > 60) {
+        return false;
+    }
+    bool cue = false;
+    char *save = NULL;
+    for (char *w = strtok_r(low, " ", &save); w; w = strtok_r(NULL, " ", &save)) {
+        bool filler = false;
+        for (size_t i = 0; i < sizeof(FILLER) / sizeof(FILLER[0]) && !filler; i++) {
+            filler = !strcmp(w, FILLER[i]);
+        }
+        if (!filler) {
+            return false;   /* something of substance: Muse's */
+        }
+        for (size_t i = 0; i < sizeof(CUES) / sizeof(CUES[0]); i++) {
+            cue |= !strcmp(w, CUES[i]);
+        }
+    }
+    return cue;
+}
+
+static void ask_muse(const char *call_id, const char *question)
+{
+    if (small_talk(question)) {
+        ESP_LOGI(TAG, "small talk, not for Muse: \"%.100s\"", question);
+        output(call_id, "result", "This is small talk, not a personal question: answer it yourself, warmly, as you.");
+        create_response();
+        return;
+    }
+    if (s_ask.active || s_deliver.pending) {
+        output(call_id, "error", "Still checking something else. Ask again in a moment.");
+        create_response();
+        return;
+    }
+    size_t n = sizeof(MUSE_STYLE) + strlen(question);
+    char *text = malloc(n);
+    if (!text) {
+        output(call_id, "error", "Couldn't check.");
+        create_response();
+        return;
+    }
+    snprintf(text, n, "%s%s", MUSE_STYLE, question);
+    memset(s_ask.lens, 0, sizeof(s_ask.lens));
+    s_ask.nmsgs = 0;
+    s_ask.active = true;
+    s_ask.profile = false;
+    s_ask.t0 = now_us();
+    strlcpy(s_ask.call_id, call_id, sizeof(s_ask.call_id));
+    ESP_LOGI(TAG, "asking Muse: \"%.200s\"", question);
+    atomic_store(&s_asking, true);
+    muse_hatch_text_turn(text);   /* it frees text */
+}
+
+/* Asks Muse for the profile, between conversations. */
+static void ask_profile(void)
+{
+    char *text = strdup(PROFILE_ASK);
+    if (!text) {
+        return;
+    }
+    memset(s_ask.lens, 0, sizeof(s_ask.lens));
+    s_ask.nmsgs = 0;
+    s_ask.active = s_ask.profile = true;
+    s_ask.t0 = now_us();
+    s_ask.call_id[0] = '\0';
+    ESP_LOGI(TAG, "asking Muse for the profile");
+    atomic_store(&s_asking, true);
+    muse_hatch_text_turn(text);
+}
+
+static void ask_done(const char *error)
+{
+    atomic_store(&s_asking, false);
+    s_ask.active = false;
+    if (s_ask.profile) {
+        if (error) {
+            ESP_LOGW(TAG, "Muse couldn't give the profile: %s", error);
+            return;
+        }
+        /* The answer's messages, joined, through s_deliver.text (free outside a conversation). */
+        size_t o = 0;
+        for (int i = 0; i < s_ask.nmsgs && i < MUSE_MSGS; i++) {
+            size_t n = s_ask.lens[i] < ANSWER_MAX - 2 - o ? s_ask.lens[i] : ANSWER_MAX - 2 - o;
+            memcpy(s_deliver.text + o, s_ask.texts + i * MUSE_MSG_MAX, n);
+            o += n;
+            s_deliver.text[o++] = '\n';
+        }
+        s_deliver.text[o] = '\0';
+        profile_answer(s_deliver.text);
+        return;
+    }
+    s_deliver.pending = true;
+    s_deliver.error = error != NULL;
+    strlcpy(s_deliver.call_id, s_ask.call_id, sizeof(s_deliver.call_id));
+    if (error) {
+        strlcpy(s_deliver.text, error, ANSWER_MAX);
+        ESP_LOGW(TAG, "Muse couldn't answer: %s", error);
+        return;
+    }
+    size_t o = 0;
+    for (int i = 0; i < s_ask.nmsgs && i < MUSE_MSGS; i++) {
+        if (!s_ask.lens[i]) {
+            continue;
+        }
+        if (o && o + 1 < ANSWER_MAX) {
+            s_deliver.text[o++] = '\n';
+        }
+        size_t n = s_ask.lens[i] < ANSWER_MAX - 1 - o ? s_ask.lens[i] : ANSWER_MAX - 1 - o;
+        memcpy(s_deliver.text + o, s_ask.texts + i * MUSE_MSG_MAX, n);
+        o += n;
+    }
+    s_deliver.text[o] = '\0';
+    ESP_LOGI(TAG, "Muse answered in %.1fs (%u chars)", (now_us() - s_ask.t0) / 1e6, (unsigned)o);
+    if (!o) {
+        s_deliver.error = true;
+        strlcpy(s_deliver.text, "nothing came back", ANSWER_MAX);
+    }
+}
+
+static void muse_frames(void)
+{
+    muse_item_t it;
+    while (xQueueReceive(s_muse_q, &it, 0) == pdTRUE) {
+        if (s_ask.active && it.msg >= 0 && it.msg < MUSE_MSGS && (it.type == M_TEXT || it.type == M_FINAL)) {
+            char *t = s_ask.texts + it.msg * MUSE_MSG_MAX;
+            size_t *len = &s_ask.lens[it.msg];
+            size_t at = it.type == M_FINAL ? 0 : *len;
+            size_t n = it.text ? strlen(it.text) : 0;
+            n = n < MUSE_MSG_MAX - 1 - at ? n : MUSE_MSG_MAX - 1 - at;
+            memcpy(t + at, it.text, n);
+            *len = at + n;
+            s_ask.nmsgs = it.msg + 1 > s_ask.nmsgs ? it.msg + 1 : s_ask.nmsgs;
+        } else if (s_ask.active && it.type == M_DONE) {
+            ask_done(NULL);
+        } else if (s_ask.active && it.type == M_ERROR && it.text && !strcmp(it.text, "CANCELLED")) {
+            /* the end of a turn cancelled before this one, arriving late: not this question's */
+        } else if (s_ask.active && it.type == M_ERROR) {
+            ask_done(it.text ? it.text : "an error");
+        }
+        free(it.text);
+    }
+    if (s_ask.active && now_us() - s_ask.t0 > MUSE_WAIT_US) {
+        muse_hatch_text_cancel();
+        ask_done("it took too long");
+    }
+}
+
+/* Hands Muse's answer to Grok when nobody is talking and nothing is playing. */
+static void clear_response(void);
+
+static void deliver(void)
+{
+    bool gemini = atomic_load(&s_prov) == LIVE_GEMINI;
+    /* Gemini's turn stays open until it has the tool's result (its calls block), so there it
+     * only waits for the speaker to finish what it was saying; xAI's turn is over by now. */
+    bool busy = gemini ? false : atomic_load(&s_you) || r.active || s_awaiting;
+    if (!s_deliver.pending || busy || s_pend || atomic_load(&s_playing) || !xStreamBufferIsEmpty(s_speaker)) {
+        return;
+    }
+    if (gemini) {
+        clear_response();   /* what comes next is Muse's answer, said: a response of its own */
+        s_drop = false;
+        atomic_store(&s_you, false);
+    }
+    s_deliver.pending = false;
+    if (s_deliver.error) {
+        char why[300];
+        snprintf(why, sizeof(why), "Muse couldn't answer: %s", s_deliver.text);
+        output(s_deliver.call_id, "error", why);
+        create_response();   /* Grok says it couldn't reach Muse */
+        return;
+    }
+    /* Faces become reactions now, as the answer is about to be said; the voice never says them. */
+    muse_hatch_take_faces(s_deliver.text, strlen(s_deliver.text));
+    size_t n = muse_hatch_strip_tags(s_deliver.text, s_deliver.text, ANSWER_MAX, NULL);
+    muse_hatch_speakable(s_deliver.text, n, s_said);
+    s_said_us = now_us();
+    s_nudged = s_say_unsaid = false;
+    if (atomic_load(&s_prov) == LIVE_GEMINI) {
+        /* No verbatim speech on Gemini: the answer goes back as the tool's result, to be said as it is. */
+        gemini_output(s_deliver.call_id, "answer", s_said,
+                      "Say this answer to the user now, word for word, adding nothing before or after it, in the voice its "
+                      "feeling calls for (warm, excited, gentle), not flat.");
+        await_response();
+        s_say_next = true;
+    } else {
+        output(s_deliver.call_id, "answer", s_said);
+        say(s_said);
+    }
+    ESP_LOGI(TAG, "reading Muse's answer: \"%.200s\"", s_said);
+}
+
+/* --- what xAI sends -------------------------------------------------------------------------- */
+
+static void set_mood(const char *args)
+{
+    cJSON *a = cJSON_Parse(args ? args : "{}");
+    const char *mood = cJSON_GetStringValue(cJSON_GetObjectItem(a, "mood"));
+    static const struct {
+        const char *name;
+        muse_reaction_t reaction;
+    } MOODS[] = {
+        { "joy", MUSE_REACT_JOY },
+        { "thinking", MUSE_REACT_THINKING },
+        { "sad", MUSE_REACT_SAD },
+        { "goodnight", MUSE_REACT_GOODNIGHT },
+    };
+    for (size_t i = 0; mood && i < sizeof(MOODS) / sizeof(MOODS[0]); i++) {
+        if (!strcmp(mood, MOODS[i].name)) {
+            ESP_LOGI(TAG, "mood: %s", mood);
+            muse_state_react(MOODS[i].reaction);
+        }
+    }
+    cJSON_Delete(a);
+}
+
+static void do_trick(const char *args)
+{
+    cJSON *a = cJSON_Parse(args ? args : "{}");
+    const char *trick = cJSON_GetStringValue(cJSON_GetObjectItem(a, "trick")) ?: "";
+    muse_trick_t t = !strcmp(trick, "bubbles") ? MUSE_TRICK_BUBBLES
+                   : !strcmp(trick, "juggle")  ? MUSE_TRICK_JUGGLE
+                   : !strcmp(trick, "wave")    ? MUSE_TRICK_WAVE
+                                               : MUSE_TRICK_NONE;
+    if (t != MUSE_TRICK_NONE) {
+        ESP_LOGI(TAG, "trick: %s", trick);
+        muse_state_do_trick(t);
+    }
+    cJSON_Delete(a);
+}
+
+static void add_call(const char *id, const char *name, const char *args)
+{
+    if (!id || !name) {
+        return;
+    }
+    for (int i = 0; i < r.ncalls; i++) {
+        if (!strcmp(r.calls[i].id, id)) {
+            return;
+        }
+    }
+    if (r.ncalls == CALLS_MAX) {
+        return;
+    }
+    strlcpy(r.calls[r.ncalls].id, id, ID_MAX);
+    strlcpy(r.calls[r.ncalls].name, name, sizeof(r.calls[0].name));
+    r.calls[r.ncalls].args = strdup(args ? args : "{}");
+    r.ncalls++;
+    ESP_LOGI(TAG, "Grok called %s %.200s", name, args ? args : "");
+    if (!strcmp(name, "set_mood")) {
+        set_mood(args);   /* straight away, while Grok may still be speaking */
+    } else if (!strcmp(name, "do_trick")) {
+        do_trick(args);
+    }
+}
+
+static void clear_response(void)
+{
+    for (int i = 0; i < r.ncalls; i++) {
+        free(r.calls[i].args);
+    }
+    memset(&r, 0, sizeof(r));
+}
+
+static void response_done(const cJSON *resp)
+{
+    /* Calls that only reached response.done (no arguments.done event). */
+    const cJSON *item;
+    cJSON_ArrayForEach(item, cJSON_GetObjectItem(resp, "output"))
+    {
+        if (!strcmp(cJSON_GetStringValue(cJSON_GetObjectItem(item, "type")) ?: "", "function_call")) {
+            add_call(cJSON_GetStringValue(cJSON_GetObjectItem(item, "call_id")),
+                     cJSON_GetStringValue(cJSON_GetObjectItem(item, "name")),
+                     cJSON_GetStringValue(cJSON_GetObjectItem(item, "arguments")));
+        }
+    }
+    const char *status = cJSON_GetStringValue(cJSON_GetObjectItem(resp, "status"));
+    bool cancelled = r.cancelled || (status && !strcmp(status, "cancelled"));
+    bool mood = false, asked = false;
+    for (int i = 0; i < r.ncalls; i++) {
+        if (!strcmp(r.calls[i].name, "set_mood") || !strcmp(r.calls[i].name, "do_trick")) {
+            output(r.calls[i].id, "ok", "true");
+            mood = true;
+        } else if (!strcmp(r.calls[i].name, "end_conversation")) {
+            output(r.calls[i].id, "ok", "true");
+            atomic_store(&s_ending, true);
+        } else if (!strcmp(r.calls[i].name, "ask_muse")) {
+            asked = true;
+            if (cancelled) {
+                output(r.calls[i].id, "error", "The user interrupted before the check.");
+            } else {
+                cJSON *a = cJSON_Parse(r.calls[i].args);
+                ask_muse(r.calls[i].id, cJSON_GetStringValue(cJSON_GetObjectItem(a, "question")) ?: "");
+                cJSON_Delete(a);
+            }
+        } else {
+            output(r.calls[i].id, "error", "unknown tool");
+        }
+        free(r.calls[i].args);
+    }
+    ESP_LOGI(TAG, "response done%s%s (%s)", r.from_muse ? ", Muse's answer" : "", cancelled ? ", cancelled" : "",
+             status ? status : "?");
+    bool audio = r.audio;
+    r.ncalls = 0;   /* their args are freed */
+    clear_response();
+    /* A response that only set a mood or did a trick waits on its tool result: let Grok go on. */
+    if (mood && !asked && !cancelled && !audio) {
+        create_response();
+    }
+}
+
+static bool contains(const char *s, const char *word)
+{
+    for (size_t n = strlen(word); *s; s++) {
+        if (!strncasecmp(s, word, n)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void on_error(const cJSON *ev)
+{
+    const cJSON *err = cJSON_GetObjectItem(ev, "error");
+    const char *msg = cJSON_GetStringValue(cJSON_GetObjectItem(err, "message"));
+    if (!msg) {
+        msg = cJSON_GetStringValue(cJSON_GetObjectItem(ev, "message")) ?: "(no message)";
+    }
+    /* Harmless: cancelling a response that already finished, or nothing left to cancel. */
+    if (contains(msg, "cancel") || contains(msg, "no active response") || contains(msg, "in progress")) {
+        ESP_LOGI(TAG, "xAI: %s", msg);
+        return;
+    }
+    ESP_LOGW(TAG, "xAI error: %s", msg);
+    s_awaiting = false;
+}
+
+static void on_text(char *msg, size_t len, void *ctx)
+{
+    (void)ctx;
+    if (atomic_load(&s_prov) == LIVE_GEMINI) {
+        gemini_on_message(msg, len);
+        return;
+    }
+    if (strstr(msg, "\"type\":\"response.output_audio.delta\"") || strstr(msg, "\"type\":\"response.audio.delta\"")) {
+        on_audio(msg);
+        return;
+    }
+    cJSON *ev = cJSON_ParseWithLength(msg, len);
+    const char *t = cJSON_GetStringValue(cJSON_GetObjectItem(ev, "type"));
+    if (!t) {
+        ESP_LOGW(TAG, "unparsable message (%u bytes)", (unsigned)len);
+        cJSON_Delete(ev);
+        return;
+    }
+    if (++s_events <= 12) {
+        ESP_LOGI(TAG, "xAI event %d: %s", s_events, t);
+    }
+    if (!strcmp(t, "response.output_audio_transcript.delta") || !strcmp(t, "response.audio_transcript.delta")) {
+        const char *d = cJSON_GetStringValue(cJSON_GetObjectItem(ev, "delta"));
+        if (d && !s_drop && !r.from_muse) {
+            size_t n = strlen(d) < OUT_TEXT_MAX - 1 - s_out_len ? strlen(d) : OUT_TEXT_MAX - 1 - s_out_len;
+            memcpy(s_out + s_out_len, d, n);
+            s_out_len += n;
+            s_out[s_out_len] = '\0';   /* shown as it's said: caption_tick() */
+        }
+    } else if (!strcmp(t, "response.output_audio_transcript.done") || !strcmp(t, "response.audio_transcript.done")) {
+        if (!r.from_muse && s_out_len) {
+            ESP_LOGI(TAG, "%s: \"%.300s\"", PROV_NAME(atomic_load(&s_prov)), s_out);
+        }
+    } else if (!strcmp(t, "conversation.item.input_audio_transcription.completed")) {
+        ESP_LOGI(TAG, "you: \"%.300s\"", cJSON_GetStringValue(cJSON_GetObjectItem(ev, "transcript")) ?: "");
+    } else if (!strcmp(t, "session.updated")) {
+        if (atomic_load(&s_state) == MUSE_LIVE_CONNECTING) {
+            s_ready_us = now_us();
+            ESP_LOGI(TAG, "session set up in %d ms", (int)((s_ready_us - s_setup_t0) / 1000));
+            atomic_store(&s_state, MUSE_LIVE_READY);
+        }
+    } else if (!strcmp(t, "input_audio_buffer.speech_started")) {
+        atomic_store(&s_you, true);
+        barge_in("xAI heard you");
+    } else if (!strcmp(t, "input_audio_buffer.speech_stopped")) {
+        atomic_store(&s_you, false);
+        await_response();   /* xAI's voice detection makes the response itself */
+    } else if (!strcmp(t, "response.created")) {
+        s_awaiting = false;
+        clear_response();
+        r.active = true;
+        strlcpy(r.id, cJSON_GetStringValue(cJSON_GetObjectItem(cJSON_GetObjectItem(ev, "response"), "id")) ?: "",
+                sizeof(r.id));
+        r.from_muse = s_say_next;
+        s_say_next = false;
+        s_out_len = 0;
+        s_out[0] = '\0';
+        atomic_store(&s_who, r.from_muse ? MUSE_RESPONDER_MUSE : MUSE_RESPONDER_GROK);
+        if (s_cancel_next) {
+            /* asked for before a barge-in or a click: not wanted any more, and xAI is told, or it
+             * makes (and bills) the whole of it while the next question waits behind it */
+            s_cancel_next = false;
+            r.cancelled = true;
+            send_raw("{\"type\":\"response.cancel\"}");
+        } else {
+            s_drop = false;
+        }
+    } else if (!strcmp(t, "response.function_call_arguments.done")) {
+        if (r.active) {
+            add_call(cJSON_GetStringValue(cJSON_GetObjectItem(ev, "call_id")),
+                     cJSON_GetStringValue(cJSON_GetObjectItem(ev, "name")),
+                     cJSON_GetStringValue(cJSON_GetObjectItem(ev, "arguments")));
+        }
+    } else if (!strcmp(t, "response.done")) {
+        response_done(cJSON_GetObjectItem(ev, "response"));
+    } else if (!strcmp(t, "error")) {
+        on_error(ev);
+    }
+    cJSON_Delete(ev);
+}
+
+/* --- Gemini Live ----------------------------------------------------------------------------------
+ *
+ * The same conversation through Google's Gemini Live API (BidiGenerateContent):
+ * its events are mapped onto the ones above. What differs: audio goes up as
+ * base64 PCM in JSON (8 kHz here) and comes down at 24 kHz (resampled to the
+ * speaker's 16 kHz); a tool call blocks the model until its result comes back
+ * (gemini-3.1-flash-live-preview calls tools only that way), and there's no
+ * verbatim speech, so Muse's answer goes back as the tool's result for Gemini
+ * to say. An interruption is serverContent.interrupted; your words come as
+ * inputTranscription, which during a maybe-barge-in is xAI's speech_started. */
+
+static muse_resample_t s_rs;
+static struct {
+    char id[ID_MAX];
+    char name[24];
+} s_gcalls[CALLS_MAX];                /* recent tool calls: a result must name its call */
+static int s_gcall_next;
+EXT_RAM_BSS_ATTR static char s_heard[512];   /* what you said this turn, for the log */
+EXT_RAM_BSS_ATTR static int16_t s_gem_in[MIC_SEND / 4];
+EXT_RAM_BSS_ATTR static char s_gem_append[128 + (MIC_SEND / 2 + 2) / 3 * 4];
+
+static void gemini_reset(void)
+{
+    muse_resample_init(&s_rs);
+    memset(s_gcalls, 0, sizeof(s_gcalls));
+    s_heard[0] = '\0';
+}
+
+static cJSON *gemini_function(const char *name, const char *desc, const char *arg, const char *arg_desc,
+                              const char **choices)
+{
+    cJSON *f = cJSON_CreateObject();
+    cJSON_AddStringToObject(f, "name", name);
+    cJSON_AddStringToObject(f, "description", desc);
+    cJSON *params = cJSON_AddObjectToObject(f, "parameters");
+    cJSON_AddStringToObject(params, "type", "OBJECT");
+    cJSON *a = cJSON_AddObjectToObject(cJSON_AddObjectToObject(params, "properties"), arg);
+    cJSON_AddStringToObject(a, "type", "STRING");
+    if (arg_desc) {
+        cJSON_AddStringToObject(a, "description", arg_desc);
+    }
+    if (choices) {
+        cJSON *e = cJSON_AddArrayToObject(a, "enum");
+        for (; *choices; choices++) {
+            cJSON_AddItemToArray(e, cJSON_CreateString(*choices));
+        }
+    }
+    cJSON_AddItemToArray(cJSON_AddArrayToObject(params, "required"), cJSON_CreateString(arg));
+    return f;
+}
+
+/* Every `from` in `text` becomes `to`, in place (`text` has room for it to grow). */
+static void replace_all(char *text, const char *from, const char *to)
+{
+    size_t fl = strlen(from), tl = strlen(to);
+    for (char *at = strstr(text, from); at; at = strstr(at + tl, from)) {
+        memmove(at + tl, at + fl, strlen(at + fl) + 1);
+        memcpy(at, to, tl);
+    }
+}
+
+/* The instructions as Gemini needs them: its search is Google Search, and as its tool
+ * calls block, anything it says "first" comes out after the answer: it says nothing,
+ * and the watch shows Muse's logo with a spinner while Muse works. */
+static void gemini_words(char *text)
+{
+    replace_all(text, "web_search", "Google Search");
+    replace_all(text, "say only \"Let me check.\" first, and nothing after it",
+                "say nothing at all, before or after it (the screen shows you're checking)");
+    /* Told it was Muse's voice, Gemini took "how are you" for a question for Muse: here it is
+     * Muse, and Muse's knowledge is a lookup. */
+    replace_all(text, "You are the voice of Muse, the user's personal agent. Muse holds the personal context of "
+                      "their life and projects; you don't have it yourself, so you ask Muse for it with ask_muse.",
+                "You are Muse, the user's personal agent, speaking with them. What you don't answer yourself, "
+                "you hand on with assistant_request.");
+    replace_all(text, "ask_muse", "assistant_request");
+    replace_all(text, "ask Muse", "use assistant_request");
+}
+
+/* The setup: who it is (persona, rules, what it knows of you), its voice, its tools
+ * (Muse, moods, Google Search) and both transcripts, for the captions and the log. */
+static bool gemini_configure(void)
+{
+    static const char *MOODS[] = { "joy", "thinking", "sad", "goodnight", NULL };
+    size_t n = sizeof(PERSONA) + sizeof(INSTRUCTIONS) + PROFILE_MAX + 1536;
+    char *instructions = heap_caps_malloc(n, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!instructions) {
+        return false;
+    }
+    size_t o = snprintf(instructions, n, "%s%s", PERSONA, INSTRUCTIONS);
+    about_you(instructions + o, n - o - 512);   /* room for gemini_words() to lengthen it */
+    gemini_words(instructions);
+    cJSON *msg = cJSON_CreateObject();
+    cJSON *setup = cJSON_AddObjectToObject(msg, "setup");
+    cJSON_AddStringToObject(setup, "model", GEMINI_MODEL);
+    cJSON *gen = cJSON_AddObjectToObject(setup, "generationConfig");
+    cJSON_AddItemToArray(cJSON_AddArrayToObject(gen, "responseModalities"), cJSON_CreateString("AUDIO"));
+    cJSON_AddStringToObject(cJSON_AddObjectToObject(cJSON_AddObjectToObject(cJSON_AddObjectToObject(gen, "speechConfig"),
+                                                                            "voiceConfig"),
+                                                    "prebuiltVoiceConfig"),
+                            "voiceName", GEMINI_VOICE);
+    cJSON *part = cJSON_CreateObject();
+    cJSON_AddStringToObject(part, "text", instructions);
+    free(instructions);
+    cJSON_AddItemToArray(cJSON_AddArrayToObject(cJSON_AddObjectToObject(setup, "systemInstruction"), "parts"), part);
+    cJSON *tools = cJSON_AddArrayToObject(setup, "tools");
+    cJSON *fns = cJSON_CreateObject();
+    cJSON *decls = cJSON_AddArrayToObject(fns, "functionDeclarations");
+    cJSON_AddItemToArray(decls, gemini_function("assistant_request", GEMINI_LOOKUP_DESC, "question",
+                                                "The question or request for Muse, self-contained, in the user's words.",
+                                                NULL));
+    cJSON_AddItemToArray(decls, gemini_function("set_mood", "Show a mood on the user's screen (it never needs mentioning).",
+                                                "mood", NULL, MOODS));
+    cJSON_AddItemToArray(decls, gemini_function("do_trick", TRICK_DESC, "trick", NULL, TRICKS));
+    cJSON_AddItemToArray(decls, gemini_function("end_conversation", END_DESC, "reason", "A few words on why.", NULL));
+    cJSON_AddItemToArray(tools, fns);
+    cJSON *search = cJSON_CreateObject();
+    cJSON_AddObjectToObject(search, "googleSearch");
+    cJSON_AddItemToArray(tools, search);
+    cJSON_AddObjectToObject(setup, "inputAudioTranscription");
+    cJSON_AddObjectToObject(setup, "outputAudioTranscription");
+    cJSON_AddObjectToObject(cJSON_AddObjectToObject(setup, "contextWindowCompression"), "slidingWindow");
+    return send_json(msg);
+}
+
+/* A tool's result (`note`: what to do with it, or NULL). */
+static void gemini_output(const char *call_id, const char *key, const char *value, const char *note)
+{
+    const char *name = "";
+    for (int i = 0; i < CALLS_MAX; i++) {
+        if (!strcmp(s_gcalls[i].id, call_id)) {
+            name = s_gcalls[i].name;
+        }
+    }
+    cJSON *msg = cJSON_CreateObject();
+    cJSON *fr = cJSON_CreateObject();
+    cJSON_AddStringToObject(fr, "id", call_id);
+    cJSON_AddStringToObject(fr, "name", name);
+    cJSON *resp = cJSON_AddObjectToObject(fr, "response");
+    cJSON_AddStringToObject(resp, key, value);
+    if (note) {
+        cJSON_AddStringToObject(resp, "note", note);
+    }
+    cJSON_AddItemToArray(cJSON_AddArrayToObject(cJSON_AddObjectToObject(msg, "toolResponse"), "functionResponses"), fr);
+    send_json(msg);
+}
+
+/* 16 kHz PCM to 8 kHz (the (1 2 1)/4 filter, every other sample), as base64 PCM in JSON. */
+static bool gemini_send_mic(const uint8_t *pcm, size_t bytes)
+{
+    size_t n = bytes / 2, o = 0;
+    for (size_t i = 0; i + 1 < n; i += 2) {
+        int16_t a = (int16_t)(pcm[2 * i] | pcm[2 * i + 1] << 8);
+        int16_t b = (int16_t)(pcm[2 * i + 2] | pcm[2 * i + 3] << 8);
+        s_gem_in[o++] = (int16_t)((s_mic_prev + 2 * a + b) / 4);
+        s_mic_prev = b;
+    }
+    static const char head[] = "{\"realtimeInput\":{\"audio\":{\"mimeType\":\"audio/pcm;rate=8000\",\"data\":\"";
+    memcpy(s_gem_append, head, sizeof(head) - 1);
+    size_t b64 = 0;
+    mbedtls_base64_encode((unsigned char *)s_gem_append + sizeof(head) - 1, sizeof(s_gem_append) - sizeof(head) - 4,
+                          &b64, (const unsigned char *)s_gem_in, o * 2);
+    size_t len = sizeof(head) - 1 + b64;
+    memcpy(s_gem_append + len, "\"}}}", 4);
+    len += 4;
+    return muse_ws_send_text(s_ws, s_gem_append, len);
+}
+
+static void gemini_typed(const char *text)
+{
+    cJSON *msg = cJSON_CreateObject();
+    cJSON *cc = cJSON_AddObjectToObject(msg, "clientContent");
+    cJSON *turn = cJSON_CreateObject();
+    cJSON_AddStringToObject(turn, "role", "user");
+    cJSON *part = cJSON_CreateObject();
+    cJSON_AddStringToObject(part, "text", text);
+    cJSON_AddItemToArray(cJSON_AddArrayToObject(turn, "parts"), part);
+    cJSON_AddItemToArray(cJSON_AddArrayToObject(cc, "turns"), turn);
+    cJSON_AddBoolToObject(cc, "turnComplete", true);
+    await_response();
+    send_json(msg);
+}
+
+/* Its turn has begun (its first words or sound). */
+static void gemini_begin(void)
+{
+    if (r.active || s_drop) {
+        return;
+    }
+    clear_response();
+    r.active = true;
+    r.from_muse = s_say_next;
+    s_say_next = false;
+    s_awaiting = false;
+    s_out_len = 0;
+    s_out[0] = '\0';
+    atomic_store(&s_you, false);
+    atomic_store(&s_who, r.from_muse ? MUSE_RESPONDER_MUSE : MUSE_RESPONDER_GEMINI);
+}
+
+static void gemini_audio(const char *b64)
+{
+    size_t in = strlen(b64), n = 0;
+    size_t cap = in / 4 * 3 + 3;
+    uint8_t *raw = heap_caps_malloc(cap, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!raw) {
+        return;
+    }
+    if (mbedtls_base64_decode(raw, cap, &n, (const unsigned char *)b64, in) != 0) {
+        free(raw);
+        return;
+    }
+    size_t samples = n / 2;
+    int16_t *pcm = heap_caps_malloc((samples * 2 / 3 + 4) * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!pcm) {
+        free(raw);
+        return;
+    }
+    size_t m = muse_resample_24k_16k(&s_rs, (const int16_t *)raw, samples, pcm);
+    free(raw);
+    take_pcm((uint8_t *)pcm, m * sizeof(int16_t));
+}
+
+static void gemini_server_content(const cJSON *sc)
+{
+    if (cJSON_IsTrue(cJSON_GetObjectItem(sc, "interrupted"))) {
+        barge_in("Gemini heard you");
+        s_drop = true;   /* until its turn is over */
+    }
+    const char *heard = cJSON_GetStringValue(cJSON_GetObjectItem(cJSON_GetObjectItem(sc, "inputTranscription"), "text"));
+    if (heard && heard[0]) {
+        /* Its transcript of you comes late, often once its answer has begun: it's never a
+         * barge-in (the mic doesn't go to Gemini while it speaks; serverContent.interrupted is). */
+        strlcat(s_heard, heard, sizeof(s_heard));
+        if (!r.active) {
+            atomic_store(&s_you, true);
+            await_response();
+        }
+    }
+    const cJSON *part;
+    cJSON_ArrayForEach(part, cJSON_GetObjectItem(cJSON_GetObjectItem(sc, "modelTurn"), "parts"))
+    {
+        const char *data = cJSON_GetStringValue(cJSON_GetObjectItem(cJSON_GetObjectItem(part, "inlineData"), "data"));
+        if (data && !s_drop) {
+            gemini_begin();
+            gemini_audio(data);
+        }
+    }
+    const char *said = cJSON_GetStringValue(cJSON_GetObjectItem(cJSON_GetObjectItem(sc, "outputTranscription"), "text"));
+    if (said && !s_drop) {
+        gemini_begin();
+        if (!r.from_muse) {
+            size_t n = strlen(said) < OUT_TEXT_MAX - 1 - s_out_len ? strlen(said) : OUT_TEXT_MAX - 1 - s_out_len;
+            memcpy(s_out + s_out_len, said, n);
+            s_out_len += n;
+            s_out[s_out_len] = '\0';
+        }
+    }
+    if (cJSON_IsTrue(cJSON_GetObjectItem(sc, "turnComplete"))) {
+        s_say_unsaid = s_say_next;   /* a turn over, and Muse's answer still not begun */
+        if (s_heard[0]) {
+            ESP_LOGI(TAG, "you: \"%.300s\"", s_heard);
+            s_heard[0] = '\0';
+        }
+        if (r.active) {
+            ESP_LOGI(TAG, "Gemini%s: \"%.300s\"", r.from_muse ? " (Muse's answer)" : "", r.from_muse ? s_said : s_out);
+        }
+        clear_response();
+        s_drop = false;
+        s_awaiting = false;
+        atomic_store(&s_you, false);
+        if (s_end_pending) {
+            s_end_pending = false;
+            atomic_store(&s_ending, true);
+        }
+    }
+}
+
+static void gemini_tool_call(const cJSON *tc)
+{
+    const cJSON *fc;
+    cJSON_ArrayForEach(fc, cJSON_GetObjectItem(tc, "functionCalls"))
+    {
+        const char *id = cJSON_GetStringValue(cJSON_GetObjectItem(fc, "id")) ?: "";
+        const char *name = cJSON_GetStringValue(cJSON_GetObjectItem(fc, "name")) ?: "";
+        const cJSON *args = cJSON_GetObjectItem(fc, "args");
+        strlcpy(s_gcalls[s_gcall_next].id, id, ID_MAX);
+        strlcpy(s_gcalls[s_gcall_next].name, name, sizeof(s_gcalls[0].name));
+        s_gcall_next = (s_gcall_next + 1) % CALLS_MAX;
+        char *a = args ? cJSON_PrintUnformatted(args) : NULL;
+        ESP_LOGI(TAG, "Gemini called %s %.200s", name, a ? a : "");
+        if (!strcmp(name, "set_mood")) {
+            set_mood(a);
+            gemini_output(id, "result", "ok", NULL);
+        } else if (!strcmp(name, "do_trick")) {
+            do_trick(a);
+            gemini_output(id, "result", "ok", NULL);
+        } else if (!strcmp(name, "end_conversation")) {
+            /* Its call comes before its goodbye's audio: the end waits for the turn's end. */
+            gemini_output(id, "result", "ok", NULL);
+            s_end_pending = true;
+            s_end_called_us = now_us();
+        } else if (!strcmp(name, "assistant_request") || !strcmp(name, "ask_muse")) {
+            ask_muse(id, cJSON_GetStringValue(cJSON_GetObjectItem(args, "question")) ?: "");
+        } else {
+            gemini_output(id, "error", "unknown tool", NULL);
+        }
+        cJSON_free(a);
+    }
+}
+
+static void gemini_on_message(char *msg, size_t len)
+{
+    s_gemini_heard_us = now_us();
+    cJSON *ev = cJSON_ParseWithLength(msg, len);
+    if (!ev) {
+        ESP_LOGW(TAG, "unparsable message (%u bytes)", (unsigned)len);
+        return;
+    }
+    if (++s_events <= 6) {
+        const cJSON *first = ev->child;
+        ESP_LOGI(TAG, "Gemini event %d: %s", s_events, first && first->string ? first->string : "?");
+    }
+    const cJSON *sc = cJSON_GetObjectItem(ev, "serverContent");
+    const cJSON *tc = cJSON_GetObjectItem(ev, "toolCall");
+    const cJSON *cancel = cJSON_GetObjectItem(ev, "toolCallCancellation");
+    const cJSON *away = cJSON_GetObjectItem(ev, "goAway");
+    if (cJSON_GetObjectItem(ev, "setupComplete") && atomic_load(&s_state) == MUSE_LIVE_CONNECTING) {
+        s_ready_us = now_us();
+        ESP_LOGI(TAG, "session set up in %d ms", (int)((s_ready_us - s_setup_t0) / 1000));
+        atomic_store(&s_state, MUSE_LIVE_READY);
+    }
+    if (sc) {
+        gemini_server_content(sc);
+    }
+    if (tc) {
+        gemini_tool_call(tc);
+    }
+    const cJSON *id;
+    cJSON_ArrayForEach(id, cJSON_GetObjectItem(cancel, "ids"))
+    {
+        if (s_ask.active && !strcmp(cJSON_GetStringValue(id) ?: "", s_ask.call_id)) {
+            ESP_LOGI(TAG, "Gemini dropped its question to Muse");
+            muse_hatch_text_cancel();
+            s_ask.active = false;
+            atomic_store(&s_asking, false);
+        }
+    }
+    if (away) {
+        ESP_LOGW(TAG, "Gemini will close the connection in %s",
+                 cJSON_GetStringValue(cJSON_GetObjectItem(away, "timeLeft")) ?: "?");
+    }
+    cJSON_Delete(ev);
+}
+
+/* --- the session ------------------------------------------------------------------------------ */
+
+static void forget(void)
+{
+    clear_response();
+    s_cap.on = false;
+    s_awaiting = s_cancel_next = s_drop = s_say_next = s_say_unsaid = s_nudged = false;
+    free(s_pend);
+    s_pend = NULL;
+    s_pend_len = s_pend_off = 0;
+    if (s_ask.active) {
+        muse_hatch_text_cancel();
+        s_ask.active = false;
+    }
+    atomic_store(&s_asking, false);
+    s_deliver.pending = false;
+    muse_item_t it;
+    while (xQueueReceive(s_muse_q, &it, 0) == pdTRUE) {
+        free(it.text);
+    }
+    atomic_store(&s_you, false);
+    atomic_store(&s_who, MUSE_RESPONDER_NONE);
+}
+
+/* Modem sleep (kept for BLE coexistence) holds every packet to the watch until
+ * the next beacon, which starves the mic's upload: off for the conversation. */
+static void radio_awake(bool awake)
+{
+    if (awake && !s_ps_set) {
+        if (esp_wifi_get_ps(&s_ps_before) == ESP_OK && s_ps_before != WIFI_PS_NONE) {
+            esp_err_t err = esp_wifi_set_ps(WIFI_PS_NONE);
+            s_ps_set = err == ESP_OK;
+            ESP_LOGI(TAG, "Wi-Fi power saving off for the conversation%s", s_ps_set ? "" : " (refused: Bluetooth is on)");
+        }
+    } else if (!awake && s_ps_set) {
+        esp_wifi_set_ps(s_ps_before);
+        s_ps_set = false;
+    }
+}
+
+/* What the screen says when the live voice can't be reached, or is lost mid-conversation. */
+static const char *fail_reason(bool lost)
+{
+    bool gemini = atomic_load(&s_prov) == LIVE_GEMINI;
+    return lost ? (gemini ? "LOST GEMINI" : "LOST XAI") : (gemini ? "CAN'T REACH GEMINI" : "CAN'T REACH XAI");
+}
+
+static void fail(const char *why)
+{
+    ESP_LOGW(TAG, "%s", why);
+    muse_ws_close(s_ws);
+    radio_awake(false);
+    forget();
+    set_why(why);
+    atomic_store(&s_state, MUSE_LIVE_FAILED);
+}
+
+static void hang_up(void)
+{
+    bool talked = muse_ws_is_open(s_ws);
+    if (talked) {
+        ESP_LOGI(TAG, "conversation closed (%.1fs of mic sent)", (double)s_mic_bytes / 2 / RATE);
+    }
+    muse_ws_close(s_ws);
+    radio_awake(false);
+    forget();
+    if ((talked && profile_stale()) || s_profile_due_us) {
+        s_profile_due_us = now_us() + PROFILE_QUIET_US;   /* a new conversation before then puts it off again */
+    }
+}
+
+static bool connect(void)
+{
+    for (int waited = 0; !muse_wifi_connected() && waited < WIFI_WAIT_MS; waited += 100) {
+        vTaskDelay(pdMS_TO_TICKS(100));
+    }
+    if (!muse_wifi_connected()) {
+        fail("NO WI-FI");
+        return false;
+    }
+    bool gemini = atomic_load(&s_prov) == LIVE_GEMINI;
+    if (!(gemini ? muse_gemini_tts_key(s_key, sizeof(s_key)) : muse_xai_tts_key(s_key, sizeof(s_key)))) {
+        fail(muse_live_no_key());
+        return false;
+    }
+    radio_awake(true);
+    int status;
+    bool ok;
+    if (gemini) {
+        /* Gemini takes its key in the URL, not a header: the path is wiped after, like the key. */
+        static char path[sizeof(GEMINI_PATH) + KEY_MAX];
+        snprintf(path, sizeof(path), "%s%s", GEMINI_PATH, s_key);
+        ok = muse_ws_open(s_ws, GEMINI_HOST, path, NULL, &status);
+        memset(path, 0, sizeof(path));
+        gemini_reset();
+    } else {
+        ok = muse_ws_open(s_ws, HOST, PATH, s_key, &status);
+    }
+    memset(s_key, 0, sizeof(s_key));
+    if (!ok) {
+        fail(status == 401 || status == 403 || status == 400 ? (gemini ? "GEMINI KEY REFUSED" : "XAI KEY REFUSED")
+                                                           : fail_reason(false));
+        return false;
+    }
+    ESP_LOGI(TAG, "live voice: %s", PROV_NAME(gemini));
+    set_clock();
+    muse_wifi_status_t w;
+    muse_wifi_status(&w);
+    ESP_LOGI(TAG, "Wi-Fi %d dBm", w.rssi);
+    s_setup_t0 = s_mic_sent_us = now_us();
+    s_mic_bytes = 0;
+    s_mic_peak = 0;
+    s_mic_sq = 0;
+    s_mic_n = s_mic_clipped = 0;
+    s_mic_dropped = 0;
+    s_mic_prev = 0;
+    s_mic_log_us = s_setup_t0;
+    s_events = 0;
+    if (!configure()) {
+        fail(fail_reason(false));
+        return false;
+    }
+    return true;
+}
+
+/* Takes out what's markup, not words: a tool call the model wrote out
+ * ("<ask_muse>...</ask_muse>", all of it) and any other <tag>. An unclosed
+ * one at the end, and all after it, is cut (the rest hasn't come). For a copy
+ * of the text: returns the new length. */
+static size_t strip_markup(char *s)
+{
+    size_t o = 0;
+    for (size_t i = 0; s[i];) {
+        if (s[i] != '<') {
+            s[o++] = s[i++];
+            continue;
+        }
+        char *close = strchr(s + i, '>');
+        if (!close) {
+            break;   /* the tag isn't all here yet */
+        }
+        if (!strncmp(s + i, "<ask_muse", 9) || !strncmp(s + i, "<set_mood", 9) || !strncmp(s + i, "<do_trick", 9)) {
+            char end[24];
+            snprintf(end, sizeof(end), "</%.*s>", 8, s + i + 1);
+            char *e = strstr(close, end);
+            if (!e) {
+                break;   /* its closing tag isn't here yet */
+            }
+            close = e + strlen(end) - 1;
+        }
+        i = close - s + 1;
+    }
+    s[o] = '\0';
+    return o;
+}
+
+/* The last `lines` lines of `text`'s first `len` bytes, wrapped at `cols`
+ * letters by words, into out (lines joined by '\n'). */
+static void tail_lines(const char *text, size_t len, int cols, int lines, char *out, size_t cap)
+{
+    size_t starts[64];
+    int n = 0;
+    size_t line = 0;
+    while (line < len && n < 64) {
+        starts[n++] = line;
+        size_t end = line + (size_t)cols;
+        if (end >= len) {
+            break;
+        }
+        size_t cut = end;
+        while (cut > line && text[cut] != ' ') {
+            cut--;
+        }
+        line = cut > line ? cut + 1 : end;   /* a word longer than the line is cut */
+    }
+    size_t from = n > lines ? starts[n - lines] : 0;
+    size_t o = 0;
+    for (int i = n > lines ? n - lines : 0; i < n && o + 1 < cap; i++) {
+        size_t a = starts[i], b = i + 1 < n ? starts[i + 1] : len;
+        while (b > a && text[b - 1] == ' ') {
+            b--;
+        }
+        if (o) {
+            out[o++] = '\n';
+        }
+        size_t k = b - a < cap - 1 - o ? b - a : cap - 1 - o;
+        memcpy(out + o, text + a, k);
+        o += k;
+    }
+    (void)from;
+    out[o] = '\0';
+}
+
+/* Moves the caption on with the reply's audio: as far into the words as the
+ * audio played is into what's come (a guess at the speaking rate for Muse's
+ * answer until its audio has all come), the last few lines up to there. */
+static void caption_tick(void)
+{
+    if (!s_cap.on) {
+        return;
+    }
+    s_cap.rx = s_rx + (uint32_t)(s_pend ? s_pend_len - s_pend_off : 0) - s_cap.base;
+    if (!r.active || !r.audio) {
+        s_cap.done = true;
+    }
+    uint32_t played = atomic_load(&s_played) - s_cap.base;
+    if ((int32_t)played < 0) {
+        played = 0;
+    }
+    EXT_RAM_BSS_ATTR static char clean[OUT_TEXT_MAX > ANSWER_MAX ? OUT_TEXT_MAX : ANSWER_MAX];   /* 16 KB: PSRAM */
+    strlcpy(clean, s_cap.text, sizeof(clean));
+    size_t len = strip_markup(clean);
+    const char *text = clean;
+    size_t at;
+    if (s_cap.muse && !s_cap.done) {
+        at = (size_t)played / 2 * CAP_MUSE_CPS / RATE;
+    } else {
+        at = s_cap.rx ? (size_t)((uint64_t)len * (played < s_cap.rx ? played : s_cap.rx) / s_cap.rx) : 0;
+    }
+    at = at < len ? at : len;
+    while (at < len && at && text[at - 1] != ' ') {
+        at++;   /* to the end of the word being said */
+    }
+    if (!atomic_load(&s_playing)) {
+        /* Only while it's heard: after, the screen has gone back to listening, and the words
+         * would land in the status line and stay there. */
+        if (s_cap.done && played >= s_cap.rx) {
+            s_cap.on = false;
+        }
+        return;
+    }
+    if ((int)at != s_cap.shown) {
+        s_cap.shown = (int)at;
+        int cols, lines;
+        muse_state_page(false, &cols, &lines);
+        tail_lines(text, at, cols > 4 ? cols - 1 : 20, lines > 0 ? lines : 3, s_page, sizeof(s_page));
+        if (s_page[0]) {
+            muse_state_set_caption("%s", s_page);
+        }
+    }
+    if (s_cap.done && played >= s_cap.rx) {
+        s_cap.on = false;   /* all said */
+    }
+}
+
+/* The voice loop stopped coming round: say where, once. */
+static void watch_voice(void)
+{
+    static int64_t told;
+    int64_t beat = atomic_load(&s_beat_us);
+    if (beat && now_us() - beat > STALL_US && told != beat) {
+        told = beat;
+        ESP_LOGE(TAG, "the voice loop has been stuck for %.1fs at step %d", (now_us() - beat) / 1e6,
+                 atomic_load(&s_beat_at));
+    }
+}
+
+/* Gemini sometimes ends its turn on a tool's result without saying it: one short
+ * text turn then gets it said. Only then, or after SAY_NUDGE_US of nothing at all from it:
+ * a new turn while it's still working on the answer (a long one, a slow link) interrupts it. */
+static void gemini_nudge(void)
+{
+    int64_t quiet_since = s_gemini_heard_us > s_said_us ? s_gemini_heard_us : s_said_us;
+    if (atomic_load(&s_prov) != LIVE_GEMINI || !s_say_next || s_nudged || r.active ||
+        (!s_say_unsaid && now_us() - quiet_since < SAY_NUDGE_US)) {
+        return;
+    }
+    s_nudged = true;
+    ESP_LOGW(TAG, "Gemini hasn't said Muse's answer: nudging it");
+    cJSON *msg = cJSON_CreateObject();
+    cJSON *cc = cJSON_AddObjectToObject(msg, "clientContent");
+    cJSON *turn = cJSON_CreateObject();
+    cJSON_AddStringToObject(turn, "role", "user");
+    cJSON *part = cJSON_CreateObject();
+    cJSON_AddStringToObject(part, "text", "Go ahead: tell me what you found, word for word.");
+    cJSON_AddItemToArray(cJSON_AddArrayToObject(turn, "parts"), part);
+    cJSON_AddItemToArray(cJSON_AddArrayToObject(cc, "turns"), turn);
+    cJSON_AddBoolToObject(cc, "turnComplete", true);
+    send_json(msg);
+}
+
+static void publish(void)
+{
+    watch_voice();
+    if (atomic_load(&s_state) == MUSE_LIVE_READY && muse_ws_is_open(s_ws)) {
+        gemini_nudge();
+    }
+    if (s_end_pending && now_us() - s_end_called_us > END_AFTER_CALL_US && !r.active && !s_pend) {
+        s_end_pending = false;   /* it said all it was going to */
+        atomic_store(&s_ending, true);
+    }
+    caption_tick();
+    /* Muse's answer being read: it can take a while to start (a long answer), and the
+     * conversation mustn't close before it's said. */
+    if (s_awaiting && now_us() - s_await_us > (s_say_next ? SAY_WAIT_US : AWAIT_US)) {
+        ESP_LOGW(TAG, "no response came");
+        s_awaiting = s_say_next = false;
+    }
+    /* ...and however it stopped being awaited (a turn ended unsaid, an error, a barge-in), an
+     * answer never begun is given up: it would hold the conversation open for good. */
+    if (s_say_next && !r.active && now_us() - s_said_us > SAY_WAIT_US) {
+        ESP_LOGW(TAG, "Muse's answer was never said");
+        s_say_next = s_say_unsaid = s_awaiting = false;
+    }
+    atomic_store(&s_answering, s_awaiting || r.active || s_pend);
+    atomic_store(&s_mic_waiting, s_mic && xStreamBufferBytesAvailable(s_mic) > MIC_SEND);
+    /* Muse's: asked, answered and waiting, or being read out. */
+    atomic_store(&s_museing, (s_ask.active && !s_ask.profile) || s_deliver.pending || s_say_next ||
+                                 (r.active && r.from_muse));
+}
+
+static void task(void *arg)
+{
+    (void)arg;
+    uint32_t session = 0;
+    for (;;) {
+        uint32_t want = atomic_load(&s_session);
+        if (want != session) {
+            hang_up();
+            session = want;
+        }
+        if (!atomic_load(&s_want)) {
+            /* Between conversations: the profile question, if it's due. */
+            if (atomic_exchange(&s_warm, false) && muse_wifi_connected() &&
+                (!s_warmed_us || now_us() - s_warmed_us > WARM_AGAIN_US)) {
+                s_warmed_us = now_us();
+                load_provider();
+                muse_ws_warm(s_ws, atomic_load(&s_prov_next) == LIVE_GEMINI ? GEMINI_HOST : HOST);
+            }
+            if (s_profile_due_us && now_us() > s_profile_due_us && muse_wifi_connected()) {
+                s_profile_due_us = 0;
+                ask_profile();
+            }
+            if (s_ask.active) {
+                muse_frames();
+            }
+            publish();
+            ulTaskNotifyTake(pdTRUE, s_ask.active ? pdMS_TO_TICKS(100) : s_profile_due_us ? pdMS_TO_TICKS(1000)
+                                                                                        : portMAX_DELAY);
+            continue;
+        }
+        int state = atomic_load(&s_state);
+        if (state == MUSE_LIVE_FAILED) {
+            publish();
+            ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(1000));
+            continue;
+        }
+        if (!muse_ws_is_open(s_ws)) {
+            if (state == MUSE_LIVE_CONNECTING) {
+                connect();
+            } else {
+                fail(fail_reason(true));   /* a send failed: the conversation's context is gone with it */
+            }
+            continue;
+        }
+        if (state == MUSE_LIVE_CONNECTING && now_us() - s_setup_t0 > SETUP_US) {
+            fail(fail_reason(false));
+            continue;
+        }
+        char *typed = atomic_load(&s_state) == MUSE_LIVE_READY ? atomic_exchange(&s_typed, NULL) : NULL;
+        if (typed && atomic_load(&s_prov) == LIVE_GEMINI) {
+            ESP_LOGI(TAG, "typed: \"%.200s\"", typed);
+            gemini_typed(typed);
+            free(typed);
+            typed = NULL;
+        }
+        if (typed) {
+            cJSON *msg = cJSON_CreateObject();
+            cJSON_AddStringToObject(msg, "type", "conversation.item.create");
+            cJSON *item = cJSON_AddObjectToObject(msg, "item");
+            cJSON_AddStringToObject(item, "type", "message");
+            cJSON_AddStringToObject(item, "role", "user");
+            cJSON *part = cJSON_CreateObject();
+            cJSON_AddStringToObject(part, "type", "input_text");
+            cJSON_AddStringToObject(part, "text", typed);
+            cJSON_AddItemToArray(cJSON_AddArrayToObject(item, "content"), part);
+            ESP_LOGI(TAG, "typed: \"%.200s\"", typed);
+            send_json(msg);
+            create_response();
+        }
+        free(typed);
+        if (atomic_exchange(&s_stop, false)) {
+            /* A click isn't something xAI's voice detection hears: its reply must be cancelled
+             * there, or it goes on and the next question waits behind it. */
+            if (atomic_load(&s_prov) == LIVE_XAI && r.active && !r.cancelled) {
+                send_raw("{\"type\":\"response.cancel\"}");
+            }
+            barge_in("you clicked");   /* drops the rest if it's still coming, else only what's queued */
+        }
+        if (atomic_exchange(&s_discard, false)) {
+            if (atomic_load(&s_prov) == LIVE_XAI) {
+                send_raw("{\"type\":\"input_audio_buffer.clear\"}");   /* a noise, not you: not a turn */
+            }
+        }
+        drain_pending();
+        for (int i = 0; i < READS_PER_TICK && !s_pend; i++) {
+            int n = muse_ws_poll(s_ws);
+            if (n <= 0) {
+                break;
+            }
+        }
+        if (!muse_ws_is_open(s_ws)) {
+            fail(fail_reason(true));
+            continue;
+        }
+        if (atomic_load(&s_state) == MUSE_LIVE_READY) {
+            send_mic();
+            muse_frames();
+            deliver();
+        }
+        publish();
+        vTaskDelay(pdMS_TO_TICKS(POLL_MS));
+    }
+}
+
+/* --- API ------------------------------------------------------------------------------------------ */
+
+static bool ensure_task(void)
+{
+    if (s_task) {
+        return true;
+    }
+    s_ws = muse_ws_new(TAG, MSG_MAX, on_text, on_binary, NULL);
+    s_mic = xStreamBufferCreateWithCaps(MIC_BUF, 1, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    s_muse_q = xQueueCreate(MUSE_QUEUE, sizeof(muse_item_t));
+    s_ask.texts = heap_caps_malloc(MUSE_MSGS * MUSE_MSG_MAX, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    s_deliver.text = heap_caps_malloc(ANSWER_MAX, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!s_ws || !s_mic || !s_muse_q || !s_ask.texts || !s_deliver.text ||
+        /* On the network's core, and below the animation's decoder (4): a TLS handshake or a burst of
+         * reply audio would otherwise starve it, and frames would stall. It only waits on the network. */
+        xTaskCreatePinnedToCoreWithCaps(task, "muse_live", STACK, NULL, 3, &s_task, MUSE_AUDIO_CORE ? 0 : tskNO_AFFINITY,
+                                        MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        ESP_LOGE(TAG, "can't start the live voice task");
+        s_task = NULL;
+        return false;
+    }
+    muse_hatch_set_console_sink(console_sink);
+    return true;
+}
+
+bool muse_live_configured(void)
+{
+    load_provider();
+    return atomic_load(&s_prov_next) == LIVE_GEMINI ? muse_gemini_tts_configured() : muse_xai_tts_configured();
+}
+
+const char *muse_live_no_key(void)
+{
+    return atomic_load(&s_prov_next) == LIVE_GEMINI ? "SET A GEMINI KEY" : "SET AN XAI KEY";
+}
+
+bool muse_live_open(StreamBufferHandle_t speaker)
+{
+    if (!muse_live_configured() || !ensure_task()) {
+        return false;
+    }
+    muse_xai_tts_close();   /* one xAI connection at a time */
+    atomic_store(&s_prov, atomic_load(&s_prov_next));
+    s_speaker = speaker;
+    xStreamBufferReset(s_mic);
+    atomic_store(&s_discard, false);
+    atomic_store(&s_ending, false);
+    s_end_pending = false;
+    atomic_store(&s_playing, false);
+    s_why[0] = '\0';
+    atomic_store(&s_state, MUSE_LIVE_CONNECTING);
+    atomic_store(&s_want, true);
+    atomic_fetch_add(&s_session, 1);
+    xTaskNotifyGive(s_task);
+    return true;
+}
+
+void muse_live_close(void)
+{
+    if (!s_task) {
+        return;
+    }
+    atomic_store(&s_want, false);
+    atomic_store(&s_state, MUSE_LIVE_OFF);
+    atomic_fetch_add(&s_session, 1);
+    xTaskNotifyGive(s_task);
+}
+
+bool muse_live_active(void)
+{
+    return atomic_load(&s_want);
+}
+
+void muse_live_status(muse_live_status_t *st, char *why, size_t cap)
+{
+    st->state = (muse_live_state_t)atomic_load(&s_state);
+    st->you = atomic_load(&s_you);
+    st->answering = atomic_load(&s_answering);
+    st->muse = atomic_load(&s_museing);
+    st->who = (muse_responder_t)atomic_load(&s_who);
+    st->voice = atomic_load(&s_prov) == LIVE_GEMINI ? MUSE_RESPONDER_GEMINI : MUSE_RESPONDER_GROK;
+    st->flushes = atomic_load(&s_flushes);
+    st->mic_waiting = atomic_load(&s_mic_waiting);
+    st->ending = atomic_load(&s_ending);
+    if (why) {
+        strlcpy(why, s_why, cap);
+    }
+}
+
+bool muse_live_injecting(void)
+{
+    int64_t at = atomic_load(&s_inject_us);
+    return at && esp_timer_get_time() - at < INJECT_HOLD_US;
+}
+
+void muse_live_mic(const int16_t *pcm, size_t frames)
+{
+    /* Whole chunks or nothing: a part-chunk would leave the stream a byte out, and every sample after it noise. */
+    if (s_mic && atomic_load(&s_want) && xStreamBufferSpacesAvailable(s_mic) >= frames * sizeof(int16_t)) {
+        xStreamBufferSend(s_mic, pcm, frames * sizeof(int16_t), 0);
+    }
+}
+
+void muse_live_warm(void)
+{
+    if (!muse_live_configured() || !ensure_task()) {
+        return;
+    }
+    atomic_store(&s_warm, true);
+    xTaskNotifyGive(s_task);
+}
+
+void muse_live_stop_reply(void)
+{
+    atomic_store(&s_stop, true);
+}
+
+void muse_live_discard_mic(void)
+{
+    atomic_store(&s_discard, true);
+}
+
+void muse_live_set_playing(bool playing)
+{
+    atomic_store(&s_playing, playing);
+}
+
+void muse_live_played(size_t bytes)
+{
+    atomic_fetch_add(&s_played, (uint32_t)bytes);
+}
+
+void muse_live_beat(int where)
+{
+    atomic_store(&s_beat_at, where);
+    atomic_store(&s_beat_us, where ? esp_timer_get_time() : 0);
+}
diff --git a/esp32/components/muse/muse_live.h b/esp32/components/muse/muse_live.h
new file mode 100644
index 0000000..abc2128
--- /dev/null
+++ b/esp32/components/muse/muse_live.h
@@ -0,0 +1,122 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "freertos/FreeRTOS.h"
+#include "freertos/stream_buffer.h"
+#include "muse_state.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * A spoken conversation with xAI's live voice (wss://api.x.ai/v1/realtime,
+ * Grok Voice), for the length of a hands-free conversation (live_talk boards,
+ * muse_voice.c). The voice task streams the mic in and plays what comes back;
+ * this module's task keeps the WebSocket. xAI's voice detection ends each of
+ * your turns and Grok answers small talk itself; anything personal (projects,
+ * plans, tasks, calendar, notes) it hands to Muse with its ask_muse tool, as a
+ * typed Muse turn (muse_hatch_text_turn), and Muse's answer is then read out
+ * word for word in the same voice. The protocol is the live-voice prototype's
+ * (prototype/live-voice/orchestrator.js on the live-voice-prototype branch).
+ *
+ * The API key is xAI's speech key (">xai_key=..." over serial, muse_xai_tts.h).
+ */
+
+typedef enum {
+    MUSE_LIVE_OFF,          /* not open */
+    MUSE_LIVE_CONNECTING,   /* connecting, or setting the session up */
+    MUSE_LIVE_READY,        /* talking */
+    MUSE_LIVE_FAILED,       /* couldn't connect, or the connection went: see `why` */
+} muse_live_state_t;
+
+/* What's going on, for the voice task's screen and quiet timer. */
+typedef struct {
+    muse_live_state_t state;
+    bool you;           /* xAI hears you talking */
+    bool answering;     /* a response asked for or under way */
+    bool muse;          /* Muse is working on a question, or its answer waits to be said */
+    muse_responder_t who;   /* whose words the response under way is */
+    muse_responder_t voice; /* the live voice itself: Grok or Gemini */
+    uint32_t flushes;   /* bumped whenever the speaker's queued audio is to be dropped */
+    bool mic_waiting;   /* mic audio still to go out (connecting, or a slow network): you may be talking */
+    bool ending;        /* the voice ended the conversation (end_conversation): close after its goodbye */
+} muse_live_status_t;
+
+/* Whose live voice: MUSE_RESPONDER_GROK (xAI, the default) or MUSE_RESPONDER_GEMINI, kept in NVS. */
+muse_responder_t muse_live_voice(void);
+
+/* Chooses it (settings' Voice page, ">live_provider="): from the next conversation, an
+ * open one keeps its own. False if it couldn't be stored. */
+bool muse_live_set_voice(muse_responder_t voice);
+
+/* The provider's key is stored (muse_live_no_key() says which, if not). */
+bool muse_live_configured(void);
+
+/* What to say when it isn't: "SET AN XAI KEY" or "SET A GEMINI KEY". */
+const char *muse_live_no_key(void);
+
+/*
+ * What Grok knows about you before asking Muse anything: a short profile (name,
+ * city, people, projects, how you like answers) with your timezone, kept in
+ * NVS. After a conversation, if it's missing or a day old, the watch asks Muse
+ * for it again, quietly, and Grok gets it, with the local date and time, at
+ * the start of each conversation.
+ *
+ * Also ">live_provider=xai" or ">live_provider=gemini": whose live voice
+ * (Gemini Live, gemini-3.1-flash-live-preview, costs about a sixth as much a
+ * minute; xAI reads Muse's answers word for word, Gemini says them).
+ *
+ * Console hook for ">profile=TEXT" (yours, typed: never replaced from Muse;
+ * a first line "TZ: <POSIX TZ>" sets the timezone), ">profile=" (cleared: back
+ * to asking Muse) and ">profile?" (prints it). The line without its '>'.
+ */
+bool muse_live_console_command(const char *line);
+
+/* Opens a conversation: connects in the background, and from then on puts the
+ * reply audio (16 kHz mono PCM) into `speaker`. False if there's no key. */
+bool muse_live_open(StreamBufferHandle_t speaker);
+
+/* Ends it: what's under way is dropped, a question out to Muse too. */
+void muse_live_close(void);
+
+/* Readies the next conversation's connection (a TLS handshake whose session it
+ * resumes), from waking or a press: no live session, so nothing billed. */
+void muse_live_warm(void);
+
+/* A conversation is open or opening. */
+bool muse_live_active(void);
+
+void muse_live_status(muse_live_status_t *st, char *why, size_t cap);
+
+/* The mic, 16 kHz mono, to stream to xAI once the session is set up (it keeps
+ * up to 2 s while connecting). Never waits; what doesn't fit is dropped. */
+void muse_live_mic(const int16_t *pcm, size_t frames);
+
+/* Test audio is being fed in over serial (">mic=..."): the real mic is held back. */
+bool muse_live_injecting(void);
+
+/* A click while it speaks: the reply is stopped and dropped, the conversation goes on. */
+void muse_live_stop_reply(void);
+
+/* The watch heard something over the reply (muse_echo.c) and streamed it, but
+ * xAI's voice detection didn't take it for speech: that audio is thrown away. */
+void muse_live_discard_mic(void);
+
+/* Reply audio taken from `speaker` (played, or dropped by a barge-in), in bytes:
+ * the caption follows it. */
+void muse_live_played(size_t bytes);
+
+/* The voice task is playing reply audio: Muse's answer waits until it isn't. */
+void muse_live_set_playing(bool playing);
+
+/* The voice task's loop is at step `where`: if it stops calling this for 2 s,
+ * the live task logs the last step (the board has no watchdog to say so). */
+void muse_live_beat(int where);
+
+#ifdef __cplusplus
+}
+#endif
