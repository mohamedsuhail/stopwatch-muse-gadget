+/* --- the profile and the clock -------------------------------------------------------- */
+
+static time_t clock_now(void);
+
+static void load_profile(void)
+{
+    if (s_profile_loaded) {
+        return;
+    }
+    s_profile_loaded = true;
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READONLY, &h) != ESP_OK) {
+        return;
+    }
+    size_t n = sizeof(s_profile);
+    if (nvs_get_str(h, "profile", s_profile, &n) != ESP_OK) {
+        s_profile[0] = '\0';
+    }
+    n = sizeof(s_tz);
+    if (nvs_get_str(h, "tz", s_tz, &n) != ESP_OK) {
+        s_tz[0] = '\0';
+    }
+    n = sizeof(s_place);
+    if (nvs_get_str(h, "place", s_place, &n) != ESP_OK) {
+        s_place[0] = '\0';
+    }
+    nvs_get_u32(h, "profile_at", &s_profile_at);
+    nvs_get_u8(h, "typed", &s_profile_typed);
+    nvs_close(h);
+}
+
+static bool save_profile(void)
+{
+    nvs_handle_t h;
+    esp_err_t err = nvs_open(NVS_NS, NVS_READWRITE, &h);
+    if (err == ESP_OK) {
+        err = nvs_set_str(h, "profile", s_profile);
+        err = err ?: nvs_set_str(h, "tz", s_tz);
+        err = err ?: nvs_set_str(h, "place", s_place);
+        err = err ?: nvs_set_u32(h, "profile_at", s_profile_at);
+        err = err ?: nvs_set_u8(h, "typed", s_profile_typed);
+        err = err ?: nvs_commit(h);
+        nvs_close(h);
+    }
+    if (err != ESP_OK) {
+        ESP_LOGW(TAG, "couldn't keep the profile: %s", esp_err_to_name(err));
+    }
+    return err == ESP_OK;
+}
+
+/* Takes "TZ: ..." off the front of `text` into s_tz (if there), and the rest,
+ * trimmed, as the profile. Call with s_profile_lock held. */
+/* "KEY: value" at the start of `text` into out; returns past its line, or NULL if it isn't that key. */
+static const char *take_line(const char *text, const char *key, char *out, size_t cap)
+{
+    size_t k = strlen(key);
+    if (strncasecmp(text, key, k)) {
+        return NULL;
+    }
+    const char *v = text + k + strspn(text + k, " ");
+    size_t n = strcspn(v, "\n");
+    n = n < cap - 1 ? n : cap - 1;
+    memcpy(out, v, n);
+    out[n] = '\0';
+    while (n && out[n - 1] == ' ') {
+        out[--n] = '\0';
+    }
+    v += strcspn(v, "\n");
+    return v + strspn(v, " \n");
+}
+
+static void set_profile(const char *text)
+{
+    text += strspn(text, " \n");
+    for (const char *next; (next = take_line(text, "TZ:", s_tz, sizeof(s_tz))) ||
+                           (next = take_line(text, "PLACE:", s_place, sizeof(s_place)));) {
+        text = next;
+    }
+    strlcpy(s_profile, text, sizeof(s_profile));
+    size_t n = strlen(s_profile);
+    while (n && (s_profile[n - 1] == ' ' || s_profile[n - 1] == '\n')) {
+        s_profile[--n] = '\0';
+    }
+}
+
+static void load_provider(void)
+{
+    if (s_prov_loaded) {
+        return;
+    }
+    s_prov_loaded = true;
+    nvs_handle_t h;
+    uint8_t p = LIVE_XAI;
+    if (nvs_open(NVS_NS, NVS_READONLY, &h) == ESP_OK) {
+        nvs_get_u8(h, "provider", &p);
+        nvs_close(h);
+    }
+    atomic_store(&s_prov, p == LIVE_GEMINI ? LIVE_GEMINI : LIVE_XAI);
+    atomic_store(&s_prov_next, atomic_load(&s_prov));
+}
+
+muse_responder_t muse_live_voice(void)
+{
+    load_provider();
+    return atomic_load(&s_prov_next) == LIVE_GEMINI ? MUSE_RESPONDER_GEMINI : MUSE_RESPONDER_GROK;
+}
+
+bool muse_live_set_voice(muse_responder_t voice)
+{
+    int p = voice == MUSE_RESPONDER_GEMINI ? LIVE_GEMINI : LIVE_XAI;
+    load_provider();
+    atomic_store(&s_prov_next, p);   /* not the open conversation's: its protocol is set */
+    if (!atomic_load(&s_want)) {
+        atomic_store(&s_prov, p);
+    }
+    nvs_handle_t h;
+    esp_err_t err = nvs_open(NVS_NS, NVS_READWRITE, &h);
+    if (err == ESP_OK) {
+        err = nvs_set_u8(h, "provider", (uint8_t)p);
+        err = err ?: nvs_commit(h);
+        nvs_close(h);
+    }
+    ESP_LOGI(TAG, "live voice: %s, from the next conversation", PROV_NAME(p));
+    return err == ESP_OK;
+}
+
+bool muse_live_console_command(const char *line)
+{
+    if (strcmp(line, "live_provider?") == 0) {
+        printf("@live_provider %s\n", muse_live_voice() == MUSE_RESPONDER_GEMINI ? "gemini" : "xai");
+        fflush(stdout);
+        return true;
+    }
+    if (strncmp(line, "live_provider=", 14) == 0) {
+        const char *v = line + 14;
+        if (strcmp(v, "gemini") && strcmp(v, "xai")) {
+            printf("@live_provider error (xai or gemini)\n");
+            fflush(stdout);
+            return true;
+        }
+        bool ok = muse_live_set_voice(!strcmp(v, "gemini") ? MUSE_RESPONDER_GEMINI : MUSE_RESPONDER_GROK);
+        printf(ok ? "@live_provider ok\n" : "@live_provider error storage\n");
+        fflush(stdout);
+        return true;
+    }
+    if (strncmp(line, "mic=", 4) == 0) {
+        /* For testing speech end to end: 16 kHz mono PCM, base64, fed where the mic goes. */
+        static uint8_t pcm[1024];
+        size_t n = 0;
+        if (mbedtls_base64_decode(pcm, sizeof(pcm), &n, (const unsigned char *)line + 4, strlen(line + 4)) == 0 && n >= 2) {
+            atomic_store(&s_inject_us, esp_timer_get_time());
+            if (s_mic && atomic_load(&s_want) && xStreamBufferSpacesAvailable(s_mic) >= (n & ~(size_t)1)) {
+                xStreamBufferSend(s_mic, pcm, n & ~(size_t)1, 0);
+            }
+        }
+        return true;   /* quietly: 50 lines a second */
+    }
+    if (strncmp(line, "live_ask=", 9) == 0) {
+        /* For testing without talking: as if you'd said it, in the open conversation. */
+        char *q = strdup(line + 9);
+        free(atomic_exchange(&s_typed, q));
+        printf(atomic_load(&s_want) ? "@live_ask ok\n" : "@live_ask no conversation\n");
+        fflush(stdout);
+        return true;
+    }
+    if (strcmp(line, "profile!") == 0) {
+        /* Ask Muse for it again, two quiet minutes after now: the old one (and its place) stays
+         * in use until the new one comes. Not over one you typed, which Muse never replaces. */
+        load_profile();
+        if (s_profile_typed) {
+            printf("@profile yours: >profile= clears it, then Muse is asked\n");
+            fflush(stdout);
+            return true;
+        }
+        s_profile_due_us = esp_timer_get_time() + PROFILE_QUIET_US;
+        if (s_task) {
+            xTaskNotifyGive(s_task);
+        }
+        printf("@profile refresh due\n");
+        fflush(stdout);
+        return true;
+    }
+    if (strcmp(line, "profile?") == 0) {
+        load_profile();
+        taskENTER_CRITICAL(&s_profile_lock);
+        char tz[TZ_MAX];
+        strlcpy(tz, s_tz, sizeof(tz));
+        taskEXIT_CRITICAL(&s_profile_lock);
+        printf("@profile tz=%s place=%s typed=%d at=%lu\n", tz[0] ? tz : "(none)", s_place[0] ? s_place : "(none)",
+               s_profile_typed, (unsigned long)s_profile_at);
+        muse_hatch_console("profile", s_profile[0] ? s_profile : "(none)", NULL);
+        return true;
+    }
+    if (strncmp(line, "profile=", 8) != 0) {
+        return false;
+    }
+    load_profile();
+    char *text = strdup(line + 8);
+    if (!text) {
+        return true;
+    }
+    muse_hatch_unescape(text);   /* \n for new lines */
+    taskENTER_CRITICAL(&s_profile_lock);
+    if (text[0]) {
+        set_profile(text);
+        s_profile_typed = 1;
+    } else {
+        s_profile[0] = s_tz[0] = s_place[0] = '\0';
+        s_profile_typed = 0;
+    }
+    s_profile_at = (uint32_t)clock_now();
+    taskEXIT_CRITICAL(&s_profile_lock);
+    free(text);
+    bool ok = save_profile();
+    ESP_LOGI(TAG, "%s", !ok ? "profile not kept" : s_profile_typed ? "profile set over serial; Muse won't replace it"
+                        : "profile cleared; Muse will be asked after the next conversation");
+    printf(ok ? "@profile ok\n" : "@profile error storage\n");
+    fflush(stdout);
+    return true;
+}
+
+/* "Thu, 23 Oct 2026 22:15:03 GMT" to seconds since 1970, or 0. */
+static time_t http_date(const char *s)
+{
+    static const char MONTHS[] = "JanFebMarAprMayJunJulAugSepOctNovDec";
+    char mon[4];
+    int day, year, h, m, sec;
+    if (sscanf(s, "%*3s, %d %3s %d %d:%d:%d", &day, mon, &year, &h, &m, &sec) != 6) {
+        return 0;
+    }
+    const char *at = strstr(MONTHS, mon);
+    if (!at || (at - MONTHS) % 3) {
+        return 0;
+    }
+    int month = (int)(at - MONTHS) / 3 + 1;
+    /* Days from 1970-01-01 to the date (Howard Hinnant's days_from_civil). */
+    int y = year - (month <= 2);
+    int era = y / 400;
+    int yoe = y - era * 400;
+    int doy = (153 * (month + (month > 2 ? -3 : 9)) + 2) / 5 + day - 1;
+    int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    long days = (long)era * 146097 + doe - 719468;
+    return (time_t)days * 86400 + h * 3600 + m * 60 + sec;
+}
+
+/* The watch has no clock of its own: xAI's Date header says what time it is,
+ * kept as an offset from the uptime timer. The system clock is left alone:
+ * the rest of the firmware counts on it never jumping. */
+static int64_t s_clock_offset;   /* seconds since 1970 minus uptime seconds; 0 until a Date header */
+
+static void set_clock(void)
+{
+    time_t t = http_date(muse_ws_date(s_ws));
+    if (t > CLOCK_SET_AFTER) {
+        s_clock_offset = (int64_t)t - now_us() / 1000000;
+    }
+}
+
+static time_t clock_now(void)
+{
+    return s_clock_offset ? (time_t)(s_clock_offset + now_us() / 1000000) : 0;
+}
+
+/* "Thursday 23 October 2026, 3:42 pm" in the profile's timezone (UTC without one), or "" with no clock. */
+static void local_now(char *out, size_t cap, bool *utc)
+{
+    time_t t = clock_now();
+    out[0] = '\0';
+    if (t < CLOCK_SET_AFTER) {
+        return;
+    }
+    taskENTER_CRITICAL(&s_profile_lock);
+    char tz[TZ_MAX];
+    strlcpy(tz, s_tz[0] ? s_tz : "UTC0", sizeof(tz));
+    taskEXIT_CRITICAL(&s_profile_lock);
+    *utc = !strcmp(tz, "UTC0");
+    setenv("TZ", tz, 1);
+    tzset();
+    struct tm tm;
+    localtime_r(&t, &tm);
+    strftime(out, cap, "%A %d %B %Y, %I:%M %p", &tm);
+}
+
+/* What Grok is told on top of its instructions: the profile, and when it is. */
+static size_t about_you(char *out, size_t cap)
+{
+    load_profile();
+    char now[64];
+    bool utc = false;
+    local_now(now, sizeof(now), &utc);
+    size_t n = 0;
+    taskENTER_CRITICAL(&s_profile_lock);
+    if (s_profile[0]) {
+        n += snprintf(out + n, cap - n,
+                      "\nWhat you know about the user, a summary from Muse: it may be out of date, so ask Muse "
+                      "about anything personal it doesn't cover or that may have changed, and anything live of "
+                      "theirs like their calendar, tasks or messages.\n%s", s_profile);
+    }
+    char place[PLACE_MAX];
+    strlcpy(place, s_place, sizeof(place));
+    taskEXIT_CRITICAL(&s_profile_lock);
+    if (place[0] && n < cap) {
+        n += snprintf(out + n, cap - n,
+                      "\nThe user is in %s. For the weather, the time and anything local, it's there unless they "
+                      "name another place: never ask where they are.", place);
+    }
+    if (now[0] && n < cap) {
+        n += snprintf(out + n, cap - n, "\nIt is %s%s.", now, utc ? " UTC (their timezone isn't known)" : ", their local time");
+    }
+    return n < cap ? n : cap - 1;
+}
+
+/* After a conversation: is the profile missing, or old enough to ask Muse for again? */
+static bool profile_stale(void)
+{
+    load_profile();
+    if (s_profile_typed) {
+        return false;
+    }
+    if (!s_profile[0] || !s_place[0]) {
+        return true;   /* none yet, or from before the place was asked for */
+    }
+    uint32_t now = (uint32_t)clock_now();
+    return now > CLOCK_SET_AFTER && (s_profile_at < CLOCK_SET_AFTER || now - s_profile_at > PROFILE_AGE_S);
+}
+
+static void profile_answer(const char *answer)
+{
+    if (s_profile_typed) {
+        ESP_LOGI(TAG, "profile from Muse not used: yours was typed in");
+        return;
+    }
+    char *clean = strdup(answer);
+    if (!clean) {
+        return;
+    }
+    muse_hatch_strip_tags(clean, clean, strlen(clean) + 1, NULL);   /* no faces or speech tags in it */
+    taskENTER_CRITICAL(&s_profile_lock);
+    char was_tz[TZ_MAX], was_place[PLACE_MAX];
+    strlcpy(was_tz, s_tz, sizeof(was_tz));
+    strlcpy(was_place, s_place, sizeof(was_place));
+    s_tz[0] = s_place[0] = '\0';
+    set_profile(clean);
+    if (!s_tz[0]) {
+        strlcpy(s_tz, was_tz, sizeof(s_tz));
+    }
+    if (!s_place[0]) {
+        strlcpy(s_place, was_place, sizeof(s_place));
+    }
+    size_t n = strlen(s_profile);
+    s_profile_at = (uint32_t)clock_now();
+    taskEXIT_CRITICAL(&s_profile_lock);
+    free(clean);
+    if (n < 20) {
+        ESP_LOGW(TAG, "Muse's profile was too short to keep (%u chars)", (unsigned)n);
+        return;
+    }
+    save_profile();
+    ESP_LOGI(TAG, "profile from Muse kept (%u chars, TZ %s, place %s)", (unsigned)n, s_tz[0] ? s_tz : "unknown",
+             s_place[0] ? s_place : "unknown");
