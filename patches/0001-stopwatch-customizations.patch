+/* A small speaker's chain (CONFIG_MUSE_SPEAKER_BOOST_DB): a low cut (it can't play a voice's
+ * lows, which only eat the headroom and push the limiter), the boost, then a look-ahead
+ * limiter. One that jumped its gain to each peak, a sample at a time, crackled on loud words;
+ * this one sees LOOK samples ahead, so the gain eases down before a peak and back over 100 ms. */
+#if CONFIG_MUSE_SPEAKER_BOOST_DB
+#define BOOST ((float)pow(10.0, CONFIG_MUSE_SPEAKER_BOOST_DB / 20.0))
+#define LIMIT (0.891f * 32767.0f)                         /* -1 dBFS */
+#define LOW_CUT_HZ 250.0f                                 /* 2nd-order Butterworth */
+#define LOOK (MUSE_AUDIO_RATE * 3 / 1000)                 /* 3 ms */
+#define RELEASE_S 0.1f
+#define GAP_US 100000                                     /* writes this far apart: a new sound, from silence */
+static float s_lc_b0, s_lc_b1, s_lc_a1, s_lc_a2;          /* the low cut's coefficients (b2 = b0)... */
+static float s_lc_x1, s_lc_x2, s_lc_y1, s_lc_y2;          /* ...and state */
+static float s_look[LOOK];                                /* boosted, waiting to go out */
+static size_t s_look_i;
+static float s_gain = 1, s_gain_min = 1;                  /* s_gain_min: since muse_audio_take_limiting() */
+static float s_attack, s_release;                         /* a sample's share of the way to the new gain */
+static int64_t s_wrote_us;
+
+/* One sample through the chain; it comes out LOOK samples later. */
+static inline float speaker_chain(float x)
+{
+    float y = s_lc_b0 * (x + s_lc_x2) + s_lc_b1 * s_lc_x1 - s_lc_a1 * s_lc_y1 - s_lc_a2 * s_lc_y2;
+    s_lc_x2 = s_lc_x1;
+    s_lc_x1 = x;
+    s_lc_y2 = s_lc_y1;
+    s_lc_y1 = y;
+    float out = s_look[s_look_i];
+    s_look[s_look_i] = y * BOOST;
+    s_look_i = (s_look_i + 1) % LOOK;
+    float peak = fabsf(out);   /* the loudest of it and the next LOOK samples */
+    for (size_t k = 0; k < LOOK; k++) {
+        peak = fmaxf(peak, fabsf(s_look[k]));
+    }
+    float target = peak > LIMIT ? LIMIT / peak : 1.0f;
+    s_gain += (target - s_gain) * (target < s_gain ? s_attack : s_release);
+    s_gain_min = fminf(s_gain_min, s_gain);
+    return out * s_gain;
+}
