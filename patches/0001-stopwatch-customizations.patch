diff --git a/esp32/components/muse/muse_resample.c b/esp32/components/muse/muse_resample.c
new file mode 100644
index 0000000..6e472ca
--- /dev/null
+++ b/esp32/components/muse/muse_resample.c
@@ -0,0 +1,32 @@
+#include "muse_resample.h"
+
+#include <string.h>
+
+void muse_resample_init(muse_resample_t *r)
+{
+    memset(r, 0, sizeof(*r));
+}
+
+size_t muse_resample_24k_16k(muse_resample_t *r, const int16_t *in, size_t n, int16_t *out)
+{
+    size_t o = 0;
+    for (size_t i = 0; i < n; i++) {
+        /* (1 2 1)/4 low-pass, centred one sample back */
+        int32_t f = ((int32_t)r->in[0] + 2 * r->in[1] + in[i]) / 4;
+        r->in[0] = r->in[1];
+        r->in[1] = in[i];
+        r->hist[0] = r->hist[1];
+        r->hist[1] = (int16_t)f;
+        if (++r->seen < 2) {
+            continue;
+        }
+        /* Outputs fall every 1.5 inputs: at phase 0 on a sample, at phase 3 (out of 6) halfway between. */
+        while (r->phase < 6) {
+            int32_t a = r->hist[0], b = r->hist[1];
+            out[o++] = (int16_t)(a + (b - a) * (int32_t)r->phase / 6);
+            r->phase += 9;   /* 1.5 inputs, in sixths */
+        }
+        r->phase -= 6;
+    }
+    return o;
+}
diff --git a/esp32/components/muse/muse_resample.h b/esp32/components/muse/muse_resample.h
new file mode 100644
index 0000000..a11b1eb
--- /dev/null
+++ b/esp32/components/muse/muse_resample.h
@@ -0,0 +1,24 @@
+/*
+ * 24 kHz to 16 kHz, for speech that comes at 24 kHz (Gemini's live voice) and
+ * a speaker that plays 16 kHz. Every three samples in make two out: a short
+ * low-pass first (what's over 8 kHz would fold back as hiss), then linear
+ * interpolation at the new spacing. It keeps two samples between calls, so a
+ * stream can be fed in pieces of any length.
+ */
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+    int16_t hist[2];   /* the last two filtered inputs */
+    int16_t in[2];     /* the last two raw inputs, for the filter */
+    uint32_t phase;    /* where the next output falls past hist[0], in sixths of an input sample */
+    size_t seen;       /* inputs so far */
+} muse_resample_t;
+
+void muse_resample_init(muse_resample_t *r);
+
+/* Converts `n` 24 kHz samples; writes up to 2n/3 + 2 16 kHz samples to `out`
+ * and returns how many. */
+size_t muse_resample_24k_16k(muse_resample_t *r, const int16_t *in, size_t n, int16_t *out);
