+/* Each tick: blows the bubble up when someone starts answering (their logo swapped in when
+ * Muse takes over), and bursts it once nobody has been answering for BUBBLE_DONE_S. */
+static void bubble_tick(muse_responder_t who, float now)
+{
+    static float none_since = -1;
+    if (who != MUSE_RESPONDER_NONE) {
+        none_since = -1;
+        if (who != s_logo_shown) {
+            lv_image_set_src(s_logo, logo_of(who));
+            if (s_logo_shown == MUSE_RESPONDER_NONE) {
+                s_blow_t0 = now;   /* afresh, or again over a burst */
+                s_burst_t0 = -1;
+                bubble_drops_hide();
+                lv_obj_remove_flag(s_bubble, LV_OBJ_FLAG_HIDDEN);
+            }
+            s_logo_shown = who;
+        }
+    } else if (s_logo_shown != MUSE_RESPONDER_NONE) {
+        none_since = none_since < 0 ? now : none_since;
+        if (now - none_since >= BUBBLE_DONE_S) {
+            s_logo_shown = MUSE_RESPONDER_NONE;
+            s_burst_t0 = now;
+            s_blow_t0 = -1;
+            lv_obj_add_flag(s_logo, LV_OBJ_FLAG_HIDDEN);   /* the pop: the logo goes at once */
+        }
+    }
+    if (s_blow_t0 >= 0) {
+        float p = (now - s_blow_t0) / BUBBLE_BLOW_S;
+        if (p >= 1) {
+            p = 1;
+            s_blow_t0 = -1;
+        }
+        float e = 1 - (1 - p) * (1 - p);   /* easing out */
+        bubble_look(0.4f + 0.6f * e, e);
+        lv_obj_set_flag(s_logo, LV_OBJ_FLAG_HIDDEN, p < 0.5f);
+    } else if (s_burst_t0 >= 0) {
+        float p = (now - s_burst_t0) / BUBBLE_BURST_S;
+        bool over = p >= 1;
+        if (over) {
+            s_burst_t0 = -1;
+            lv_obj_add_flag(s_bubble, LV_OBJ_FLAG_HIDDEN);
+            bubble_drops_hide();
+            return;
+        }
+        bubble_look(1 + 0.5f * p, 1 - p);
+        float r = BUBBLE_PX / 2 * (1 + 0.5f * p) + BUBBLE_DROP_FLY * p;
+        for (int i = 0; i < BUBBLE_DROPS; i++) {
+            float t = 2 * (float)M_PI * i / BUBBLE_DROPS + 0.3f;
+            lv_obj_set_pos(s_drops[i], s_bubble_cx + (int)(r * cosf(t)) - BUBBLE_DROP_PX / 2,
+                           s_bubble_cy + (int)(r * sinf(t)) - BUBBLE_DROP_PX / 2);
+            lv_obj_set_style_bg_opa(s_drops[i], (lv_opa_t)(LV_OPA_COVER * (1 - p)), 0);
+            lv_obj_remove_flag(s_drops[i], LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+}
