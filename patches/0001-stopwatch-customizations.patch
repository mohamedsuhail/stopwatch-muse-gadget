+"""muse_resample.c, Gemini's 24 kHz speech to the speaker's 16 kHz."""
+import os
+from pathlib import Path
+import shlex
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+MUSE = ROOT / 'components/muse'
+
+HARNESS = r'''
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "muse_resample.h"
+
+#define N 24000   /* 1 s */
+
+static int16_t in[N], whole[N], parts[N];
+
+static void tone(double hz, double amp)
+{
+    for (int i = 0; i < N; i++) in[i] = (int16_t)(amp * sin(2 * M_PI * hz * i / 24000.0));
+}
+
+/* Its level at `hz` by correlation, after the first 100 samples. */
+static double level(const int16_t *x, size_t n, double hz)
+{
+    double s = 0, c = 0;
+    for (size_t i = 100; i < n; i++) {
+        s += x[i] * sin(2 * M_PI * hz * i / 16000.0);
+        c += x[i] * cos(2 * M_PI * hz * i / 16000.0);
+    }
+    return 2 * sqrt(s * s + c * c) / (n - 100);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    muse_resample_t r;
+    switch (atoi(argv[1])) {
+    case 0: {   /* 3 in, 2 out; a 1 kHz tone stays 1 kHz at nearly its level */
+        tone(1000, 10000);
+        muse_resample_init(&r);
+        size_t n = muse_resample_24k_16k(&r, in, N, whole);
+        assert(n >= 15990 && n <= 16000);
+        double l = level(whole, n, 1000);
+        fprintf(stderr, "1 kHz level %.0f\n", l);
+        assert(l > 9000 && l < 10100);
+        break;
+    }
+    case 1: {   /* in pieces of any size: the same samples as all at once */
+        tone(440, 8000);
+        muse_resample_init(&r);
+        size_t n = muse_resample_24k_16k(&r, in, N, whole);
+        muse_resample_init(&r);
+        size_t m = 0;
+        for (size_t i = 0, k = 1; i < N; k = k % 997 + 7) {
+            size_t take = i + k < N ? k : N - i;
+            m += muse_resample_24k_16k(&r, in + i, take, parts + m);
+            i += take;
+        }
+        assert(m == n);
+        for (size_t i = 0; i < n; i++) assert(parts[i] == whole[i]);
+        break;
+    }
+    case 2: {   /* 11 kHz (over 16 kHz's 8 kHz limit) is cut well down, not folded back loud */
+        tone(11000, 10000);
+        muse_resample_init(&r);
+        size_t n = muse_resample_24k_16k(&r, in, N, whole);
+        double alias = level(whole, n, 5000);   /* 11 kHz folds to 16 - 11 = 5 kHz */
+        fprintf(stderr, "alias %.0f\n", alias);
+        assert(alias < 3000);
+        break;
+    }
+    }
+    return 0;
+}
+'''
+
+
+class MuseResample(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cc = shlex.split(os.environ.get('CC', 'cc'))
+        if not shutil.which(cc[0]):
+            raise unittest.SkipTest('C compiler unavailable')
+        cls.tmp = tempfile.TemporaryDirectory()
+        cls.addClassCleanup(cls.tmp.cleanup)
+        src = Path(cls.tmp.name) / 'resample_test.c'
+        src.write_text(HARNESS)
+        cls.binary = Path(cls.tmp.name) / 'resample_test'
+        subprocess.run([*cc, '-std=gnu11', '-Wall', '-Wextra', '-Werror', '-I', str(MUSE),
+                        str(src), str(MUSE / 'muse_resample.c'), '-lm', '-o', str(cls.binary)], check=True)
+
+    def run_case(self, case):
+        ran = subprocess.run([str(self.binary), str(case)], capture_output=True, text=True)
+        self.assertEqual(ran.returncode, 0, ran.stderr)
+
+    def test_a_tone_keeps_its_pitch_and_level(self): self.run_case(0)
+    def test_pieces_give_the_same_samples_as_the_whole(self): self.run_case(1)
+    def test_what_is_over_8_khz_is_cut_down(self): self.run_case(2)
+
+
+if __name__ == '__main__':
+    unittest.main()
