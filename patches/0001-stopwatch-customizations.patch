         for (size_t i = 0; i < n; i++) {
-            s_out_stereo[2 * i] = mute ? 0 : mono[i];
-            s_out_stereo[2 * i + 1] = mute ? 0 : mono[i];
+            int16_t v = mute ? 0 : mono[i];
+#if CONFIG_MUSE_SPEAKER_BOOST_DB
+            float x = v * BOOST;
+            float a = fabsf(x);
+            s_env = a > s_env ? a : LIMIT + (s_env - LIMIT) * RELEASE;
+            s_env_max = s_env > s_env_max ? s_env : s_env_max;
+            v = (int16_t)(x * (LIMIT / s_env));
