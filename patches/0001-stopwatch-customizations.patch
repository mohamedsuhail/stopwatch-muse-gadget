diff --git a/esp32/components/muse/muse_vad.c b/esp32/components/muse/muse_vad.c
new file mode 100644
index 0000000..a57d2ad
--- /dev/null
+++ b/esp32/components/muse/muse_vad.c
@@ -0,0 +1,75 @@
+#include "muse_vad.h"
+
+#define FLOOR_START_DB -60.0f   /* until it has heard the room */
+#define FLOOR_RISE_DB 0.1f      /* per chunk under speech: 5 dB a second, to follow a room getting louder */
+
+void muse_vad_init(muse_vad_t *v, unsigned quiet_ms)
+{
+    *v = (muse_vad_t){
+        .floor_db = FLOOR_START_DB,
+        .quiet_limit = quiet_ms / MUSE_VAD_CHUNK_MS,
+        .state = MUSE_VAD_WAITING,
+    };
+}
+
+/* How loud speech is over this floor. */
+static float speech_db(const muse_vad_t *v)
+{
+    float db = v->floor_db + MUSE_VAD_SPEECH_DB;
+    return db < MUSE_VAD_MIN_SPEECH_DB ? MUSE_VAD_MIN_SPEECH_DB : db;
+}
+
+/* The floor follows the quietest chunks down at once and anything short of
+ * speech up slowly, so speech never moves it but a fan coming on (or a first
+ * guess too low) is learnt within seconds. */
+static void learn(muse_vad_t *v, float db)
+{
+    if (db < v->floor_db) {
+        v->floor_db = db;
+    } else if (db < speech_db(v)) {
+        v->floor_db += FLOOR_RISE_DB;
+    }
+}
+
+void muse_vad_hear_room(muse_vad_t *v, float db)
+{
+    if (v->chunks == 0 && v->floor_db == FLOOR_START_DB) {
+        v->floor_db = db;   /* the first chunk heard is the best guess there is */
+    } else {
+        learn(v, db);
+    }
+}
+
+muse_vad_state_t muse_vad_feed(muse_vad_t *v, float db)
+{
+    if (v->state == MUSE_VAD_DONE || v->state == MUSE_VAD_NOTHING) {
+        return v->state;
+    }
+    v->chunks++;
+    bool loud = db >= speech_db(v);
+    bool quiet = db < v->floor_db + MUSE_VAD_SILENCE_DB;
+    if (!loud) {
+        learn(v, db);
+    }
+    if (v->state == MUSE_VAD_WAITING) {
+        v->onset = loud ? v->onset + 1 : 0;
+        if (v->onset >= MUSE_VAD_ONSET_CHUNKS) {
+            v->state = MUSE_VAD_SPEAKING;
+            v->quiet = 0;
+        } else if (v->chunks >= v->quiet_limit) {
+            v->state = MUSE_VAD_NOTHING;
+        }
+        return v->state;
+    }
+    /* Speaking: in between quiet and loud (a soft syllable, a breath) doesn't
+     * end the turn, but doesn't count against the quiet either. */
+    if (quiet) {
+        v->quiet++;
+    } else if (loud) {
+        v->quiet = 0;
+    }
+    if (v->quiet * MUSE_VAD_CHUNK_MS >= MUSE_VAD_END_MS) {
+        v->state = MUSE_VAD_DONE;
+    }
+    return v->state;
+}
