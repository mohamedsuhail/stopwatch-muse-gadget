         .use_mclk = true,
-        .hw_gain = { .pa_voltage = 5.0, .codec_dac_voltage = 3.3 },
+        /* esp_codec_dev takes 20*log10(dac/pa) + pa_gain off the volume's dB; 3.3/5.0 would
+         * put volume 100 at +3.5 dB in the DAC (0xC6), hard-clipping peaks above -3.5 dBFS.
+         * Equal voltages keep volume 100 at 0 dB (0xBF); the extra loudness comes from
+         * muse_audio_write()'s limiter (CONFIG_MUSE_SPEAKER_BOOST_DB) instead. */
+        .hw_gain = { .pa_voltage = 3.3, .codec_dac_voltage = 3.3 },
