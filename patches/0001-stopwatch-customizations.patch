+            quiet_since = now;
+            if (now - poked > 1000000) {
+                poked = now;
+                muse_state_poke();   /* no auto-sleep while a conversation's going on */
+            }
+        } else if (now - quiet_since > (replied ? CONVERSATION_QUIET_MS : FIRST_QUIET_MS) * 1000LL) {
