@@ -0,0 +1,128 @@
+"""muse_vad.c, the end of a hands-free turn, fed levels as the voice task would (one per 20 ms chunk)."""
+import os
+from pathlib import Path
+import shlex
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+MUSE = ROOT / 'components/muse'
+
+HARNESS = r'''
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "muse_vad.h"
+
+/* Feeds `n` chunks at `db`; returns the chunk (counted from 1) where the state became `want`, or 0. */
+static size_t feed(muse_vad_t *v, size_t n, float db, muse_vad_state_t want)
+{
+    for (size_t i = 0; i < n; i++) {
+        if (muse_vad_feed(v, db) == want) return v->chunks;
+    }
+    return 0;
+}
+
+/* Speech with the dips between words: 200 ms loud, 100 ms soft, repeated. */
+static void speak(muse_vad_t *v, float loud, float soft, int words)
+{
+    for (int w = 0; w < words; w++) {
+        for (int i = 0; i < 10; i++) assert(muse_vad_feed(v, loud) != MUSE_VAD_DONE);
+        for (int i = 0; i < 5; i++) assert(muse_vad_feed(v, soft) != MUSE_VAD_DONE);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    muse_vad_t v;
+    switch (atoi(argv[1])) {
+    case 0: {   /* speech, then quiet: done 0.9 s into the quiet, not before */
+        muse_vad_init(&v, 6000);
+        for (int i = 0; i < 16; i++) muse_vad_hear_room(&v, -55);   /* the 320 ms pre-roll */
+        assert(feed(&v, 10, -55, MUSE_VAD_SPEAKING) == 0);
+        speak(&v, -25, -40, 8);   /* 2.4 s of words, with soft dips between them */
+        assert(v.state == MUSE_VAD_SPEAKING);
+        size_t start = v.chunks;
+        size_t done = feed(&v, 100, -55, MUSE_VAD_DONE);
+        assert(done == start + 900 / MUSE_VAD_CHUNK_MS);
+        break;
+    }
+    case 1: {   /* nobody speaks: nothing, exactly at the quiet limit */
+        muse_vad_init(&v, 8000);
+        for (int i = 0; i < 16; i++) muse_vad_hear_room(&v, -56);
+        assert(feed(&v, 1000, -55, MUSE_VAD_NOTHING) == 8000 / MUSE_VAD_CHUNK_MS);
+        assert(muse_vad_feed(&v, -20) == MUSE_VAD_NOTHING);   /* and it stays over */
+        break;
+    }
+    case 2: {   /* a loud fan: never speech on its own, and speech over it still ends */
+        muse_vad_init(&v, 3000);
+        for (int i = 0; i < 16; i++) muse_vad_hear_room(&v, -40);
+        assert(feed(&v, 100, -38, MUSE_VAD_SPEAKING) == 0);
+        speak(&v, -18, -30, 4);
+        assert(v.state == MUSE_VAD_SPEAKING);
+        assert(feed(&v, 100, -39, MUSE_VAD_DONE) != 0);
+        break;
+    }
+    case 3: {   /* the room louder than the first guess: the floor rises to it, so the turn still ends */
+        muse_vad_init(&v, 6000);
+        muse_vad_hear_room(&v, -62);   /* one quiet chunk before a noisier room */
+        assert(feed(&v, 60, -50, MUSE_VAD_SPEAKING) == 0);   /* -50 isn't speech, only louder room */
+        speak(&v, -24, -38, 4);
+        assert(v.state == MUSE_VAD_SPEAKING);
+        assert(feed(&v, 200, -50, MUSE_VAD_DONE) != 0);
+        break;
+    }
+    case 4: {   /* a single click or bump isn't speech: three chunks in a row are */
+        muse_vad_init(&v, 6000);
+        for (int i = 0; i < 16; i++) muse_vad_hear_room(&v, -55);
+        assert(muse_vad_feed(&v, -15) == MUSE_VAD_WAITING);
+        assert(muse_vad_feed(&v, -55) == MUSE_VAD_WAITING);
+        assert(muse_vad_feed(&v, -15) == MUSE_VAD_WAITING);
+        assert(muse_vad_feed(&v, -15) == MUSE_VAD_WAITING);
+        assert(muse_vad_feed(&v, -15) == MUSE_VAD_SPEAKING);
+        break;
+    }
+    case 5: {   /* a dead-quiet room: speech must still reach MUSE_VAD_MIN_SPEECH_DB */
+        muse_vad_init(&v, 2000);
+        for (int i = 0; i < 16; i++) muse_vad_hear_room(&v, -80);
+        assert(feed(&v, 20, -60, MUSE_VAD_SPEAKING) == 0);   /* 20 dB over the floor, but faint */
+        assert(feed(&v, 5, MUSE_VAD_MIN_SPEECH_DB, MUSE_VAD_SPEAKING) != 0);
+        break;
+    }
+    }
+    return 0;
+}
+'''
+
+
+class MuseVad(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cc = shlex.split(os.environ.get('CC', 'cc'))
+        if not shutil.which(cc[0]):
+            raise unittest.SkipTest('C compiler unavailable')
+        cls.tmp = tempfile.TemporaryDirectory()
+        cls.addClassCleanup(cls.tmp.cleanup)
+        src = Path(cls.tmp.name) / 'vad_test.c'
+        src.write_text(HARNESS)
+        cls.binary = Path(cls.tmp.name) / 'vad_test'
+        subprocess.run([*cc, '-std=gnu11', '-Wall', '-Wextra', '-Werror', '-I', str(MUSE),
+                        str(src), str(MUSE / 'muse_vad.c'), '-o', str(cls.binary)], check=True)
+
+    def run_case(self, case):
+        ran = subprocess.run([str(self.binary), str(case)], capture_output=True, text=True)
+        self.assertEqual(ran.returncode, 0, ran.stderr)
+
+    def test_speech_then_quiet_ends_after_the_quiet_time(self): self.run_case(0)
+    def test_nobody_speaks_gives_up_at_the_limit(self): self.run_case(1)
+    def test_loud_fan_is_not_speech_and_speech_over_it_ends(self): self.run_case(2)
+    def test_floor_rises_to_a_louder_room(self): self.run_case(3)
+    def test_a_click_is_not_speech(self): self.run_case(4)
+    def test_faint_sound_in_a_silent_room_is_not_speech(self): self.run_case(5)
+
+
+if __name__ == '__main__':
+    unittest.main()
