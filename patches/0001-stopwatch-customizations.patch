+/* The session: who Grok is, its tools, xAI's voice detection, and 16 kHz PCM both ways. */
+static bool configure(void)
+{
+    if (atomic_load(&s_prov) == LIVE_GEMINI) {
+        return gemini_configure();
+    }
+    static const char *MOODS[] = { "joy", "thinking", "sad", "goodnight", NULL };
+    size_t n = sizeof(PERSONA) + sizeof(INSTRUCTIONS) + PROFILE_MAX + 512;
+    char *instructions = heap_caps_malloc(n, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!instructions) {
+        return false;
+    }
+    size_t o = snprintf(instructions, n, "%s%s", PERSONA, INSTRUCTIONS);
+    about_you(instructions + o, n - o);
+    cJSON *msg = cJSON_CreateObject();
+    cJSON_AddStringToObject(msg, "type", "session.update");
+    cJSON *s = cJSON_AddObjectToObject(msg, "session");
+    cJSON_AddStringToObject(s, "voice", VOICE);
+    cJSON_AddStringToObject(s, "instructions", instructions);
+    free(instructions);
+    cJSON_AddStringToObject(cJSON_AddObjectToObject(s, "turn_detection"), "type", "server_vad");
+    /* reasoning.effort stays at xAI's default (high): with "none" the model says its
+     * tool calls out loud ("<ask_muse>...</ask_muse>") instead of making them. */
+    cJSON *audio = cJSON_AddObjectToObject(s, "audio");
+    /* In as 8 kHz mu-law (to_ulaw()), out as 16 kHz PCM, the speaker's own; both as
+     * binary frames, which spares base64 (a third more bytes) and JSON both ways. */
+    cJSON *in = cJSON_AddObjectToObject(audio, "input");
+    cJSON_AddStringToObject(cJSON_AddObjectToObject(in, "format"), "type", "audio/pcmu");
+    cJSON_AddStringToObject(in, "transport", "binary");
+    cJSON *heard = cJSON_AddObjectToObject(in, "transcription");
+    cJSON_AddStringToObject(heard, "language_hint", "en");
+    cJSON *terms = cJSON_AddArrayToObject(heard, "keyterms");
+    static const char *TERMS[] = { "Muse", "Mobot", "Grok", "Bumblebop" };
+    for (size_t i = 0; i < sizeof(TERMS) / sizeof(TERMS[0]); i++) {
+        cJSON_AddItemToArray(terms, cJSON_CreateString(TERMS[i]));
+    }
+    cJSON *out = cJSON_AddObjectToObject(audio, "output");
+    cJSON *fmt = cJSON_AddObjectToObject(out, "format");
+    cJSON_AddStringToObject(fmt, "type", "audio/pcm");
+    cJSON_AddNumberToObject(fmt, "rate", RATE);
+    cJSON_AddStringToObject(out, "transport", "binary");
+    cJSON *tools = cJSON_AddArrayToObject(s, "tools");
+    cJSON_AddItemToArray(tools, tool("ask_muse", ASK_MUSE_DESC, "question",
+                                     "The question or request, self-contained, in the user's words.", NULL));
+    cJSON_AddItemToArray(tools, tool("set_mood", "Show a mood on the user's screen (it never needs mentioning).",
+                                     "mood", NULL, MOODS));
+    cJSON_AddItemToArray(tools, tool("do_trick", TRICK_DESC, "trick", NULL, TRICKS));
+    cJSON_AddItemToArray(tools, tool("end_conversation", END_DESC, "reason", "A few words on why.", NULL));
+    /* xAI's own web search, run on its side, near the user if the profile says where they are. */
+    cJSON *search = cJSON_CreateObject();
+    cJSON_AddStringToObject(search, "type", "web_search");
+    char place[PLACE_MAX];
+    taskENTER_CRITICAL(&s_profile_lock);
+    strlcpy(place, s_place, sizeof(place));
+    taskEXIT_CRITICAL(&s_profile_lock);
+    if (place[0]) {
+        /* "City, Region, CC" */
+        cJSON *loc = cJSON_AddObjectToObject(search, "location");
+        static const char *KEYS[] = { "city", "region", "country" };
+        char *save = NULL;
+        int k = 0;
+        for (char *part = strtok_r(place, ",", &save); part && k < 3; part = strtok_r(NULL, ",", &save), k++) {
+            cJSON_AddStringToObject(loc, KEYS[k], part + strspn(part, " "));
+        }
+    }
+    cJSON_AddItemToArray(tools, search);
+    return send_json(msg);
+}
