+        }
+    }
+    muse_live_beat(0);
+    muse_state_poke();   /* the screen's sleep counts from the end of the conversation, not its start */
+    muse_live_close();
+    drain_speaker();
+    muse_state_set_level(0);
+    muse_state_set_responder(MUSE_RESPONDER_NONE);
+    muse_state_set_waiting(false);
+    pre_reset();
+    if (end[0]) {
+        ESP_LOGW(TAG, "live conversation: ended (%s)", end);
+    }
+    go_idle(end);
+}
+#endif
