diff --git a/esp32/components/muse/muse_ws.c b/esp32/components/muse/muse_ws.c
new file mode 100644
index 0000000..3eecb99
--- /dev/null
+++ b/esp32/components/muse/muse_ws.c
@@ -0,0 +1,517 @@
+#include "muse_ws.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include "esp_crt_bundle.h"
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_random.h"
+#include "esp_timer.h"
+#include "esp_tls.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "lwip/sockets.h"
+#include "lwip/tcp.h"
+#include "mbedtls/base64.h"
+
+#define RX_BUF 4096
+#define HDR_LINE_MAX 1024
+#define HEAD_MAX 1024
+#define ERR_MAX 400
+#define IO_TIMEOUT_US (20 * 1000000LL)
+#define CONNECT_TIMEOUT_MS 10000
+#define TX_BUF 8192             /* a frame is masked into this and written whole: one TLS record, not one per 512 bytes */
+
+/* WebSocket opcodes (RFC 6455). */
+#define WS_CONT 0x0
+#define WS_TEXT 0x1
+#define WS_BINARY 0x2
+#define WS_CLOSE 0x8
+#define WS_PING 0x9
+#define WS_PONG 0xA
+
+struct muse_ws {
+    const char *tag;
+    muse_ws_on_text_t on_text;
+    muse_ws_on_binary_t on_binary;
+    void *ctx;
+    esp_tls_t *tls;
+    esp_tls_client_session_t *ticket;   /* resumes the TLS session on reconnect */
+    struct {
+        uint8_t buf[RX_BUF];
+        size_t pos, len;
+    } rx;
+    /* Incoming frames, a byte at a time, so reading never has to block. */
+    struct {
+        enum { F_HDR0, F_HDR1, F_EXTLEN, F_MASK, F_PAYLOAD } st;
+        uint8_t op, msg_op;
+        bool fin, masked;
+        uint8_t ext_need, ext_got, mask[4], mask_got;
+        uint64_t len, got;
+        uint8_t ctl[125];                 /* a control frame's payload */
+        bool overflow;                    /* the message outgrew msg_max */
+    } f;
+    char date[40];                        /* the upgrade's Date header */
+    uint8_t *tx;                          /* TX_BUF, PSRAM */
+    char *msg;                            /* msg_max: a whole text message */
+    size_t msg_len, msg_max;
+};
+
+static inline int64_t now_us(void)
+{
+    return esp_timer_get_time();
+}
+
+muse_ws_t *muse_ws_new(const char *tag, size_t msg_max, muse_ws_on_text_t on_text, muse_ws_on_binary_t on_binary,
+                       void *ctx)
+{
+    muse_ws_t *ws = heap_caps_calloc(1, sizeof(*ws), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    char *msg = heap_caps_malloc(msg_max, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    uint8_t *tx = heap_caps_malloc(TX_BUF, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!ws || !msg || !tx) {
+        free(ws);
+        free(msg);
+        free(tx);
+        return NULL;
+    }
+    ws->tx = tx;
+    ws->tag = tag;
+    ws->on_text = on_text;
+    ws->on_binary = on_binary;
+    ws->ctx = ctx;
+    ws->msg = msg;
+    ws->msg_max = msg_max;
+    return ws;
+}
+
+const char *muse_ws_date(const muse_ws_t *ws)
+{
+    return ws->date;
+}
+
+bool muse_ws_is_open(const muse_ws_t *ws)
+{
+    return ws->tls != NULL;
+}
+
+void muse_ws_close(muse_ws_t *ws)
+{
+    if (ws->tls) {
+        esp_tls_conn_destroy(ws->tls);
+        ws->tls = NULL;
+    }
+    ws->rx.pos = ws->rx.len = 0;
+    ws->f.st = F_HDR0;
+    ws->msg_len = 0;
+}
+
+static bool conn_write(muse_ws_t *ws, const uint8_t *data, size_t len)
+{
+    int64_t deadline = now_us() + IO_TIMEOUT_US;
+    while (len) {
+        ssize_t n = esp_tls_conn_write(ws->tls, data, len);
+        if (n > 0) {
+            data += n;
+            len -= n;
+        } else if (n == ESP_TLS_ERR_SSL_WANT_READ || n == ESP_TLS_ERR_SSL_WANT_WRITE) {
+            if (now_us() > deadline) {
+                return false;
+            }
+            vTaskDelay(1);
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* Next byte, waiting for it: 1 ok, 0 closed, -1 error or timeout. Only for the upgrade response. */
+static int rx_byte_wait(muse_ws_t *ws, uint8_t *c)
+{
+    if (ws->rx.pos < ws->rx.len) {
+        *c = ws->rx.buf[ws->rx.pos++];
+        return 1;
+    }
+    int64_t deadline = now_us() + IO_TIMEOUT_US;
+    for (;;) {
+        ssize_t n = esp_tls_conn_read(ws->tls, ws->rx.buf, sizeof(ws->rx.buf));
+        if (n > 0) {
+            ws->rx.pos = 0;
+            ws->rx.len = n;
+            *c = ws->rx.buf[ws->rx.pos++];
+            return 1;
+        }
+        if (n == 0) {
+            return 0;
+        }
+        if (n != ESP_TLS_ERR_SSL_WANT_READ && n != ESP_TLS_ERR_SSL_WANT_WRITE) {
+            return -1;
+        }
+        if (now_us() > deadline) {
+            return -1;
+        }
+        vTaskDelay(pdMS_TO_TICKS(5));
+    }
+}
+
+static bool rx_line(muse_ws_t *ws, char *out, size_t cap)
+{
+    size_t n = 0;
+    for (;;) {
+        uint8_t c;
+        if (rx_byte_wait(ws, &c) != 1) {
+            return false;
+        }
+        if (c == '\n') {
+            break;
+        }
+        if (c != '\r') {
+            if (n + 1 >= cap) {
+                return false;
+            }
+            out[n++] = (char)c;
+        }
+    }
+    out[n] = '\0';
+    return true;
+}
+
+/* One client frame: always FIN, always masked (RFC 6455 5.3), sent in pieces so nothing big is allocated. */
+static bool ws_send(muse_ws_t *ws, uint8_t op, const void *data, size_t len)
+{
+    uint8_t hdr[14];
+    size_t hl = 0;
+    hdr[hl++] = 0x80 | op;
+    if (len < 126) {
+        hdr[hl++] = 0x80 | (uint8_t)len;
+    } else if (len <= 0xffff) {
+        hdr[hl++] = 0x80 | 126;
+        hdr[hl++] = (uint8_t)(len >> 8);
+        hdr[hl++] = (uint8_t)len;
+    } else {
+        hdr[hl++] = 0x80 | 127;
+        for (int i = 7; i >= 0; i--) {
+            hdr[hl++] = (uint8_t)((uint64_t)len >> (8 * i));
+        }
+    }
+    uint8_t mask[4];
+    esp_fill_random(mask, sizeof(mask));
+    memcpy(hdr + hl, mask, 4);
+    hl += 4;
+    /* The header and as much of the payload as fits, masked, in one write; the rest likewise. */
+    const uint8_t *p = data;
+    memcpy(ws->tx, hdr, hl);
+    size_t fill = hl;
+    for (size_t off = 0; off < len || fill;) {
+        size_t n = len - off < TX_BUF - fill ? len - off : TX_BUF - fill;
+        for (size_t i = 0; i < n; i++) {
+            ws->tx[fill + i] = p[off + i] ^ mask[(off + i) & 3];
+        }
+        off += n;
+        fill += n;
+        if (!conn_write(ws, ws->tx, fill)) {
+            return false;
+        }
+        fill = 0;
+    }
+    return true;
+}
+
+static bool send_frame(muse_ws_t *ws, uint8_t op, const void *data, size_t len)
+{
+    int64_t t0 = now_us();
+    bool sent = ws->tls && ws_send(ws, op, data, len);
+    int ms = (int)((now_us() - t0) / 1000);
+    if (ms > 250) {
+        ESP_LOGW(ws->tag, "sending %u bytes took %d ms", (unsigned)len, ms);
+    }
+    if (!sent) {
+        ESP_LOGW(ws->tag, "sending failed");
+        muse_ws_close(ws);
+        return false;
+    }
+    return true;
+}
+
+bool muse_ws_send_text(muse_ws_t *ws, const char *text, size_t len)
+{
+    return send_frame(ws, WS_TEXT, text, len);
+}
+
+bool muse_ws_send_binary(muse_ws_t *ws, const void *data, size_t len)
+{
+    return send_frame(ws, WS_BINARY, data, len);
+}
+
+static void on_frame(muse_ws_t *ws)
+{
+    switch (ws->f.op) {
+    case WS_PING:
+        ws_send(ws, WS_PONG, ws->f.ctl, ws->f.len < sizeof(ws->f.ctl) ? (size_t)ws->f.len : sizeof(ws->f.ctl));
+        return;
+    case WS_PONG:
+        return;
+    case WS_CLOSE: {
+        unsigned code = ws->f.len >= 2 ? (unsigned)(ws->f.ctl[0] << 8 | ws->f.ctl[1]) : 0;
+        int n = ws->f.len > 2 && ws->f.len <= sizeof(ws->f.ctl) ? (int)ws->f.len - 2 : 0;
+        ESP_LOGI(ws->tag, "the server closed the connection (%u%s%.*s)", code, n ? ": " : "", n, (const char *)ws->f.ctl + 2);
+        muse_ws_close(ws);
+        return;
+    }
+    case WS_TEXT:
+    case WS_BINARY:
+        ws->f.msg_op = ws->f.op;
+        break;
+    case WS_CONT:
+        break;
+    default:
+        return;
+    }
+    if (!ws->f.fin) {
+        return;
+    }
+    if (ws->f.overflow) {
+        ESP_LOGW(ws->tag, "message over %u bytes dropped", (unsigned)ws->msg_max);
+    } else if (ws->f.msg_op == WS_TEXT) {
+        ws->msg[ws->msg_len] = '\0';
+        ws->on_text(ws->msg, ws->msg_len, ws->ctx);
+    } else if (ws->on_binary) {
+        ws->on_binary((uint8_t *)ws->msg, ws->msg_len, ws->ctx);
+    }
+    ws->msg_len = 0;
+    ws->f.overflow = false;
+}
+
+static void payload_byte(muse_ws_t *ws, uint8_t c)
+{
+    if (ws->f.masked) {
+        c ^= ws->f.mask[ws->f.got & 3];
+    }
+    if (ws->f.op >= WS_CLOSE) {
+        if (ws->f.got < sizeof(ws->f.ctl)) {
+            ws->f.ctl[ws->f.got] = c;
+        }
+    } else if (ws->msg_len < ws->msg_max - 1) {
+        ws->msg[ws->msg_len++] = (char)c;
+    } else {
+        ws->f.overflow = true;
+    }
+    ws->f.got++;
+}
+
+/* Feeds received bytes through the frame parser; whole frames are handled as they complete. */
+static void feed(muse_ws_t *ws, const uint8_t *buf, size_t n)
+{
+    for (size_t i = 0; i < n && ws->tls; i++) {
+        uint8_t c = buf[i];
+        switch (ws->f.st) {
+        case F_HDR0:
+            ws->f.fin = c & 0x80;
+            ws->f.op = c & 0x0f;
+            ws->f.st = F_HDR1;
+            break;
+        case F_HDR1:
+            ws->f.masked = c & 0x80;
+            ws->f.len = c & 0x7f;
+            ws->f.got = 0;
+            ws->f.mask_got = 0;
+            if (ws->f.len >= 126) {
+                ws->f.ext_need = ws->f.len == 126 ? 2 : 8;
+                ws->f.ext_got = 0;
+                ws->f.len = 0;
+                ws->f.st = F_EXTLEN;
+            } else {
+                ws->f.st = ws->f.masked ? F_MASK : F_PAYLOAD;
+            }
+            break;
+        case F_EXTLEN:
+            ws->f.len = ws->f.len << 8 | c;
+            if (++ws->f.ext_got == ws->f.ext_need) {
+                ws->f.st = ws->f.masked ? F_MASK : F_PAYLOAD;
+            }
+            break;
+        case F_MASK:
+            ws->f.mask[ws->f.mask_got++] = c;
+            if (ws->f.mask_got == 4) {
+                ws->f.st = F_PAYLOAD;
+            }
+            break;
+        case F_PAYLOAD:
+            payload_byte(ws, c);
+            break;
+        }
+        if (ws->f.st == F_PAYLOAD && ws->f.got == ws->f.len) {
+            ws->f.st = F_HDR0;
+            on_frame(ws);
+        }
+    }
+}
+
+int muse_ws_poll(muse_ws_t *ws)
+{
+    if (!ws->tls) {
+        return -1;
+    }
+    ssize_t n = esp_tls_conn_read(ws->tls, ws->rx.buf, sizeof(ws->rx.buf));
+    if (n > 0) {
+        feed(ws, ws->rx.buf, n);
+        return ws->tls ? (int)n : -1;
+    }
+    if (n == ESP_TLS_ERR_SSL_WANT_READ || n == ESP_TLS_ERR_SSL_WANT_WRITE) {
+        return 0;
+    }
+    ESP_LOGW(ws->tag, "the connection dropped");
+    muse_ws_close(ws);
+    return -1;
+}
+
+bool muse_ws_warm(muse_ws_t *ws, const char *host)
+{
+    if (ws->tls) {
+        return true;   /* open: nothing to warm */
+    }
+    int64_t t0 = now_us();
+    ws->tls = esp_tls_init();
+    if (!ws->tls) {
+        return false;
+    }
+    esp_tls_cfg_t cfg = {
+        .crt_bundle_attach = esp_crt_bundle_attach,
+        .timeout_ms = CONNECT_TIMEOUT_MS,
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+        .client_session = ws->ticket,
+#endif
+    };
+    bool ok = esp_tls_conn_new_sync(host, strlen(host), 443, &cfg, ws->tls) == 1;
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+    if (ok) {
+        if (ws->ticket) {
+            esp_tls_free_client_session(ws->ticket);
+        }
+        ws->ticket = esp_tls_get_client_session(ws->tls);
+    }
+#endif
+    muse_ws_close(ws);
+    ESP_LOGI(ws->tag, "%s %s in %d ms", ok ? "warmed" : "couldn't warm", host, (int)((now_us() - t0) / 1000));
+    return ok;
+}
+
+/*
+ * Opens the TLS connection and upgrades it to a WebSocket. A refused upgrade
+ * (bad key, quota) comes back as an ordinary HTTP response, whose body says
+ * why. The server's Sec-WebSocket-Accept isn't checked: TLS already says who
+ * answered.
+ */
+bool muse_ws_open(muse_ws_t *ws, const char *host, const char *path, const char *key, int *status)
+{
+    muse_ws_close(ws);
+    *status = 0;
+    int64_t t0 = now_us();
+    ws->tls = esp_tls_init();
+    if (!ws->tls) {
+        return false;
+    }
+    esp_tls_cfg_t cfg = {
+        .crt_bundle_attach = esp_crt_bundle_attach,
+        .timeout_ms = CONNECT_TIMEOUT_MS,
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+        .client_session = ws->ticket,
+#endif
+    };
+    if (esp_tls_conn_new_sync(host, strlen(host), 443, &cfg, ws->tls) != 1) {
+        ESP_LOGW(ws->tag, "can't reach %s", host);
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+        if (ws->ticket) {
+            /* The ticket may be what was refused: the next try starts afresh. */
+            esp_tls_free_client_session(ws->ticket);
+            ws->ticket = NULL;
+        }
+#endif
+        muse_ws_close(ws);
+        return false;
+    }
+    bool resumed = ws->ticket != NULL;
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+    if (ws->ticket) {
+        esp_tls_free_client_session(ws->ticket);
+    }
+    ws->ticket = esp_tls_get_client_session(ws->tls);
+#endif
+    int fd;
+    if (esp_tls_get_conn_sockfd(ws->tls, &fd) == ESP_OK) {
+        lwip_fcntl(fd, F_SETFL, lwip_fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+        /* Small frames (the mic, every 100 ms) go now, not after the server's delayed ACK. */
+        int one = 1;
+        lwip_setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    }
+
+    uint8_t nonce[16];
+    esp_fill_random(nonce, sizeof(nonce));
+    unsigned char ws_key[32];
+    size_t ws_key_len = 0;
+    mbedtls_base64_encode(ws_key, sizeof(ws_key), &ws_key_len, nonce, sizeof(nonce));
+    ws_key[ws_key_len] = '\0';
+    char head[HEAD_MAX];
+    int hl = snprintf(head, sizeof(head),
+                      "GET %s HTTP/1.1\r\n"
+                      "Host: %s\r\n"
+                      "Upgrade: websocket\r\n"
+                      "Connection: Upgrade\r\n"
+                      "Sec-WebSocket-Key: %s\r\n"
+                      "Sec-WebSocket-Version: 13\r\n"
+                      "%s%s%s\r\n",
+                      path, host, (const char *)ws_key, key ? "Authorization: Bearer " : "", key ? key : "",
+                      key ? "\r\n" : "");
+    bool sent = hl > 0 && hl < (int)sizeof(head) && conn_write(ws, (const uint8_t *)head, hl);
+    memset(head, 0, sizeof(head));   /* it held the key */
+    char line[HDR_LINE_MAX];
+    if (!sent || !rx_line(ws, line, sizeof(line)) || sscanf(line, "HTTP/%*s %d", status) != 1) {
+        ESP_LOGW(ws->tag, "no WebSocket upgrade from %s", host);
+        muse_ws_close(ws);
+        return false;
+    }
+    long length = 0;
+    ws->date[0] = '\0';
+    for (;;) {
+        if (!rx_line(ws, line, sizeof(line))) {
+            muse_ws_close(ws);
+            return false;
+        }
+        if (!line[0]) {
+            break;
+        }
+        if (!strncasecmp(line, "content-length:", 15)) {
+            length = strtol(line + 15, NULL, 10);
+        } else if (!strncasecmp(line, "date:", 5)) {
+            strlcpy(ws->date, line + 5 + strspn(line + 5, " "), sizeof(ws->date));
+        }
+    }
+    if (*status != 101) {
+        /* The error body says why (bad key, quota); it never holds the key. */
+        char err[ERR_MAX];
+        size_t n = 0;
+        uint8_t c;
+        for (long i = 0; i < length && n < sizeof(err) - 1 && rx_byte_wait(ws, &c) == 1; i++) {
+            err[n++] = (char)c;
+        }
+        err[n] = '\0';
+        ESP_LOGW(ws->tag, "HTTP %d: %.300s", *status, err);
+        muse_ws_close(ws);
+        return false;
+    }
+    ws->f.st = F_HDR0;
+    ws->msg_len = 0;
+    ESP_LOGI(ws->tag, "connected in %d ms%s", (int)((now_us() - t0) / 1000), resumed ? " (resumed session)" : "");
+    /* Frames that came in the same read as the upgrade response. */
+    size_t left = ws->rx.len - ws->rx.pos;
+    size_t from = ws->rx.pos;
+    ws->rx.pos = ws->rx.len = 0;
+    if (left) {
+        feed(ws, ws->rx.buf + from, left);
+    }
+    return ws->tls != NULL;
+}
diff --git a/esp32/components/muse/muse_ws.h b/esp32/components/muse/muse_ws.h
new file mode 100644
index 0000000..e9b57e0
--- /dev/null
+++ b/esp32/components/muse/muse_ws.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/*
+ * A WebSocket client over TLS for one task: it connects with a Bearer key,
+ * sends text frames, and hands whole text messages to a callback as they
+ * arrive. Reads never block: the owning task polls. The same protocol code as
+ * muse_xai_tts.c's own client, for connections that live longer than a reply.
+ */
+
+typedef struct muse_ws muse_ws_t;
+
+/* A whole text message, NUL-terminated; the buffer may be changed but not kept. */
+typedef void (*muse_ws_on_text_t)(char *msg, size_t len, void *ctx);
+
+/* A whole binary message; the buffer may be changed but not kept. */
+typedef void (*muse_ws_on_binary_t)(uint8_t *data, size_t len, void *ctx);
+
+/* Its buffers go in PSRAM. `tag` names it in the log; messages over `msg_max` are
+ * dropped. Binary messages are dropped too unless `on_binary` isn't NULL. */
+muse_ws_t *muse_ws_new(const char *tag, size_t msg_max, muse_ws_on_text_t on_text, muse_ws_on_binary_t on_binary,
+                       void *ctx);
+
+/*
+ * Connects to wss://host/path with "Authorization: Bearer key" (none if key is
+ * NULL: a key in the path, then), resuming the last TLS session when it can. False if it couldn't; *status is the HTTP
+ * status of a refused upgrade (0 if it never got that far), whose body is logged.
+ */
+bool muse_ws_open(muse_ws_t *ws, const char *host, const char *path, const char *key, int *status);
+
+bool muse_ws_is_open(const muse_ws_t *ws);
+
+/* A TLS handshake with `host`, closed straight away: the session it leaves resumes
+ * on the next muse_ws_open() to that host, a full handshake quicker (~4 s to ~0.5). */
+bool muse_ws_warm(muse_ws_t *ws, const char *host);
+
+/* The server's Date header from the last upgrade ("Thu, 23 Oct 2026 22:15:03 GMT"), or "". */
+const char *muse_ws_date(const muse_ws_t *ws);
+
+/* One text frame. False (and closed) if it couldn't be sent. */
+bool muse_ws_send_text(muse_ws_t *ws, const char *text, size_t len);
+
+/* One binary frame, likewise. */
+bool muse_ws_send_binary(muse_ws_t *ws, const void *data, size_t len);
+
+/* Reads what has arrived, once (up to 4 KB), without waiting, and handles
+ * whole messages. Returns the bytes read, or -1 if the connection has closed
+ * or dropped. */
+int muse_ws_poll(muse_ws_t *ws);
+
+void muse_ws_close(muse_ws_t *ws);
diff --git a/esp32/components/muse/muse_xai_tts.c b/esp32/components/muse/muse_xai_tts.c
new file mode 100644
index 0000000..fe74792
--- /dev/null
+++ b/esp32/components/muse/muse_xai_tts.c
@@ -0,0 +1,923 @@
+#include "muse_xai_tts.h"
+
+#include <math.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include "cJSON.h"
+#include "esp_attr.h"
+#include "esp_crt_bundle.h"
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_random.h"
+#include "esp_timer.h"
+#include "esp_tls.h"
+#include "freertos/idf_additions.h"
+#include "freertos/queue.h"
+#include "freertos/task.h"
+#include "lwip/sockets.h"
+#include "mbedtls/base64.h"
+#include "muse_live.h"
+#include "muse_wifi.h"
+#include "nvs.h"
+
+static const char *TAG = "muse_xai_tts";
+
+#define HOST "api.x.ai"
+/* language=auto: Muse may answer in any language. Level 1 trades a little quality for an earlier first chunk. */
+#define PATH "/v1/tts?language=auto&voice=" VOICE "&codec=pcm&sample_rate=16000&optimize_streaming_latency=1"
+#define VOICE "iris"                     /* an unknown voice is refused at the upgrade, HTTP 400 */
+#define NVS_NS "muse_tts"                /* shared with the Gemini key */
+#define NVS_KEY "xai_key"
+#define COMMAND "xai_key="
+#define KEY_MAX 160
+#define MSG_MAX (256 * 1024)             /* one server message; its base64 audio grows it */
+#define RX_BUF 4096
+#define HDR_LINE_MAX 1024
+#define ERR_MAX 400
+#define SEND_WAIT_MS 50                  /* blocked on a full reply buffer, look for cancel this often */
+#define POLL_MS 5                        /* a reply is in flight: check the socket this often */
+#define IO_TIMEOUT_US (20 * 1000000LL)   /* waiting on audio with nothing from the server this long: give up */
+#define CONNECT_TIMEOUT_MS 10000
+#define IDLE_CLOSE_US (60 * 1000000LL)   /* an unused connection is closed after this */
+#define STALE_US (45 * 1000000LL)        /* idle longer than this: reconnect rather than trust it */
+#define QUEUE_LEN 24
+#define STACK (10 * 1024)
+#define WARM_WIFI_WAIT_MS 10000         /* waking from a nap, Wi-Fi takes a few seconds to rejoin */
+
+/* WebSocket opcodes (RFC 6455). */
+#define WS_CONT 0x0
+#define WS_TEXT 0x1
+#define WS_BINARY 0x2
+#define WS_CLOSE 0x8
+#define WS_PING 0x9
+#define WS_PONG 0xA
+
+/* --- shared state (any task) -------------------------------------------------- */
+
+static char s_key[KEY_MAX];
+static bool s_key_loaded;
+static _Atomic int s_state = MUSE_GEMINI_TTS_IDLE;
+static _Atomic uint32_t s_gen;           /* the reply being spoken; bumped by begin and cancel */
+static _Atomic uint32_t s_audio_bytes;   /* PCM handed out for the current reply */
+static StreamBufferHandle_t s_out;       /* set by begin, read by the worker */
+static QueueHandle_t s_queue;
+static TaskHandle_t s_task;
+
+typedef enum { JOB_WARM, JOB_SAY, JOB_END, JOB_CLOSE } job_type_t;
+
+typedef struct {
+    job_type_t type;
+    uint32_t gen;
+    char *text;                          /* JOB_SAY, owned by the job */
+} job_t;
+
+/* --- worker-only state ---------------------------------------------------------- */
+
+static esp_tls_t *s_tls;
+static esp_tls_client_session_t *s_ticket;   /* resumes the TLS session on reconnect */
+static int64_t s_last_use_us;
+static uint32_t s_failed_gen;                /* a reply whose key or request was refused: skip the rest */
+
+/* In PSRAM, like the rest of this client's buffers: internal RAM is what Wi-Fi and TLS run short of. */
+EXT_RAM_BSS_ATTR static struct {
+    uint8_t buf[RX_BUF];
+    size_t pos, len;
+} s_rx;
+
+/* Incoming frames, a byte at a time, so reading never has to block. */
+EXT_RAM_BSS_ATTR static struct {
+    enum { F_HDR0, F_HDR1, F_EXTLEN, F_MASK, F_PAYLOAD } st;
+    uint8_t op, msg_op;
+    bool fin, masked;
+    uint8_t ext_need, ext_got, mask[4], mask_got;
+    uint64_t len, got;
+    uint8_t ctl[125];                        /* a control frame's payload */
+    bool overflow;                           /* the message outgrew MSG_MAX */
+} f;
+
+static char *s_msg;                          /* MSG_MAX: a whole text message */
+static size_t s_msg_len;
+
+static void feed(const uint8_t *buf, size_t n);
+
+/* The reply in flight. */
+static struct {
+    uint32_t gen;
+    bool active;                             /* text has gone out for it */
+    bool ending;                             /* text.done sent: waiting on audio.done */
+    bool refused;                            /* an error event, or the upgrade refused */
+    bool reused;                             /* it went out on a kept connection */
+    int sentences;
+    size_t chars;
+    int64_t t0, first_audio_us, last_rx_us;
+    size_t pcm_bytes;
+    uint64_t pcm_sq;                         /* the speech's level, for the log */
+    int pcm_peak;
+    uint8_t odd;
+    bool have_odd;
+} r;
+
+static inline int64_t now_us(void)
+{
+    return esp_timer_get_time();
+}
+
+static inline bool cancelled(void)
+{
+    return atomic_load(&s_gen) != r.gen;
+}
+
+/* --- key ------------------------------------------------------------------------ */
+
+static void load_key(void)
+{
+    if (s_key_loaded) {
+        return;
+    }
+    s_key_loaded = true;
+    s_key[0] = '\0';
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READONLY, &h) != ESP_OK) {
+        return;
+    }
+    size_t len = sizeof(s_key);
+    if (nvs_get_str(h, NVS_KEY, s_key, &len) != ESP_OK) {
+        s_key[0] = '\0';
+    }
+    nvs_close(h);
+}
+
+bool muse_xai_tts_configured(void)
+{
+    load_key();
+    return s_key[0] != '\0';
+}
+
+static bool key_valid(const char *k)
+{
+    size_t n = strlen(k);
+    if (n < 20 || n >= KEY_MAX) {
+        return false;
+    }
+    for (size_t i = 0; i < n; i++) {
+        char c = k[i];
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+              c == '.')) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool muse_xai_tts_console_command(const char *line)
+{
+    if (strncmp(line, COMMAND, strlen(COMMAND)) != 0) {
+        return false;
+    }
+    const char *key = line + strlen(COMMAND);
+    if (key[0] && !key_valid(key)) {
+        printf("@xai_key error invalid\n");
+        fflush(stdout);
+        return true;
+    }
+    nvs_handle_t h;
+    esp_err_t err = nvs_open(NVS_NS, NVS_READWRITE, &h);
+    if (err == ESP_OK) {
+        err = key[0] ? nvs_set_str(h, NVS_KEY, key) : nvs_erase_key(h, NVS_KEY);
+        if (err == ESP_ERR_NVS_NOT_FOUND) {
+            err = ESP_OK;   /* clearing a key that wasn't there */
+        }
+        if (err == ESP_OK) {
+            err = nvs_commit(h);
+        }
+        nvs_close(h);
+    }
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "couldn't store the key: %s", esp_err_to_name(err));
+        printf("@xai_key error storage\n");
+        fflush(stdout);
+        return true;
+    }
+    strlcpy(s_key, key, sizeof(s_key));
+    s_key_loaded = true;
+    /* Never log the key itself. */
+    ESP_LOGI(TAG, "%s", key[0] ? "xAI key stored; replies will be spoken by xAI" : "xAI key cleared; replies go back to Gemini");
+    printf(key[0] ? "@xai_key ok\n" : "@xai_key cleared\n");
+    fflush(stdout);
+    return true;
+}
+
+/* --- connection ------------------------------------------------------------------ */
+
+static void conn_close(void)
+{
+    if (s_tls) {
+        esp_tls_conn_destroy(s_tls);
+        s_tls = NULL;
+    }
+    s_rx.pos = s_rx.len = 0;
+    f.st = F_HDR0;
+    s_msg_len = 0;
+}
+
+static bool conn_write(const uint8_t *data, size_t len)
+{
+    int64_t deadline = now_us() + IO_TIMEOUT_US;
+    while (len) {
+        ssize_t n = esp_tls_conn_write(s_tls, data, len);
+        if (n > 0) {
+            data += n;
+            len -= n;
+        } else if (n == ESP_TLS_ERR_SSL_WANT_READ || n == ESP_TLS_ERR_SSL_WANT_WRITE) {
+            if (now_us() > deadline) {
+                return false;
+            }
+            vTaskDelay(1);
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* Next byte, waiting for it: 1 ok, 0 closed, -1 error or timeout. Only for the upgrade response. */
+static int rx_byte_wait(uint8_t *c)
+{
+    if (s_rx.pos < s_rx.len) {
+        *c = s_rx.buf[s_rx.pos++];
+        return 1;
+    }
+    int64_t deadline = now_us() + IO_TIMEOUT_US;
+    for (;;) {
+        ssize_t n = esp_tls_conn_read(s_tls, s_rx.buf, sizeof(s_rx.buf));
+        if (n > 0) {
+            s_rx.pos = 0;
+            s_rx.len = n;
+            *c = s_rx.buf[s_rx.pos++];
+            return 1;
+        }
+        if (n == 0) {
+            return 0;
+        }
+        if (n != ESP_TLS_ERR_SSL_WANT_READ && n != ESP_TLS_ERR_SSL_WANT_WRITE) {
+            return -1;
+        }
+        if (now_us() > deadline) {
+            return -1;
+        }
+        vTaskDelay(pdMS_TO_TICKS(5));
+    }
+}
+
+static bool rx_line(char *out, size_t cap)
+{
+    size_t n = 0;
+    for (;;) {
+        uint8_t c;
+        if (rx_byte_wait(&c) != 1) {
+            return false;
+        }
+        if (c == '\n') {
+            break;
+        }
+        if (c != '\r') {
+            if (n + 1 >= cap) {
+                return false;
+            }
+            out[n++] = (char)c;
+        }
+    }
+    out[n] = '\0';
+    return true;
+}
+
+/* One client frame: always FIN, always masked (RFC 6455 5.3), sent in pieces so nothing big is allocated. */
+static bool ws_send(uint8_t op, const void *data, size_t len)
+{
+    uint8_t hdr[14];
+    size_t hl = 0;
+    hdr[hl++] = 0x80 | op;
+    if (len < 126) {
+        hdr[hl++] = 0x80 | (uint8_t)len;
+    } else if (len <= 0xffff) {
+        hdr[hl++] = 0x80 | 126;
+        hdr[hl++] = (uint8_t)(len >> 8);
+        hdr[hl++] = (uint8_t)len;
+    } else {
+        hdr[hl++] = 0x80 | 127;
+        for (int i = 7; i >= 0; i--) {
+            hdr[hl++] = (uint8_t)((uint64_t)len >> (8 * i));
+        }
+    }
+    uint8_t mask[4];
+    esp_fill_random(mask, sizeof(mask));
+    memcpy(hdr + hl, mask, 4);
+    hl += 4;
+    if (!conn_write(hdr, hl)) {
+        return false;
+    }
+    const uint8_t *p = data;
+    uint8_t chunk[256];
+    for (size_t off = 0; off < len;) {
+        size_t n = len - off < sizeof(chunk) ? len - off : sizeof(chunk);
+        for (size_t i = 0; i < n; i++) {
+            chunk[i] = p[off + i] ^ mask[(off + i) & 3];
+        }
+        if (!conn_write(chunk, n)) {
+            return false;
+        }
+        off += n;
+    }
+    return true;
+}
+
+static bool ws_send_text(const char *s)
+{
+    if (!s_tls || !ws_send(WS_TEXT, s, strlen(s))) {
+        ESP_LOGW(TAG, "sending to xAI failed");
+        conn_close();
+        return false;
+    }
+    s_last_use_us = now_us();
+    return true;
+}
+
+/*
+ * Opens the TLS connection, resuming the last session when it can, and
+ * upgrades it to a WebSocket. A refused upgrade (bad key, voice or quota)
+ * comes back as an ordinary HTTP response, whose body says why. The server's
+ * Sec-WebSocket-Accept isn't checked: TLS already says who answered.
+ */
+static bool conn_open(void)
+{
+    conn_close();
+    int64_t t0 = now_us();
+    s_tls = esp_tls_init();
+    if (!s_tls) {
+        return false;
+    }
+    esp_tls_cfg_t cfg = {
+        .crt_bundle_attach = esp_crt_bundle_attach,
+        .timeout_ms = CONNECT_TIMEOUT_MS,
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+        .client_session = s_ticket,
+#endif
+    };
+    if (esp_tls_conn_new_sync(HOST, strlen(HOST), 443, &cfg, s_tls) != 1) {
+        ESP_LOGW(TAG, "can't reach the xAI API");
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+        if (s_ticket) {
+            /* The ticket may be what was refused: the next try starts afresh. */
+            esp_tls_free_client_session(s_ticket);
+            s_ticket = NULL;
+        }
+#endif
+        conn_close();
+        return false;
+    }
+    bool resumed = s_ticket != NULL;
+#if CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS
+    if (s_ticket) {
+        esp_tls_free_client_session(s_ticket);
+    }
+    s_ticket = esp_tls_get_client_session(s_tls);
+#endif
+    int fd;
+    if (esp_tls_get_conn_sockfd(s_tls, &fd) == ESP_OK) {
+        lwip_fcntl(fd, F_SETFL, lwip_fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+    }
+
+    uint8_t nonce[16];
+    esp_fill_random(nonce, sizeof(nonce));
+    unsigned char ws_key[32];
+    size_t ws_key_len = 0;
+    mbedtls_base64_encode(ws_key, sizeof(ws_key), &ws_key_len, nonce, sizeof(nonce));
+    ws_key[ws_key_len] = '\0';
+    char head[640];
+    int hl = snprintf(head, sizeof(head),
+                      "GET " PATH " HTTP/1.1\r\n"
+                      "Host: " HOST "\r\n"
+                      "Upgrade: websocket\r\n"
+                      "Connection: Upgrade\r\n"
+                      "Sec-WebSocket-Key: %s\r\n"
+                      "Sec-WebSocket-Version: 13\r\n"
+                      "Authorization: Bearer %s\r\n\r\n",
+                      (const char *)ws_key, s_key);
+    bool sent = hl > 0 && hl < (int)sizeof(head) && conn_write((const uint8_t *)head, hl);
+    memset(head, 0, sizeof(head));   /* it held the key */
+    char line[HDR_LINE_MAX];
+    int status = 0;
+    if (!sent || !rx_line(line, sizeof(line)) || sscanf(line, "HTTP/%*s %d", &status) != 1) {
+        ESP_LOGW(TAG, "no WebSocket upgrade from the xAI API");
+        conn_close();
+        return false;
+    }
+    long length = 0;
+    for (;;) {
+        if (!rx_line(line, sizeof(line))) {
+            conn_close();
+            return false;
+        }
+        if (!line[0]) {
+            break;
+        }
+        if (!strncasecmp(line, "content-length:", 15)) {
+            length = strtol(line + 15, NULL, 10);
+        }
+    }
+    if (status != 101) {
+        /* The error body says why (bad key, quota, voice); it never holds the key. */
+        char err[ERR_MAX];
+        size_t n = 0;
+        uint8_t c;
+        for (long i = 0; i < length && n < sizeof(err) - 1 && rx_byte_wait(&c) == 1; i++) {
+            err[n++] = (char)c;
+        }
+        err[n] = '\0';
+        ESP_LOGW(TAG, "HTTP %d: %.300s", status, err);
+        r.refused = status >= 400 && status < 500;
+        conn_close();
+        return false;
+    }
+    f.st = F_HDR0;
+    s_msg_len = 0;
+    s_last_use_us = now_us();
+    ESP_LOGI(TAG, "connected in %d ms%s", (int)((now_us() - t0) / 1000), resumed ? " (resumed session)" : "");
+    /* Frames that came in the same read as the upgrade response. */
+    size_t left = s_rx.len - s_rx.pos;
+    size_t from = s_rx.pos;
+    s_rx.pos = s_rx.len = 0;
+    if (left) {
+        feed(s_rx.buf + from, left);
+    }
+    return s_tls != NULL;
+}
+
+/* A connection that's open and not so old the server may have dropped it. */
+static bool conn_fresh(void)
+{
+    return s_tls && now_us() - s_last_use_us < STALE_US;
+}
+
+/* --- audio ------------------------------------------------------------------------- */
+
+static void put_pcm(const uint8_t *pcm, size_t n)
+{
+    for (size_t i = 0; i + 1 < n; i += 2) {
+        int v = (int16_t)(pcm[i] | pcm[i + 1] << 8);
+        r.pcm_sq += (uint64_t)(v * v);
+        r.pcm_peak = abs(v) > r.pcm_peak ? abs(v) : r.pcm_peak;
+    }
+    if (!r.first_audio_us) {
+        r.first_audio_us = now_us();
+    }
+    int64_t blocked = 0;   /* when the reply buffer first had no room for this piece */
+    bool told = false;
+    while (n && !cancelled()) {
+        size_t sent = xStreamBufferSend(s_out, pcm, n, pdMS_TO_TICKS(SEND_WAIT_MS));
+        pcm += sent;
+        n -= sent;
+        r.pcm_bytes += sent;
+        atomic_fetch_add(&s_audio_bytes, sent);
+        if (sent) {
+            blocked = 0;
+        } else if (!blocked) {
+            blocked = now_us();
+        } else if (!told && now_us() - blocked > 2000000) {
+            told = true;
+            ESP_LOGW(TAG, "reply buffer full for 2 s (%u bytes waiting, %u played so far)", (unsigned)n,
+                     (unsigned)r.pcm_bytes);
+        }
+    }
+}
+
+/* Already at the speaker's rate: only a byte left over from the last chunk has to be carried. */
+static void put_audio(const uint8_t *bytes, size_t len)
+{
+    if (!len) {
+        return;
+    }
+    if (r.have_odd) {
+        uint8_t pair[2] = { r.odd, bytes[0] };
+        put_pcm(pair, 2);
+        bytes++;
+        len--;
+        r.have_odd = false;
+    }
+    if (len & 1) {
+        r.odd = bytes[len - 1];
+        r.have_odd = true;
+        len--;
+    }
+    put_pcm(bytes, len);
+}
+
+static void put_base64(const char *b64)
+{
+    size_t in = strlen(b64);
+    if (!in) {
+        return;
+    }
+    size_t cap = in / 4 * 3 + 3;
+    uint8_t *pcm = heap_caps_malloc(cap, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!pcm) {
+        ESP_LOGW(TAG, "no memory for %u bytes of audio", (unsigned)cap);
+        return;
+    }
+    size_t out = 0;
+    if (mbedtls_base64_decode(pcm, cap, &out, (const unsigned char *)b64, in) == 0) {
+        put_audio(pcm, out);
+    } else {
+        ESP_LOGW(TAG, "bad base64 audio");
+    }
+    free(pcm);
+}
+
+/* --- reply ------------------------------------------------------------------------- */
+
+static void finish(const char *why)
+{
+    if (!r.active) {
+        return;
+    }
+    /* Cut off before end(): the end job settles the state, and later sentences start a new utterance. */
+    bool ended = r.ending;
+    r.active = r.ending = false;
+    if (r.refused) {
+        s_failed_gen = r.gen;   /* the key or request was refused: the rest would be too */
+    }
+    if (ended && r.gen == atomic_load(&s_gen)) {
+        atomic_store(&s_state, atomic_load(&s_audio_bytes) ? MUSE_GEMINI_TTS_DONE : MUSE_GEMINI_TTS_FAILED);
+    }
+    ESP_LOGI(TAG, "reply (%d sentences, %u chars, %s): first audio %d ms, %.2fs of speech in %.2fs%s%s%s", r.sentences,
+             (unsigned)r.chars, r.reused ? "kept connection" : "new connection",
+             r.first_audio_us ? (int)((r.first_audio_us - r.t0) / 1000) : -1,
+             (double)r.pcm_bytes / 2 / MUSE_GEMINI_TTS_RATE, (now_us() - r.t0) / 1e6, why ? " (" : "",
+             why ? why : "", why ? ")" : "");
+    if (r.pcm_bytes) {
+        ESP_LOGI(TAG, "speech level: peak %.1f dBFS, rms %.1f dBFS", 20.0 * log10((r.pcm_peak + 1) / 32768.0),
+                 10.0 * log10((double)r.pcm_sq / (r.pcm_bytes / 2) / (32768.0 * 32768.0) + 1e-10));
+    }
+}
+
+static void on_message(char *json)
+{
+    cJSON *ev = cJSON_Parse(json);
+    if (!ev) {
+        ESP_LOGW(TAG, "unparsable message (%u bytes)", (unsigned)strlen(json));
+        return;
+    }
+    const cJSON *type = cJSON_GetObjectItemCaseSensitive(ev, "type");
+    const char *t = cJSON_IsString(type) ? type->valuestring : "";
+    if (!strcmp(t, "audio.delta")) {
+        const cJSON *delta = cJSON_GetObjectItemCaseSensitive(ev, "delta");
+        if (r.active && !cancelled() && cJSON_IsString(delta)) {
+            put_base64(delta->valuestring);
+        }
+    } else if (!strcmp(t, "audio.done")) {
+        if (r.ending) {
+            finish(NULL);
+        }
+    } else if (!strcmp(t, "error")) {
+        const cJSON *msg = cJSON_GetObjectItemCaseSensitive(ev, "message");
+        ESP_LOGW(TAG, "API error: %s", cJSON_IsString(msg) ? msg->valuestring : "(no message)");
+        r.refused = true;
+        if (r.active) {
+            /* The utterance is over as far as the server goes; don't wait for an audio.done. */
+            finish("failed");
+        }
+    }
+    cJSON_Delete(ev);
+}
+
+static void on_frame(void)
+{
+    switch (f.op) {
+    case WS_PING:
+        ws_send(WS_PONG, f.ctl, f.len < sizeof(f.ctl) ? (size_t)f.len : sizeof(f.ctl));
+        return;
+    case WS_PONG:
+        return;
+    case WS_CLOSE:
+        ESP_LOGI(TAG, "the xAI API closed the connection");
+        conn_close();
+        finish("connection closed");
+        return;
+    case WS_TEXT:
+    case WS_BINARY:
+        f.msg_op = f.op;
+        break;
+    case WS_CONT:
+        break;
+    default:
+        return;
+    }
+    if (!f.fin) {
+        return;
+    }
+    if (f.overflow) {
+        ESP_LOGW(TAG, "message over %u bytes dropped", (unsigned)MSG_MAX);
+    } else if (f.msg_op == WS_TEXT) {
+        s_msg[s_msg_len] = '\0';
+        on_message(s_msg);
+    }
+    s_msg_len = 0;
+    f.overflow = false;
+}
+
+static void payload_byte(uint8_t c)
+{
+    if (f.masked) {
+        c ^= f.mask[f.got & 3];
+    }
+    if (f.op >= WS_CLOSE) {
+        if (f.got < sizeof(f.ctl)) {
+            f.ctl[f.got] = c;
+        }
+    } else if (s_msg_len < MSG_MAX - 1) {
+        s_msg[s_msg_len++] = (char)c;
+    } else {
+        f.overflow = true;
+    }
+    f.got++;
+}
+
+/* Feeds received bytes through the frame parser; whole frames are handled as they complete. */
+static void feed(const uint8_t *buf, size_t n)
+{
+    for (size_t i = 0; i < n && s_tls; i++) {
+        uint8_t c = buf[i];
+        switch (f.st) {
+        case F_HDR0:
+            f.fin = c & 0x80;
+            f.op = c & 0x0f;
+            f.st = F_HDR1;
+            break;
+        case F_HDR1:
+            f.masked = c & 0x80;
+            f.len = c & 0x7f;
+            f.got = 0;
+            f.mask_got = 0;
+            if (f.len >= 126) {
+                f.ext_need = f.len == 126 ? 2 : 8;
+                f.ext_got = 0;
+                f.len = 0;
+                f.st = F_EXTLEN;
+            } else {
+                f.st = f.masked ? F_MASK : F_PAYLOAD;
+            }
+            break;
+        case F_EXTLEN:
+            f.len = f.len << 8 | c;
+            if (++f.ext_got == f.ext_need) {
+                f.st = f.masked ? F_MASK : F_PAYLOAD;
+            }
+            break;
+        case F_MASK:
+            f.mask[f.mask_got++] = c;
+            if (f.mask_got == 4) {
+                f.st = F_PAYLOAD;
+            }
+            break;
+        case F_PAYLOAD:
+            payload_byte(c);
+            break;
+        }
+        if (f.st == F_PAYLOAD && f.got == f.len) {
+            f.st = F_HDR0;
+            on_frame();
+        }
+    }
+}
+
+/* Reads whatever has arrived, without waiting. False if the connection failed. */
+static bool poll_rx(void)
+{
+    while (s_tls) {
+        ssize_t n = esp_tls_conn_read(s_tls, s_rx.buf, sizeof(s_rx.buf));
+        if (n > 0) {
+            r.last_rx_us = s_last_use_us = now_us();
+            feed(s_rx.buf, n);
+            continue;
+        }
+        if (n == ESP_TLS_ERR_SSL_WANT_READ || n == ESP_TLS_ERR_SSL_WANT_WRITE) {
+            return true;
+        }
+        ESP_LOGW(TAG, "the connection to xAI dropped");
+        conn_close();
+        return false;
+    }
+    return false;
+}
+
+/* Streams one sentence into the reply's utterance, connecting first if need be. */
+static void say(uint32_t gen, const char *text)
+{
+    if (!r.active || r.gen != gen) {
+        memset(&r, 0, sizeof(r));
+        r.gen = gen;
+        r.t0 = now_us();
+        r.reused = conn_fresh();
+        if (!r.reused && !conn_open()) {
+            if (r.refused) {
+                s_failed_gen = gen;
+            }
+            return;
+        }
+        r.active = true;
+    }
+    r.sentences++;
+    r.chars += strlen(text);
+    /* What the voice is given, speech tags and all: the screen shows it without them. */
+    ESP_LOGI(TAG, "piece %d: \"%.200s\"", r.sentences, text);
+    r.last_rx_us = now_us();
+    cJSON *msg = cJSON_CreateObject();
+    cJSON_AddStringToObject(msg, "type", "text.delta");
+    /* Sentences come without the space between them. */
+    size_t n = strlen(text);
+    char *spaced = malloc(n + 2);
+    if (!msg || !spaced) {
+        cJSON_Delete(msg);
+        free(spaced);
+        return;
+    }
+    memcpy(spaced, text, n);
+    spaced[n] = ' ';
+    spaced[n + 1] = '\0';
+    cJSON_AddStringToObject(msg, "delta", spaced);
+    free(spaced);
+    char *json = cJSON_PrintUnformatted(msg);
+    cJSON_Delete(msg);
+    if (!json || !ws_send_text(json)) {
+        finish("send failed");
+    }
+    cJSON_free(json);
+}
+
+static void end_reply(uint32_t gen)
+{
+    if (r.active && r.gen == gen && s_tls) {
+        if (ws_send_text("{\"type\":\"text.done\"}")) {
+            r.ending = true;
+            r.last_rx_us = now_us();
+            return;
+        }
+        finish("send failed");
+        return;
+    }
+    if (gen == atomic_load(&s_gen)) {
+        atomic_store(&s_state, atomic_load(&s_audio_bytes) ? MUSE_GEMINI_TTS_DONE : MUSE_GEMINI_TTS_FAILED);
+    }
+}
+
+static void worker(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        TickType_t wait = r.active ? pdMS_TO_TICKS(POLL_MS) : s_tls ? pdMS_TO_TICKS(1000) : portMAX_DELAY;
+        job_t job;
+        bool got = xQueueReceive(s_queue, &job, wait) == pdTRUE;
+
+        if (r.active && cancelled()) {
+            /* Closing is the quickest way to stop the audio still coming. */
+            conn_close();
+            finish("cancelled");
+        }
+        if (got) {
+            bool current = job.gen == atomic_load(&s_gen);
+            switch (job.type) {
+            case JOB_WARM:
+                if (!conn_fresh() && !r.active && !muse_live_active()) {   /* a live conversation speaks for itself */
+                    for (int waited = 0; !muse_wifi_connected() && waited < WARM_WIFI_WAIT_MS; waited += 100) {
+                        vTaskDelay(pdMS_TO_TICKS(100));
+                    }
+                    if (muse_wifi_connected() && !conn_fresh()) {
+                        conn_open();
+                    }
+                }
+                break;
+            case JOB_SAY:
+                if (current && job.gen != s_failed_gen) {
+                    say(job.gen, job.text);
+                }
+                free(job.text);
+                break;
+            case JOB_END:
+                if (current) {
+                    end_reply(job.gen);
+                }
+                break;
+            case JOB_CLOSE:
+                conn_close();
+                finish("closed");
+                break;
+            }
+        }
+
+        if (s_tls && !poll_rx()) {
+            finish("connection dropped");
+        }
+        if (r.ending && now_us() - r.last_rx_us > IO_TIMEOUT_US) {
+            ESP_LOGW(TAG, "the xAI API went quiet");
+            conn_close();
+            finish("timed out");
+        }
+        if (!r.active && s_tls && now_us() - s_last_use_us > IDLE_CLOSE_US) {
+            conn_close();   /* nothing to say for a while: free it */
+        }
+    }
+}
+
+/* --- API ------------------------------------------------------------------------------ */
+
+static bool ensure_worker(void)
+{
+    if (s_task) {
+        return true;
+    }
+    s_queue = xQueueCreate(QUEUE_LEN, sizeof(job_t));
+    s_msg = heap_caps_malloc(MSG_MAX, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!s_queue || !s_msg ||
+        xTaskCreatePinnedToCoreWithCaps(worker, "xai_tts", STACK, NULL, 4, &s_task, tskNO_AFFINITY,
+                                        MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        ESP_LOGE(TAG, "can't start the speech task");
+        s_task = NULL;
+        return false;
+    }
+    return true;
+}
+
+void muse_xai_tts_warm(void)
+{
+    if (!muse_xai_tts_configured() || !ensure_worker()) {
+        return;
+    }
+    job_t job = { .type = JOB_WARM, .gen = atomic_load(&s_gen) };
+    xQueueSend(s_queue, &job, 0);
+}
+
+bool muse_xai_tts_begin(StreamBufferHandle_t out)
+{
+    if (!muse_xai_tts_configured() || !ensure_worker()) {
+        return false;
+    }
+    s_out = out;
+    atomic_store(&s_audio_bytes, 0);
+    atomic_fetch_add(&s_gen, 1);
+    atomic_store(&s_state, MUSE_GEMINI_TTS_RUNNING);
+    return true;
+}
+
+bool muse_xai_tts_say(const char *text, size_t len)
+{
+    char *copy = malloc(len + 1);
+    if (!copy) {
+        return false;
+    }
+    memcpy(copy, text, len);
+    copy[len] = '\0';
+    job_t job = { .type = JOB_SAY, .gen = atomic_load(&s_gen), .text = copy };
+    if (xQueueSend(s_queue, &job, pdMS_TO_TICKS(100)) != pdTRUE) {
+        free(copy);
+        return false;
+    }
+    return true;
+}
+
+void muse_xai_tts_end(void)
+{
+    job_t job = { .type = JOB_END, .gen = atomic_load(&s_gen) };
+    if (xQueueSend(s_queue, &job, pdMS_TO_TICKS(100)) != pdTRUE) {
+        atomic_store(&s_state, atomic_load(&s_audio_bytes) ? MUSE_GEMINI_TTS_DONE : MUSE_GEMINI_TTS_FAILED);
+    }
+}
+
+muse_gemini_tts_state_t muse_xai_tts_state(void)
+{
+    return (muse_gemini_tts_state_t)atomic_load(&s_state);
+}
+
+void muse_xai_tts_cancel(void)
+{
+    atomic_fetch_add(&s_gen, 1);
+    atomic_store(&s_state, MUSE_GEMINI_TTS_IDLE);
+}
+
+void muse_xai_tts_close(void)
+{
+    muse_xai_tts_cancel();
+    if (s_task) {
+        job_t job = { .type = JOB_CLOSE, .gen = atomic_load(&s_gen) };
+        xQueueSend(s_queue, &job, 0);
+    }
+}
+
+bool muse_xai_tts_key(char *out, size_t cap)
+{
+    load_key();
+    return s_key[0] && strlcpy(out, s_key, cap) < cap;
+}
diff --git a/esp32/components/muse/muse_xai_tts.h b/esp32/components/muse/muse_xai_tts.h
new file mode 100644
index 0000000..73ad0a6
--- /dev/null
+++ b/esp32/components/muse/muse_xai_tts.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "freertos/FreeRTOS.h"
+#include "freertos/stream_buffer.h"
+#include "muse_gemini_tts.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Spoken replies through xAI's streaming text to speech (wss://api.x.ai/v1/tts),
+ * as headerless 16-bit little-endian mono PCM at the speaker's 16 kHz, so it
+ * goes to the reply buffer as it comes. The same calls as muse_gemini_tts.h,
+ * which hands them here whenever an xAI key is stored.
+ *
+ * A reply is one utterance on a kept WebSocket: each say() streams a sentence
+ * in as a text.delta, end() sends text.done, and the audio streams back as
+ * the server makes it. xAI limits requests per second, not per day.
+ *
+ * The API key is set over serial with the line ">xai_key=xai-..." and kept in
+ * NVS; ">xai_key=" with nothing after it clears it, and replies go back to
+ * Gemini if it has a key.
+ */
+
+/* Console hook for ">xai_key=...", the line without its '>'. False if it isn't that command. */
+bool muse_xai_tts_console_command(const char *line);
+
+/* A key is stored. */
+bool muse_xai_tts_configured(void);
+
+/* Opens the connection ahead of a reply, if there's a key and none is open. Returns at once. */
+void muse_xai_tts_warm(void);
+
+/* Starts a reply whose PCM goes to `out` (empty it first). False if there's no key. */
+bool muse_xai_tts_begin(StreamBufferHandle_t out);
+
+/* Queues one sentence of the reply (copied). False if it couldn't be queued. */
+bool muse_xai_tts_say(const char *text, size_t len);
+
+/* No more sentences: the state becomes DONE or FAILED once the audio has all come. */
+void muse_xai_tts_end(void);
+
+muse_gemini_tts_state_t muse_xai_tts_state(void);
+
+/* Drops the reply: queued sentences are skipped and the audio still coming is cut off. */
+void muse_xai_tts_cancel(void);
+
+/* Drops any reply and closes the kept connection (a live conversation is starting). */
+void muse_xai_tts_close(void);
+
+/* The stored key, for muse_live.c: false if there's none. Never log it. */
+bool muse_xai_tts_key(char *out, size_t cap);
+
+#ifdef __cplusplus
+}
+#endif
