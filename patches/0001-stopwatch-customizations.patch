diff --git a/esp32/components/muse/muse_gemini_tts.c b/esp32/components/muse/muse_gemini_tts.c
new file mode 100644
index 0000000..f8194d2
--- /dev/null
+++ b/esp32/components/muse/muse_gemini_tts.c
@@ -0,0 +1,469 @@
+#include "muse_gemini_tts.h"
+
+#include <stdatomic.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "cJSON.h"
+#include "esp_crt_bundle.h"
+#include "esp_heap_caps.h"
+#include "esp_http_client.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "freertos/idf_additions.h"
+#include "freertos/task.h"
+#include "mbedtls/base64.h"
+#include "nvs.h"
+
+static const char *TAG = "muse_gemini_tts";
+
+#define URL "https://generativelanguage.googleapis.com/v1beta/interactions?alt=sse"
+#define MODEL "gemini-3.8-flash-lite-tts"
+#define VOICE "Achernar"
+#define NVS_NS "muse_tts"
+#define NVS_KEY "gemini_key"
+#define COMMAND "gemini_key="
+#define KEY_MAX 128
+#define SSE_LINE_MAX (256 * 1024)        /* one SSE event; its base64 audio grows it */
+#define READ_CHUNK 4096
+#define SEND_WAIT_MS 50              /* blocked on a full reply buffer, look for cancel this often */
+#define STACK (8 * 1024)
+
+static char s_key[KEY_MAX];
+static bool s_key_loaded;
+static _Atomic int s_state = MUSE_GEMINI_TTS_IDLE;
+static atomic_bool s_cancel;
+static atomic_bool s_busy;           /* the task exists, even when cancelled */
+
+typedef struct {
+    char *text;
+    StreamBufferHandle_t out;
+    char *line;
+    size_t line_len;
+    bool line_overflow;
+    size_t pcm_bytes;
+    bool failed;
+    /* Down to the speaker's rate: the API sends 24 kHz whatever sample_rate asks for. */
+    int rate;                /* the audio's, from each delta */
+    uint32_t step;           /* Q16 input samples per output sample */
+    uint32_t pos;            /* Q16 position of the next output past x0 */
+    int16_t x0;              /* last filtered input sample */
+    int16_t h1, h2;          /* the low-pass filter's history */
+    int primed;              /* input samples seen, up to 3 */
+    uint8_t odd;             /* a sample split across deltas */
+    bool have_odd;
+} job_t;
+
+/* --- key ------------------------------------------------------------------ */
+
+static void load_key(void)
+{
+    if (s_key_loaded) {
+        return;
+    }
+    s_key_loaded = true;
+    s_key[0] = '\0';
+    nvs_handle_t h;
+    if (nvs_open(NVS_NS, NVS_READONLY, &h) != ESP_OK) {
+        return;
+    }
+    size_t len = sizeof(s_key);
+    if (nvs_get_str(h, NVS_KEY, s_key, &len) != ESP_OK) {
+        s_key[0] = '\0';
+    }
+    nvs_close(h);
+}
+
+bool muse_gemini_tts_configured(void)
+{
+    load_key();
+    return s_key[0] != '\0';
+}
+
+static bool key_valid(const char *k)
+{
+    size_t n = strlen(k);
+    if (n < 20 || n >= KEY_MAX) {
+        return false;
+    }
+    for (size_t i = 0; i < n; i++) {
+        char c = k[i];
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+              c == '.')) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool muse_gemini_tts_console_command(const char *line)
+{
+    if (strncmp(line, COMMAND, strlen(COMMAND)) != 0) {
+        return false;
+    }
+    const char *key = line + strlen(COMMAND);
+    if (key[0] && !key_valid(key)) {
+        printf("@gemini_key error invalid\n");
+        fflush(stdout);
+        return true;
+    }
+    nvs_handle_t h;
+    esp_err_t err = nvs_open(NVS_NS, NVS_READWRITE, &h);
+    if (err == ESP_OK) {
+        err = key[0] ? nvs_set_str(h, NVS_KEY, key) : nvs_erase_key(h, NVS_KEY);
+        if (err == ESP_ERR_NVS_NOT_FOUND) {
+            err = ESP_OK;   /* clearing a key that wasn't there */
+        }
+        if (err == ESP_OK) {
+            err = nvs_commit(h);
+        }
+        nvs_close(h);
+    }
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "couldn't store the key: %s", esp_err_to_name(err));
+        printf("@gemini_key error storage\n");
+        fflush(stdout);
+        return true;
+    }
+    strlcpy(s_key, key, sizeof(s_key));
+    s_key_loaded = true;
+    /* Never log the key itself. */
+    ESP_LOGI(TAG, "%s", key[0] ? "Gemini key stored; replies will be spoken" : "Gemini key cleared; replies are captions only");
+    printf(key[0] ? "@gemini_key ok\n" : "@gemini_key cleared\n");
+    fflush(stdout);
+    return true;
+}
+
+/* --- response ---------------------------------------------------------------- */
+
+static void put_pcm(job_t *j, const uint8_t *pcm, size_t n)
+{
+    while (n && !atomic_load(&s_cancel)) {
+        size_t sent = xStreamBufferSend(j->out, pcm, n, pdMS_TO_TICKS(SEND_WAIT_MS));
+        pcm += sent;
+        n -= sent;
+        j->pcm_bytes += sent;
+    }
+}
+
+/* One input sample: a [1 2 1]/4 low-pass, then linear interpolation down to 16 kHz. */
+static size_t resample_one(job_t *j, int16_t x, int16_t *out)
+{
+    int32_t y = ((int32_t)j->h2 + 2 * j->h1 + x) / 4;   /* centred on h1 */
+    j->h2 = j->h1;
+    j->h1 = x;
+    if (j->primed < 3) {
+        if (++j->primed == 3) {
+            j->x0 = (int16_t)y;
+            j->pos = 0;
+        }
+        return 0;
+    }
+    size_t n = 0;
+    while (j->pos < 65536) {
+        out[n++] = (int16_t)(j->x0 + (int32_t)(((int64_t)(y - j->x0) * j->pos) >> 16));
+        j->pos += j->step;
+    }
+    j->pos -= 65536;
+    j->x0 = (int16_t)y;
+    return n;
+}
+
+static void put_audio(job_t *j, const uint8_t *bytes, size_t len, int rate)
+{
+    if (rate <= 0) {
+        rate = 24000;
+    }
+    if (rate != j->rate) {
+        if (j->rate) {
+            ESP_LOGW(TAG, "audio rate changed %d -> %d Hz", j->rate, rate);
+        } else {
+            ESP_LOGI(TAG, "reply audio: %d Hz", rate);
+        }
+        j->rate = rate;
+        j->step = (uint32_t)(((uint64_t)rate << 16) / MUSE_GEMINI_TTS_RATE);
+    }
+    int16_t out[64];
+    size_t n = 0;
+    for (size_t i = 0; i < len && !atomic_load(&s_cancel); i++) {
+        if (!j->have_odd) {
+            j->odd = bytes[i];
+            j->have_odd = true;
+            continue;
+        }
+        int16_t x = (int16_t)(j->odd | bytes[i] << 8);   /* little-endian */
+        j->have_odd = false;
+        if (rate == MUSE_GEMINI_TTS_RATE) {
+            out[n++] = x;
+        } else {
+            n += resample_one(j, x, out + n);
+        }
+        if (n > 60) {
+            put_pcm(j, (const uint8_t *)out, n * sizeof(int16_t));
+            n = 0;
+        }
+    }
+    if (n) {
+        put_pcm(j, (const uint8_t *)out, n * sizeof(int16_t));
+    }
+}
+
+static void put_base64(job_t *j, const char *b64, int rate)
+{
+    size_t in = strlen(b64);
+    if (!in) {
+        return;
+    }
+    size_t cap = in / 4 * 3 + 3;
+    uint8_t *pcm = heap_caps_malloc(cap, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!pcm) {
+        ESP_LOGW(TAG, "no memory for %u bytes of audio", (unsigned)cap);
+        j->failed = true;
+        return;
+    }
+    size_t out = 0;
+    if (mbedtls_base64_decode(pcm, cap, &out, (const unsigned char *)b64, in) == 0) {
+        put_audio(j, pcm, out, rate);
+    } else {
+        ESP_LOGW(TAG, "bad base64 audio");
+    }
+    free(pcm);
+}
+
+/*
+ * Any object shaped {"type": "audio", "data": "<base64>"} anywhere in the
+ * event: a stream's step.delta, or a whole model_output.
+ */
+static void find_audio(job_t *j, const cJSON *node)
+{
+    if (!node || atomic_load(&s_cancel)) {
+        return;
+    }
+    if (cJSON_IsObject(node)) {
+        const cJSON *type = cJSON_GetObjectItemCaseSensitive(node, "type");
+        const cJSON *data = cJSON_GetObjectItemCaseSensitive(node, "data");
+        if (cJSON_IsString(type) && !strcmp(type->valuestring, "audio") && cJSON_IsString(data)) {
+            const cJSON *rate = cJSON_GetObjectItemCaseSensitive(node, "sample_rate");
+            put_base64(j, data->valuestring, cJSON_IsNumber(rate) ? rate->valueint : 0);
+            return;
+        }
+    }
+    for (const cJSON *c = node->child; c; c = c->next) {
+        find_audio(j, c);
+    }
+}
+
+static void on_event(job_t *j, char *json)
+{
+    if (!strcmp(json, "[DONE]")) {
+        return;
+    }
+    cJSON *ev = cJSON_Parse(json);
+    if (!ev) {
+        ESP_LOGW(TAG, "unparsable event (%u bytes)", (unsigned)strlen(json));
+        return;
+    }
+    const cJSON *err = cJSON_GetObjectItemCaseSensitive(ev, "error");
+    if (err) {
+        const cJSON *msg = cJSON_GetObjectItemCaseSensitive(err, "message");
+        ESP_LOGW(TAG, "API error: %s", cJSON_IsString(msg) ? msg->valuestring : "(no message)");
+        j->failed = true;
+    } else {
+        find_audio(j, ev);
+    }
+    cJSON_Delete(ev);
+}
+
+/* Splits the body into SSE lines and hands each "data:" payload on. */
+static void feed(job_t *j, const char *buf, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        char c = buf[i];
+        if (c == '\r') {
+            continue;
+        }
+        if (c != '\n') {
+            if (j->line_len < SSE_LINE_MAX - 1) {
+                j->line[j->line_len++] = c;
+            } else {
+                j->line_overflow = true;
+            }
+            continue;
+        }
+        j->line[j->line_len] = '\0';
+        if (j->line_overflow) {
+            ESP_LOGW(TAG, "event over %u bytes dropped", (unsigned)SSE_LINE_MAX);
+        } else if (!strncmp(j->line, "data:", 5)) {
+            char *p = j->line + 5;
+            while (*p == ' ') {
+                p++;
+            }
+            on_event(j, p);
+        }
+        j->line_len = 0;
+        j->line_overflow = false;
+    }
+}
+
+/* --- request ------------------------------------------------------------------ */
+
+static char *request_body(const char *text)
+{
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "model", MODEL);
+    cJSON *input = cJSON_AddArrayToObject(root, "input");
+    cJSON *turn = cJSON_CreateObject();
+    cJSON_AddStringToObject(turn, "type", "user_input");
+    cJSON *content = cJSON_AddArrayToObject(turn, "content");
+    cJSON *part = cJSON_CreateObject();
+    cJSON_AddStringToObject(part, "type", "text");
+    cJSON_AddStringToObject(part, "text", text);
+    cJSON_AddItemToArray(content, part);
+    cJSON_AddItemToArray(input, turn);
+    cJSON *fmt = cJSON_AddObjectToObject(root, "response_format");
+    cJSON_AddStringToObject(fmt, "type", "audio");
+    cJSON_AddStringToObject(fmt, "mime_type", "audio/l16");
+    cJSON_AddNumberToObject(fmt, "sample_rate", MUSE_GEMINI_TTS_RATE);
+    cJSON *gen = cJSON_AddObjectToObject(root, "generation_config");
+    cJSON *speech = cJSON_AddArrayToObject(gen, "speech_config");
+    cJSON *voice = cJSON_CreateObject();
+    cJSON_AddStringToObject(voice, "voice", VOICE);
+    cJSON_AddItemToArray(speech, voice);
+    cJSON_AddBoolToObject(root, "stream", true);
+    char *body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    return body;
+}
+
+static void run(job_t *j)
+{
+    char *body = request_body(j->text);
+    if (!body) {
+        j->failed = true;
+        return;
+    }
+    esp_http_client_config_t cfg = {
+        .url = URL,
+        .method = HTTP_METHOD_POST,
+        .timeout_ms = 20000,
+        .buffer_size = READ_CHUNK,
+        .buffer_size_tx = 2048,
+        .crt_bundle_attach = esp_crt_bundle_attach,
+    };
+    esp_http_client_handle_t c = esp_http_client_init(&cfg);
+    if (!c) {
+        free(body);
+        j->failed = true;
+        return;
+    }
+    esp_http_client_set_header(c, "Content-Type", "application/json");
+    esp_http_client_set_header(c, "Accept", "text/event-stream");
+    esp_http_client_set_header(c, "x-goog-api-key", s_key);
+    size_t len = strlen(body);
+    esp_err_t err = esp_http_client_open(c, len);
+    if (err == ESP_OK && esp_http_client_write(c, body, len) != (int)len) {
+        err = ESP_FAIL;
+    }
+    free(body);
+    if (err != ESP_OK) {
+        ESP_LOGW(TAG, "can't reach the Gemini API: %s", esp_err_to_name(err));
+        j->failed = true;
+        esp_http_client_cleanup(c);
+        return;
+    }
+    esp_http_client_fetch_headers(c);
+    int status = esp_http_client_get_status_code(c);
+    char *buf = heap_caps_malloc(READ_CHUNK, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!buf) {
+        j->failed = true;
+    } else if (status != 200) {
+        /* The error body says why (bad key, quota, model name); it never holds the key. */
+        int n = esp_http_client_read(c, buf, READ_CHUNK - 1);
+        buf[n > 0 ? n : 0] = '\0';
+        ESP_LOGW(TAG, "HTTP %d: %.400s", status, buf);
+        j->failed = true;
+    } else {
+        int n;
+        while (!atomic_load(&s_cancel) && (n = esp_http_client_read(c, buf, READ_CHUNK)) > 0) {
+            feed(j, buf, n);
+        }
+        if (n < 0 && !atomic_load(&s_cancel)) {
+            ESP_LOGW(TAG, "read failed mid-reply");
+            j->failed = true;
+        }
+        if (j->line_len) {
+            feed(j, "\n", 1);   /* a last event without its newline */
+        }
+    }
+    free(buf);
+    esp_http_client_close(c);
+    esp_http_client_cleanup(c);
+}
+
+static void tts_task(void *arg)
+{
+    job_t *j = arg;
+    int64_t t0 = esp_timer_get_time();
+    run(j);
+    bool cancelled = atomic_load(&s_cancel);
+    if (!cancelled) {
+        ESP_LOGI(TAG, "%.2fs of speech in %.2fs%s", (double)j->pcm_bytes / 2 / MUSE_GEMINI_TTS_RATE,
+                 (esp_timer_get_time() - t0) / 1e6, j->failed ? " (failed)" : "");
+    }
+    /* Some audio counts as done: play what came. */
+    int state = cancelled ? MUSE_GEMINI_TTS_IDLE
+                          : (j->pcm_bytes ? MUSE_GEMINI_TTS_DONE : MUSE_GEMINI_TTS_FAILED);
+    free(j->line);
+    free(j->text);
+    free(j);
+    atomic_store(&s_state, state);
+    atomic_store(&s_busy, false);
+    vTaskDeleteWithCaps(NULL);
+}
+
+bool muse_gemini_tts_start(const char *text, StreamBufferHandle_t out)
+{
+    if (!muse_gemini_tts_configured() || atomic_load(&s_busy)) {
+        return false;
+    }
+    job_t *j = heap_caps_calloc(1, sizeof(*j), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!j) {
+        return false;
+    }
+    j->out = out;
+    j->text = strdup(text);
+    j->line = heap_caps_malloc(SSE_LINE_MAX, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!j->text || !j->line) {
+        free(j->text);
+        free(j->line);
+        free(j);
+        return false;
+    }
+    atomic_store(&s_cancel, false);
+    atomic_store(&s_state, MUSE_GEMINI_TTS_RUNNING);
+    atomic_store(&s_busy, true);
+    if (xTaskCreatePinnedToCoreWithCaps(tts_task, "gemini_tts", STACK, j, 4, NULL, tskNO_AFFINITY,
+                                        MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        atomic_store(&s_busy, false);
+        atomic_store(&s_state, MUSE_GEMINI_TTS_IDLE);
+        free(j->text);
+        free(j->line);
+        free(j);
+        return false;
+    }
+    return true;
+}
+
+muse_gemini_tts_state_t muse_gemini_tts_state(void)
+{
+    return (muse_gemini_tts_state_t)atomic_load(&s_state);
+}
+
+void muse_gemini_tts_cancel(void)
+{
+    if (atomic_load(&s_busy)) {
+        atomic_store(&s_cancel, true);
+    } else {
+        atomic_store(&s_state, MUSE_GEMINI_TTS_IDLE);
+    }
+}
