diff --git a/esp32/tests/test_muse_echo.py b/esp32/tests/test_muse_echo.py
new file mode 100644
index 0000000..39a11ee
--- /dev/null
+++ b/esp32/tests/test_muse_echo.py
@@ -0,0 +1,160 @@
+"""muse_echo.c, a voice over the speaker's own sound, fed levels as the live conversation would (one pair per 20 ms chunk)."""
+import os
+from pathlib import Path
+import shlex
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+MUSE = ROOT / 'components/muse'
+
+HARNESS = r'''
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "muse_echo.h"
+
+#define LAG 3   /* the board's echo comes back 60 ms late */
+
+static float spk_hist[LAG + 1];
+static unsigned seed = 1;
+
+/* -1..1, the same every run. */
+static float jitter(void)
+{
+    seed = seed * 1103515245u + 12345u;
+    return ((seed >> 16) & 0x7fff) / 16384.0f - 1.0f;
+}
+
+/* Speech from the speaker: syllables between -20 and -36 dBFS, the odd gap. */
+static float speech(size_t i)
+{
+    static const float LEVELS[] = { -20, -24, -30, -22, -36, -26, -21, -33, -28, -100 };
+    return LEVELS[i % 10];
+}
+
+/* What the mic hears: the speaker `coupling` dB down (and late, and uneven),
+ * a voice at `voice` dBFS if there is one, and the room. Loudest wins. */
+static float mic(float spk, float coupling, float voice)
+{
+    for (int i = LAG; i > 0; i--) spk_hist[i] = spk_hist[i - 1];
+    spk_hist[0] = spk;
+    float echo = spk_hist[LAG] > -90 ? spk_hist[LAG] + coupling + 3 * jitter() : -100;
+    float db = -58 + jitter();
+    db = echo > db ? echo : db;
+    return voice > db ? voice + jitter() : db;
+}
+
+/* Plays `n` chunks; returns the chunk (counted from 1) where it heard a barge-in, or 0. */
+static size_t play(muse_echo_t *e, size_t n, size_t from, float coupling, float voice)
+{
+    for (size_t i = 0; i < n; i++) {
+        float s = speech(from + i);
+        float m = mic(s, coupling, voice);
+        if (muse_echo_feed(e, s, m, m > -6)) return i + 1;   /* RMS this high clips */
+    }
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    for (int i = 0; i <= LAG; i++) spk_hist[i] = -100;
+    muse_echo_t e;
+    muse_echo_init(&e);
+    switch (atoi(argv[1])) {
+    case 0:   /* 20 s of the speaker alone: never a barge-in */
+        assert(play(&e, 1000, 0, -8, -100) == 0);
+        assert(e.coupling_db < -6 && e.coupling_db > -16);   /* under -8: it's against the loudest of the lag */
+        break;
+    case 1: {   /* a voice over a reply, after it has learnt: heard within 120 ms */
+        assert(play(&e, 150, 0, -8, -100) == 0);
+        size_t at = play(&e, 50, 150, -8, -14);
+        assert(at >= MUSE_ECHO_ONSET_CHUNKS && at <= MUSE_ECHO_ONSET_CHUNKS + 2);
+        break;
+    }
+    case 2:   /* a loud speaker, right from the first chunk: the start guess keeps it from barging in */
+        assert(play(&e, 500, 0, 2, -100) == 0);
+        break;
+    case 3: {   /* playback over: a voice in the quiet room is heard; the room alone isn't */
+        assert(play(&e, 150, 0, -8, -100) == 0);
+        for (int i = 0; i < 50; i++) assert(!muse_echo_feed(&e, -100, mic(-100, -8, -100), false));
+        int heard = 0;
+        for (int i = 0; i < 10 && !heard; i++) heard = muse_echo_feed(&e, -100, mic(-100, -8, -32), false);
+        assert(heard);
+        break;
+    }
+    case 4:   /* a voice no louder than the echo can't be told from it */
+        assert(play(&e, 150, 0, -8, -100) == 0);
+        assert(play(&e, 100, 150, -8, -32) == 0);
+        break;
+    case 6:   /* the speaker 12 dB louder in the mic than it's sent (the StopWatch): learnt, never a barge-in */
+        assert(play(&e, 1500, 0, 12, -100) == 0);
+        break;
+    case 7: {   /* a second reply starts afresh but keeps what it learnt: still no barge-in from echo */
+        assert(play(&e, 300, 0, 12, -100) == 0);
+        muse_echo_reset(&e);
+        assert(play(&e, 300, 0, 12, -100) == 0);
+        break;
+    }
+    case 8:   /* learnt quiet, then a run of words 20 dB hotter in the mic, which clips: never a barge-in */
+        for (int i = 0; i < 300; i++) {
+            float s = -14 - (i % 4) * 2;   /* no gaps */
+            float m = mic(s, i < 150 ? -8 : 12, -100);
+            assert(!muse_echo_feed(&e, s, m, m > -6));   /* that hot, the mic clips */
+        }
+        break;
+    case 9: {   /* a loud voice right by the mic (-9 dBFS, not clipping) over a reply: still heard */
+        assert(play(&e, 150, 0, -8, -100) == 0);
+        size_t at = play(&e, 50, 150, -8, -9);
+        assert(at >= MUSE_ECHO_ONSET_CHUNKS && at <= MUSE_ECHO_ONSET_CHUNKS + 2);
+        break;
+    }
+    case 5: {   /* talking for a while without a barge-in (too soft) doesn't teach it the voice is echo */
+        assert(play(&e, 150, 0, -8, -100) == 0);
+        float before = e.coupling_db;
+        play(&e, 100, 150, -8, -30);
+        assert(e.coupling_db - before < 6);
+        assert(play(&e, 50, 250, -8, -14) != 0);
+        break;
+    }
+    }
+    return 0;
+}
+'''
+
+
+class MuseEcho(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cc = shlex.split(os.environ.get('CC', 'cc'))
+        if not shutil.which(cc[0]):
+            raise unittest.SkipTest('C compiler unavailable')
+        cls.tmp = tempfile.TemporaryDirectory()
+        cls.addClassCleanup(cls.tmp.cleanup)
+        src = Path(cls.tmp.name) / 'echo_test.c'
+        src.write_text(HARNESS)
+        cls.binary = Path(cls.tmp.name) / 'echo_test'
+        subprocess.run([*cc, '-std=gnu11', '-Wall', '-Wextra', '-Werror', '-I', str(MUSE),
+                        str(src), str(MUSE / 'muse_echo.c'), '-o', str(cls.binary)], check=True)
+
+    def run_case(self, case):
+        ran = subprocess.run([str(self.binary), str(case)], capture_output=True, text=True)
+        self.assertEqual(ran.returncode, 0, ran.stderr)
+
+    def test_the_speaker_alone_is_never_a_barge_in(self): self.run_case(0)
+    def test_a_voice_over_a_reply_is_heard_quickly(self): self.run_case(1)
+    def test_a_loud_speaker_from_the_start_is_not_a_barge_in(self): self.run_case(2)
+    def test_after_playback_a_voice_is_heard_and_the_room_is_not(self): self.run_case(3)
+    def test_a_voice_as_soft_as_the_echo_is_not_heard(self): self.run_case(4)
+    def test_a_soft_voice_does_not_teach_it_echo(self): self.run_case(5)
+    def test_a_speaker_louder_in_the_mic_than_sent_is_learnt(self): self.run_case(6)
+    def test_the_next_reply_keeps_what_it_learnt(self): self.run_case(7)
+    def test_a_speaker_overloading_the_mic_is_not_a_barge_in(self): self.run_case(8)
+    def test_a_loud_voice_that_does_not_clip_is_heard(self): self.run_case(9)
+
+
+if __name__ == '__main__':
+    unittest.main()
