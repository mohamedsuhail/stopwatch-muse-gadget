@@ -0,0 +1,52 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "freertos/FreeRTOS.h"
+#include "freertos/stream_buffer.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Spoken replies through the Gemini API (gemini-3.8-flash-lite-tts, the
+ * Interactions API, streamed). The audio comes back as headerless 16-bit
+ * little-endian mono PCM at 24 kHz (the request's sample_rate is ignored), so
+ * it's resampled to the speaker's 16 kHz on the way to the reply buffer.
+ *
+ * The API key is set over serial with the line ">gemini_key=AIza..." and kept
+ * in NVS; ">gemini_key=" with nothing after it clears it. Without a key,
+ * replies stay captions only.
+ */
+
+#define MUSE_GEMINI_TTS_RATE 16000
+
+typedef enum {
+    MUSE_GEMINI_TTS_IDLE,
+    MUSE_GEMINI_TTS_RUNNING,
+    MUSE_GEMINI_TTS_DONE,      /* all of the audio is in the stream buffer */
+    MUSE_GEMINI_TTS_FAILED,
+} muse_gemini_tts_state_t;
+
+/* Console hook for ">gemini_key=...", the line without its '>'. False if it isn't that command. */
+bool muse_gemini_tts_console_command(const char *line);
+
+/* A key is stored. */
+bool muse_gemini_tts_configured(void);
+
+/*
+ * Starts speaking `text` (copied) into `out`, PCM bytes. False if there's no
+ * key, no memory, or the last request hasn't wound down yet.
+ */
+bool muse_gemini_tts_start(const char *text, StreamBufferHandle_t out);
+
+muse_gemini_tts_state_t muse_gemini_tts_state(void);
+
+/* Stops the request in progress; the state goes back to idle once it has. */
+void muse_gemini_tts_cancel(void);
+
+#ifdef __cplusplus
+}
+#endif
