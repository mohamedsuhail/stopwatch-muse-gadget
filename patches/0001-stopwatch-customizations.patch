+/*
+ * Thinking phrases ("Hmm, let me think.", "One moment."...): when Muse hasn't
+ * started its reply FILLER_AFTER_US after the release, one plays so the wait
+ * isn't silent. A random one each time, never one of the last few, so it
+ * doesn't get repetitive. fillers.pcm: u32 count, then (u32 offset, u32
+ * bytes) per phrase, then 16 kHz mono s16le PCM (sounds/make_fillers.py).
+ */
+#if MUSE_HAS_FILLERS
+extern const uint8_t s_fillers_start[] asm("_binary_fillers_pcm_start");
+extern const uint8_t s_fillers_end[] asm("_binary_fillers_pcm_end");
+#define FILLER_AFTER_US (1200 * 1000LL)
+#define FILLER_RECENT 3
+
+static uint32_t rd32(const uint8_t *p)
+{
+    return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void choose_filler(void)
+{
+    static int recent[FILLER_RECENT] = { -1, -1, -1 };
+    static int next;
+    size_t size = s_fillers_end - s_fillers_start;
+    uint32_t count = size >= 4 ? rd32(s_fillers_start) : 0;
+    if (!count || size < 4 + 8 * count) {
+        return;
+    }
+    int pick = -1;
+    for (int tries = 0; tries < 16 && pick < 0; tries++) {
+        int c = (int)(esp_random() % count);
+        bool used = false;
+        for (int i = 0; i < FILLER_RECENT; i++) {
+            used |= recent[i] == c;
+        }
+        if (!used || count <= FILLER_RECENT) {
+            pick = c;
+        }
+    }
+    if (pick < 0) {
+        return;
+    }
+    recent[next] = pick;
+    next = (next + 1) % FILLER_RECENT;
+    uint32_t off = rd32(s_fillers_start + 4 + 8 * pick), len = rd32(s_fillers_start + 8 + 8 * pick);
+    if (off + len > size) {
+        return;
+    }
+    s_turn.filler = s_fillers_start + off;
+    s_turn.filler_left = len & ~(size_t)1;
+    ESP_LOGI(TAG, "thinking phrase %d while Muse replies", pick + 1);
+}
+#endif
+
+/* Starts a thinking phrase once Muse has been quiet a moment, and feeds it on. True while it's playing. */
+static bool play_filler(void)
+{
+#if MUSE_HAS_FILLERS
+    if (!s_turn.filler_chosen && s_marks[M_RELEASE] && gemini_ok()) {
+        bool replied = s_turn.nmsgs && s_turn.msgs[0].len;
+        if (replied) {
+            s_turn.filler_chosen = true;   /* Muse was quick: no phrase needed */
+        } else if (now_us() - s_marks[M_RELEASE] >= FILLER_AFTER_US) {
+            s_turn.filler_chosen = true;
+            choose_filler();
+        }
+    }
+    while (s_turn.filler_left) {
+        size_t room = xStreamBufferSpacesAvailable(s_out) & ~(size_t)1;
+        if (!room) {
+            return true;
+        }
+        size_t n = s_turn.filler_left < room ? s_turn.filler_left : room;
+        if (s_turn.gen == s_gen.load()) {
+            xStreamBufferSend(s_out, s_turn.filler, n, 0);
+        }
+        s_turn.filler += n;
+        s_turn.filler_left -= n;
+        s_turn.pcm_out += n / 2;
+    }
+#endif
+    return false;
+}
+
+/* Moves Gemini's PCM on to the voice task while the reply buffer has room. */
+static void pump_gemini(void)
+{
+    static uint8_t odd[1];      /* a frame split across reads */
+    static bool have_odd;
+    msg_t &m = s_turn.msgs[s_turn.tts_msg];
+    feed_sentences(m);
+    uint8_t *buf = reinterpret_cast<uint8_t *>(s_pcm16);
+    const size_t cap = MINIMP3_MAX_SAMPLES_PER_FRAME * sizeof(int16_t);
+    muse_gemini_tts_state_t st = muse_gemini_tts_state();
+    for (;;) {
+        size_t room = xStreamBufferSpacesAvailable(s_out);
+        if (room < 2) {
+            break;
+        }
+        size_t want = (room < cap ? room : cap) - (have_odd ? 1 : 0);
+        size_t got = xStreamBufferReceive(s_tts_pcm, buf + (have_odd ? 1 : 0), want, 0);
+        if (!got) {
+            break;
+        }
+        if (have_odd) {
+            buf[0] = odd[0];
+            got++;
+            have_odd = false;
+        }
+        if (got & 1) {
+            odd[0] = buf[--got];
+            have_odd = true;
+        }
+        if (s_turn.gen == s_gen.load()) {
+            mark(M_AUDIO);
+            xStreamBufferSend(s_out, buf, got, 0);
+        }
+        s_turn.pcm_out += got / 2;
+    }
+    bool drained = !xStreamBufferBytesAvailable(s_tts_pcm);
+    if (st == MUSE_GEMINI_TTS_RUNNING) {
+        /* Captions follow the speech: estimate its length from the text so far. */
+        uint32_t est = (uint32_t)(m.len * MIC_RATE / SPEECH_CHARS_PER_S);
+        uint32_t heard = s_turn.pcm_out - m.pcm_start;
+        m.pcm_frames = est > heard ? est : heard;
+    }
+    if (st == MUSE_GEMINI_TTS_DONE && drained) {
+        have_odd = false;
+        m.pcm_frames = s_turn.pcm_out - m.pcm_start;
+        m.tts = TTS_FINISHED;
+        s_turn.tts_msg = -1;
+        s_turn.gemini = false;
+    } else if (st == MUSE_GEMINI_TTS_FAILED || st == MUSE_GEMINI_TTS_IDLE) {
+        /* No speech came: show the reply at reading pace instead. */
+        have_odd = false;
+        ESP_LOGW(TAG, "no speech from Gemini; showing the reply");
+        s_turn.gemini = false;
+        s_turn.silent = true;
+        m.pcm_start = s_turn.pcm_out;
+        m.pcm_frames = (uint32_t)(m.len * MIC_RATE / TEXT_CHARS_PER_S);
+    }
+}
+
